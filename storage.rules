rules_version = '2';

// Firebase Storage Security Rules for Butlery App
service firebase.storage {
  match /b/{bucket}/o {
    
    // Users can only access their own files - this covers all user content including:
    // - Profile avatars: /users/{userId}/avatars/
    // - Recipe images: /users/{userId}/recipes/
    // - Any other user-specific content
    match /users/{userId}/{allPaths=**} {
      // Allow if user is authenticated and accessing their own files
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Public read access for shared recipe images (if needed for sharing)
    match /shared/recipes/{recipeId}/{allPaths=**} {
      allow read: if true; // Public read access for shared content
      allow write: if request.auth != null; // Only authenticated users can upload
    }
    
    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
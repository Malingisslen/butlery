rules_version = '2';

// Firebase Storage Security Rules for Butlery App
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to validate image files. BUT-780: tightened from
    // `image/.*` to a whitelist. SVG can carry inline JavaScript (XSS when
    // rendered in <img src=...> by some viewers); BMP/TIFF/AVIF aren't part
    // of the supported display path and accepting them is attack surface
    // for free. The accepted list mirrors the CF magic-byte verifier in
    // `functions/src/storage/moderate-upload.ts` — keep them in sync.
    function isValidImage() {
      return request.resource.contentType in [
        'image/jpeg',
        'image/png',
        'image/webp',
        'image/heic',
        'image/heif'
      ];
    }

    // Helper function to check file size (in MB)
    function isWithinSizeLimit(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }

    // BUT-1049: comment images. Authored under the comment author's own
    // user space, but READABLE by any authenticated user — recipe comments
    // are visible to the recipe's shared audience (owner + recipients), and
    // we can't resolve that audience from a Storage path, so reads mirror the
    // `shared/recipes` scope (authenticated = allowed). Writes stay strictly
    // owner-scoped so nobody can plant images in another user's namespace.
    // NOTE: Firebase Storage rules are NOT most-specific-wins — when several
    // `match` blocks match a path, access is the UNION (OR) of their `allow`
    // clauses. This block is OR'd with the `/users/{userId}/{allPaths=**}`
    // wildcard below: the broader `read: any authenticated` here widens read
    // for this subtree, and write stays owner-only only because BOTH blocks
    // gate writes on `uid == owner`. Tightening the wildcard alone will NOT
    // restrict this subtree — both blocks must agree.
    match /users/{authorId}/comment_images/{imageId} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.auth.uid == authorId
        && isValidImage()
        && isWithinSizeLimit(10);
    }

    // Users can only access their own files - this covers all user content including:
    // - Profile avatars: /users/{userId}/avatars/
    // - Recipe images: /users/{userId}/recipes/
    // - Any other user-specific content
    match /users/{userId}/{allPaths=**} {
      // Read access for authenticated user accessing their own files
      allow read: if request.auth != null && request.auth.uid == userId;

      // Write access with size and type validation
      // Max 10 MB for recipe images, must be image format
      allow write: if request.auth != null
        && request.auth.uid == userId
        && isValidImage()
        && isWithinSizeLimit(10);
    }

    // Shared recipe images - publicly readable, upload-validated writes
    match /shared/recipes/{recipeId}/{allPaths=**} {
      allow read: if request.auth != null;

      // Allow creating new files if authenticated and setting correct uploader metadata
      // Application must set metadata.uploadedBy = userId when uploading
      // Max 10 MB, must be image format
      allow create: if request.auth != null
        && request.resource.metadata.uploadedBy == request.auth.uid
        && isValidImage()
        && isWithinSizeLimit(10);

      // Allow updating/deleting only files you uploaded
      // Update also requires size/type validation if changing content
      allow update: if request.auth != null
        && resource.metadata.uploadedBy == request.auth.uid
        && isValidImage()
        && isWithinSizeLimit(10);

      allow delete: if request.auth != null
        && resource.metadata.uploadedBy == request.auth.uid;
    }

    // ML model files - read-only for authenticated users
    match /models/{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Feedback screenshots - submitting user needs read for getDownloadURL()
    match /feedback/{userId}/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && isValidImage()
        && isWithinSizeLimit(10);
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

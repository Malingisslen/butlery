  },
  "profileDeletionNoticeHowLongUnknown": "How long: until the review is finished.",
  "@profileDeletionNoticeHowLongUnknown": {
    "description": "The HOW LONG line when the server sent no parsable outer-cap date. Says less rather than saying a number nobody measured."
  },
  "profileDeletionNoticeWhatUnclear": "One thing may have been kept: we could not finish checking whether there is an ongoing review of content that was reported.",
  "@profileDeletionNoticeWhatUnclear": {
    "description": "The WHAT line when the hold is PROVISIONAL. Deliberately hedged: the notice must not assert a pending review as fact when nothing measured one (BUT-2047)."
  },
  "profileDeletionNoticeWhatOwnReport": "One or more reports you made that have not finished being handled have been kept. Your name has been removed from them, but what you wrote is still there.",
  "@profileDeletionNoticeWhatOwnReport": {
    "description": "The WHAT line when only reports the person FILED were kept: their cases were still open, so they stay without the person's name until they close (Malin, 2026-09-18). Count-neutral, because the server does not send how many."
  },
  "profileDeletionNoticeWhatBoth": "The following has been kept: an ongoing review of content that was reported, and one or more reports you made that have not finished being handled. Your name has been removed from the reports, but what you wrote is still there.",
  "@profileDeletionNoticeWhatBoth": {
    "description": "The WHAT line when both a review of the person's content and reports they filed were kept."
  },
  "profileDeletionNoticeWhatBothUnclear": "One or more reports you made that have not finished being handled have been kept without your name but with what you wrote. One more thing may have been kept: we could not finish checking whether there is an ongoing review of content that was reported.",
  "@profileDeletionNoticeWhatBothUnclear": {
    "description": "The WHAT line when reports they filed were kept and the review hold is PROVISIONAL. The review half stays hedged, as in profileDeletionNoticeWhatUnclear (BUT-2047)."
  },
  "profileDeletionNoticeWhyHandling": "Why: we have to be able to finish the handling.",
  "@profileDeletionNoticeWhyHandling": {
    "description": "The WHY line whenever reports the person filed were kept (alone or beside a review): speaks of the handling, not of a review of their content."
  },
  "profileDeletionNoticeHowLongHandling": "How long: until the handling is finished, at most {date}.",
  "@profileDeletionNoticeHowLongHandling": {
    "description": "The HOW LONG line whenever reports the person filed were kept. {date} is the latest cap the server sent, never a hardcoded number.",
    "placeholders": {
      "date": {
        "type": "String"
      }
    }
  },
  "profileDeletionNoticeHowLongHandlingUnknown": "How long: until the handling is finished.",
  "@profileDeletionNoticeHowLongHandlingUnknown": {
    "description": "The HOW LONG line whenever reports the person filed were kept and no date was sent."
  },
  "profileDeletionNoticeCollapsed": "A message about a deleted account on this device.",
  "@profileDeletionNoticeCollapsed": {
    "description": "The neutral first line of the RE-SHOWN Art. 12(4) notice, before 'Show more' is tapped. Malin's call 2026-09-12, option (b): on a shared device the next person must not be told that the previous account holder had content under moderation review. Says nothing the expanded notice says. The notice shown live, right after the deletion, has no collapsed state — there is no bystander there."
  },
  "profileDeleteAccountMayHaveReview": "If there is an ongoing review of content you were reported for, we may need to keep that review even after the account is deleted. If so, it is kept until the case is closed, at most 180 days. If you want to be told right away when the account is deleted, sign in during the 7 days and choose Delete now.",
  "@profileDeleteAccountMayHaveReview": {
    "description": "Pre-deletion warning row in the delete-account confirmation, shown only when the user's own totalReports counter is above zero. The hedge is LOAD-BEARING: totalReports counts reports ever filed, not open cases, so this must never assert that a review is under way. Do not edit it into a statement of fact."
  },

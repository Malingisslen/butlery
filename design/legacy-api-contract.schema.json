{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "butlery-legacy-api-contract/1",
  "version": "1.0",
  "title": "Butlery · fryst legacy-API-kontrakt",
  "description": "Kontraktet för legacy-api-contract.json. Fas 1 (femte vändan): kontraktsfilen hade inget eget schema, så en tom lista, en dubblett eller en felstavad nyckel hade passerat. Objekten är slutna, listorna typade och medlemsnamnen unika. Mängdlikheten mot genererad Dart mäts av TG-01.",
  "type": "object",
  "required": ["version", "frozen", "source", "appColors", "appTextStyles"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "$schema_note": { "type": "string", "minLength": 40 },
    "$honesty": { "type": "string", "minLength": 80 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "frozen": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string", "minLength": 10 },
    "appColors": {
      "type": "object",
      "required": ["members", "colorSchemes"],
      "additionalProperties": false,
      "properties": {
        "members": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } },
        "colorSchemes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } }
      }
    },
    "appTextStyles": {
      "type": "object",
      "required": ["getters", "stringConstants"],
      "additionalProperties": false,
      "properties": {
        "getters": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } },
        "stringConstants": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } }
      }
    }
  }
}

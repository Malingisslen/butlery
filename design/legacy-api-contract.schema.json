{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "butlery-legacy-api-contract/1",
  "version": "1.0",
  "title": "Butlery · fryst legacy-API-kontrakt",
  "description": "Kontraktet för legacy-api-contract.json. Fas 1 (femte vändan): kontraktsfilen hade inget eget schema, så en tom lista, en dubblett eller en felstavad nyckel hade passerat. Objekten är slutna, listorna typade och medlemsnamnen unika. Mängdlikheten mot genererad Dart mäts av TG-01.",
  "type": "object",
  "required": ["version", "frozen", "source", "appColors", "appTextStyles"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "$schema_note": { "type": "string", "minLength": 40 },
    "$honesty": { "type": "string", "minLength": 80 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "frozen": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string", "minLength": 10 },
    "$progressExtension": { "type": "string", "minLength": 40 },
    "appColors": {
      "type": "object",
      "required": ["members", "colorSchemes"],
      "additionalProperties": false,
      "properties": {
        "members": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } },
        "colorSchemes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } }
      }
    },
    "appTextStyles": {
      "type": "object",
      "required": ["getters", "stringConstants"],
      "additionalProperties": false,
      "properties": {
        "getters": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } },
        "stringConstants": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } }
      }
    },
    "appColorsDark": {
      "description": "Eget kontrakt för den mörka leveransen (lib/theme/app_colors_dark.dart ur tools/gen-app-theme-dark.mjs), infört i c081707. Mängdlikheten mot genererad Dart mäts av tools/test-generated-dark.mjs.",
      "type": "object",
      "required": ["artifact", "generator", "mode", "source", "members", "aliases", "semanticTokens", "traceability"],
      "additionalProperties": false,
      "properties": {
        "$note": { "type": "string", "minLength": 40 },
        "$regel": { "type": "string", "minLength": 40 },
        "artifact": { "type": "string", "pattern": "^lib/theme/[a-z_]+\\.dart$" },
        "generator": { "type": "string", "pattern": "^tools/[a-z0-9-]+\\.mjs$" },
        "mode": { "const": "dark" },
        "source": { "type": "string", "minLength": 10 },
        "members": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } },
        "aliases": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } },
        "semanticTokens": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)*$" } },
        "traceability": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["FLUTTER_MEMBER", "SEMANTIC_TOKEN", "TOKENS_JSON_PATH", "DARK_VALUE", "KIND"],
            "additionalProperties": false,
            "properties": {
              "FLUTTER_MEMBER": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
              "SEMANTIC_TOKEN": { "type": "string", "minLength": 1 },
              "TOKENS_JSON_PATH": { "type": "string", "pattern": "^semantic\\[\".+\"\\]\\.dark$" },
              "DARK_VALUE": { "type": "string", "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|rgba\\(\\d{1,3},\\d{1,3},\\d{1,3},(0|1|0?\\.\\d+)\\))$" },
              "KIND": { "enum": ["CANONICAL", "ALIAS"] }
            }
          }
        }
      }
    }
  }
}

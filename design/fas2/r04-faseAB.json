 "C_illustrationMotTreBakgrunder": {
  "status": "STOPPAD — bilderna gar inte att lita pa",
  "fynd": "Illustrationen ar ANIMERAD. .start-cover, .start-dish och .start-steam kor alla en 5-sekunders oandlig animation. En stillbild fangar en godtycklig bildruta: i den forsta korningen syntes kupan och banklinjen men varken maten eller angan.",
  "tvaLagligaTillstand": {
   "animerat": "standardlaget. Alla delar syns vid olika tidpunkter. Ej deterministiskt for stillbild.",
   "reduceradRorelse": "@media (prefers-reduced-motion: reduce) ger .start-cover opacity 0, .start-steam opacity 0, .start-dish opacity 1. Deterministiskt — men da syns bara maten och banklinjen, alltsa 3 av de 8 enheterna."
  },
  "konsekvens": "Ingen av de tva tillstanden racker for att bedoma alla atta enheter. Det animerade ar inte reproducerbart; det reducerade visar bara tre av dem.",
  "foreslagenAtgard": "Frys animationen deterministiskt vid en angiven tidpunkt — via CDP Animation-domanen eller animation-play-state med explicit delay — och redovisa vilken tidpunkt bilden visar. Det ar ett verktygsblock, inget designbeslut.",
  "renderade": 9,
  "$not": "Bilderna finns kvar som underlag men far inte anvandas for att valja bunt."
 },
 "D_illustrationsverdikt": {
  "verdikt": "KAN INTE AVGORAS AN",
  "varken": [
   "ILLUSTRATION_INDEPENDENTLY_DECIDABLE",
   "ILLUSTRATION_BACKGROUND_COUPLED"

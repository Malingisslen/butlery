{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "butlery-source-authority/2",
  "version": "2.0",
  "title": "Butlery · källauktoritetsregister (maskinläsbart)",
  "description": "Kontraktet för source-authority.json. Version 2 (F1-H01–H07): endimensionell status ersatt av authorityState + changePolicy, stabila domainId och sourceId, statusordboken flyttad till tools/authority-contract.mjs så registret inte längre definierar sin egen vokabulär, och runtimeInstances som förtecknar de två byggena av dokumentruntimen. T-20 kräver dessutom exakt mängdlikhet mot den obligatoriska domänmängden, verklig versionsläsning för varje aktiv källa, mängdlikhet mot tools/gen-targets.mjs och supersededBy utan cykler.",
  "type": "object",
  "required": [
    "version",
    "date",
    "controlStatusVocabulary",
    "authorities",
    "generatedArtifacts",
    "superseded",
    "runtimeInstances",
    "packagedBinaries",
    "sections",
    "runtimeArtifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$note": {
      "type": "string",
      "minLength": 40
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "controlStatusVocabulary": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "status",
          "means",
          "satisfies"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not run",
              "not applicable"
            ]
          },
          "means": {
            "type": "string",
            "minLength": 10
          },
          "satisfies": {
            "type": "boolean"
          }
        }
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "domainId",
          "domain",
          "authorityState",
          "changePolicy",
          "owner"
        ],
        "additionalProperties": false,
        "properties": {
          "domainId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
          },
          "domain": {
            "type": "string",
            "minLength": 3
          },
          "sourceId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "authorityState": {
            "enum": [
              "active",
              "planned",
              "superseded",
              "historical",
              "concept"
            ]
          },
          "changePolicy": {
            "enum": [
              "maintained",
              "frozen"
            ]
          },
          "owner": {
            "enum": [
              "DS",
              "DEV",
              "PRODUKT",
              "JURIDIK"
            ]
          },
          "note": {
            "type": "string"
          },
          "supersededBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "outsideRepoRoot": {
            "type": "boolean"
          }
        }
      }
    },
    "generatedArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file",
          "generator"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 3
          },
          "generator": {
            "type": "string",
            "pattern": "^tools/gen-[a-z-]+\\.mjs$"
          }
        }
      }
    },
    "superseded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "where",
          "authorityState",
          "changePolicy"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 3
          },
          "where": {
            "type": "string",
            "minLength": 3
          },
          "authorityState": {
            "enum": [
              "superseded",
              "historical",
              "concept"
            ]
          },
          "changePolicy": {
            "enum": [
              "maintained",
              "frozen"
            ]
          },
          "supersededBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          },
          "outsideRepoRoot": {
            "type": "boolean"
          }
        }
      }
    },
    "runtimeInstances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "where",
          "manifestStatus",
          "consumers",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 3
          },
          "where": {
            "type": "string",
            "minLength": 3
          },
          "manifestStatus": {
            "enum": [
              "declared",
              "exempt"
            ]
          },
          "consumers": {
            "type": "integer",
            "minimum": 0
          },
          "note": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "packagedBinaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "where",
          "origin",
          "generated",
          "contract"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 3
          },
          "where": {
            "type": "string",
            "minLength": 3
          },
          "origin": {
            "type": "string",
            "minLength": 3
          },
          "generated": {
            "type": "boolean"
          },
          "contract": {
            "type": "string",
            "minLength": 80
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "heading",
          "body"
        ],
        "additionalProperties": false,
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 3
          },
          "body": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "runtimeArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  }
}

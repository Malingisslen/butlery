{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "butlery-source-authority/1",
  "version": "1.0",
  "title": "Butlery · källauktoritetsregister (maskinläsbart)",
  "description": "Kontraktet för source-authority.json. Styrdokumentet krävde en maskinläsbar motsvarighet till fas0/kallauktoritetsregister.md i Fas 1; till dess drev det handskrivna registret. Valideras av T-20, som dessutom kräver exakt en aktiv auktoritet per domän, filnärvaro, giltiga statusar och supersededBy utan cykler.",
  "type": "object",
  "required": [
    "version",
    "date",
    "statusVocabulary",
    "controlStatusVocabulary",
    "authorities",
    "generatedArtifacts",
    "superseded",
    "sections",
    "runtimeArtifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$note": {
      "type": "string",
      "minLength": 40
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "statusVocabulary": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "string",
        "minLength": 10
      }
    },
    "controlStatusVocabulary": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "status",
          "means",
          "satisfies"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not run",
              "not applicable"
            ]
          },
          "means": {
            "type": "string",
            "minLength": 10
          },
          "satisfies": {
            "type": "boolean"
          }
        }
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "domain",
          "status",
          "owner"
        ],
        "additionalProperties": false,
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 3
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "minLength": 3
          },
          "owner": {
            "enum": [
              "DS",
              "DEV",
              "PRODUKT",
              "JURIDIK"
            ]
          },
          "note": {
            "type": "string"
          },
          "supersededBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "outsideRepoRoot": {
            "type": "boolean"
          }
        }
      }
    },
    "generatedArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file",
          "generator"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 3
          },
          "generator": {
            "type": "string",
            "pattern": "^tools/gen-[a-z-]+\\.mjs$"
          }
        }
      }
    },
    "superseded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "where",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 3
          },
          "where": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "type": "string",
            "minLength": 3
          },
          "supersededBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          },
          "outsideRepoRoot": {
            "type": "boolean"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "heading",
          "body"
        ],
        "additionalProperties": false,
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 3
          },
          "body": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "runtimeArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "butlery-tokens.schema.json",
  "title": "Butlery design tokens",
  "$comment": "Schemat beskriver tokens.json EXAKT som filen ser ut — inte en önskad form. Validatorn i tools/lint-core.mjs (T-01) går rekursivt igenom type, required, pattern, minimum, minItems, enum och const. Utöver schemat körs T-02 (kontrast mot deklarerade par), T-03/T-04 (råvärden i spec-HTML) och T-10 (indexets påståenden).",
  "type": "object",
  "required": [
    "version",
    "date",
    "palette",
    "opacityLadder",
    "semantic",
    "avatar",
    "typography",
    "space",
    "touchTarget",
    "motion",
    "contrastPolicy",
    "contrastPairs",
    "controls"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "manual": {
      "type": "string"
    },
    "screens": {
      "type": "string"
    },
    "palette": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9A-F]{6}$"
      }
    },
    "opacityLadder": {
      "type": "object",
      "required": [
        "onPaper",
        "onInk"
      ],
      "properties": {
        "note": {
          "type": "string"
        },
        "onPaper": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "onInk": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "light",
          "dark"
        ],
        "properties": {
          "light": {
            "type": "string",
            "pattern": "^(#[0-9A-F]{6}|rgba?\\(.+\\))$"
          },
          "dark": {
            "type": "string",
            "pattern": "^(#[0-9A-F]{6}|rgba?\\(.+\\))$"
          },
          "note": {
            "type": "string"
          },
          "contrast": {
            "type": "string"
          },
          "width": {
            "type": "string"
          },
          "offset": {
            "type": "string"
          }
        }
      }
    },
    "avatar": {
      "type": "object",
      "required": [
        "pairs",
        "selfRing"
      ],
      "properties": {
        "note": {
          "type": "string"
        },
        "personNameText": {
          "type": "string"
        },
        "removed": {
          "type": "string"
        },
        "selfRing": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "pairs": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "fill",
              "onFill",
              "contrast"
            ],
            "properties": {
              "fill": {
                "type": "string",
                "pattern": "^#[0-9A-F]{6}$"
              },
              "onFill": {
                "type": "string",
                "pattern": "^#[0-9A-F]{6}$"
              },
              "contrast": {
                "type": "number",
                "minimum": 4.5
              }
            }
          }
        }
      }
    },
    "dataScale": {
      "type": "object",
      "required": [
        "sequential",
        "maxColouredSeries",
        "onFill",
        "$note"
      ],
      "additionalProperties": false,
      "properties": {
        "$note": {
          "type": "string"
        },
        "sequential": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-F]{6}$"
          }
        },
        "colouredSeriesSteps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "maxColouredSeries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "onFill": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-F]{6}$"
          }
        },
        "categorical": {
          "type": "null"
        }
      }
    },
    "contrastPolicy": {
      "type": "object",
      "required": [
        "floors",
        "exemptions",
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "largeTextFrom": {
          "type": "string"
        },
        "floors": {
          "type": "object",
          "required": [
            "smallText",
            "largeText",
            "graphicAndUi",
            "disabled"
          ],
          "properties": {
            "smallText": {
              "type": "number",
              "minimum": 4.5
            },
            "largeText": {
              "type": "number",
              "minimum": 3
            },
            "graphicAndUi": {
              "type": "number",
              "minimum": 3
            },
            "disabled": {
              "type": "number",
              "minimum": 3
            }
          }
        },
        "exemptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "token",
              "reason"
            ],
            "properties": {
              "token": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "contrastPairs": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "fg",
          "bg",
          "floor"
        ],
        "properties": {
          "fg": {
            "type": "string"
          },
          "bg": {
            "type": "string"
          },
          "floor": {
            "type": "number",
            "minimum": 3
          }
        }
      }
    },
    "docOnly": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            }
          }
        ]
      }
    },
    "typography": {
      "type": "object",
      "required": [
        "family",
        "weights",
        "roles",
        "rules",
        "styles"
      ],
      "properties": {
        "family": {
          "type": "string"
        },
        "italic": {
          "type": "string"
        },
        "weights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 100
          }
        },
        "numerals": {
          "type": "object"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "styles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "decoration": {
          "type": "object"
        },
        "roles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "size",
              "weight"
            ],
            "properties": {
              "size": {
                "type": "number",
                "minimum": 10
              },
              "weight": {
                "type": "number",
                "minimum": 100
              },
              "tracking": {
                "type": "string"
              },
              "transform": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "space": {
      "type": "object",
      "required": [
        "scale",
        "radius",
        "layoutMargin"
      ],
      "properties": {
        "scale": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "radius": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "layoutMargin": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "touchTarget": {
      "type": "object",
      "required": [
        "min",
        "unit",
        "minGap",
        "rule"
      ],
      "properties": {
        "min": {
          "const": 48
        },
        "unit": {
          "const": "dp"
        },
        "minGap": {
          "type": "number",
          "minimum": 8
        },
        "iosEquivalent": {
          "type": "number",
          "minimum": 44
        },
        "iosUnit": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        }
      }
    },
    "motion": {
      "type": "object",
      "required": [
        "durations",
        "easing",
        "reducedMotion"
      ],
      "properties": {
        "durations": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "easing": {
          "type": "object",
          "required": [
            "standard"
          ],
          "properties": {
            "standard": {
              "type": "string"
            }
          }
        },
        "reducedMotion": {
          "type": "object"
        }
      }
    },
    "platformMapping": {
      "type": "object"
    },
    "unitPolicy": {
      "type": "object"
    },
    "$note": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "controls": {
      "type": "object",
      "description": "Låst kontrollgeometri (B-37). Mäts av tools/lint-controls.mjs — måtten låg tidigare bara i manualtexten och kunde därför glida.",
      "properties": {
        "checkbox": {
          "type": "object",
          "required": [
            "size",
            "radius",
            "hitbox"
          ]
        },
        "radio": {
          "type": "object"
        },
        "toggle": {
          "type": "object"
        },
        "chip": {
          "type": "object"
        },
        "chipCompactInField": {
          "type": "object"
        },
        "statusPill": {
          "type": "object"
        },
        "badge": {
          "type": "object"
        },
        "button": {
          "type": "object"
        },
        "stepper": {
          "type": "object"
        },
        "avatarScale": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "avatarStackRing": {
          "type": "object"
        },
        "lines": {
          "type": "object"
        }
      }
    }
  }
}
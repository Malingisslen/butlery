{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "butlery-tokens/2",
  "version": "2.0",
  "title": "Butlery designtokens",
  "description": "Fas 1: hela strukturen valideras på fältnivå. Version 2.0 — controls och emptyStateGlyph är slutna objekt med typer och gränser. Schemat versioneras i $id; höj vid strukturändring.",
  "type": "object",
  "required": [
    "version",
    "date",
    "palette",
    "opacityLadder",
    "semantic",
    "avatar",
    "typography",
    "space",
    "touchTarget",
    "motion",
    "contrastPolicy",
    "contrastPairs",
    "controls",
    "emptyStateGlyph",
    "platformMapping",
    "unitPolicy"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "manual": {
      "type": "string"
    },
    "screens": {
      "type": "string"
    },
    "palette": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9A-F]{6}$"
      }
    },
    "opacityLadder": {
      "type": "object",
      "required": [
        "onPaper",
        "onInk"
      ],
      "properties": {
        "note": {
          "type": "string"
        },
        "onPaper": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "onInk": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "light",
          "dark"
        ],
        "properties": {
          "light": {
            "type": "string",
            "pattern": "^(#[0-9A-F]{6}|rgba?\\(.+\\))$"
          },
          "dark": {
            "type": "string",
            "pattern": "^(#[0-9A-F]{6}|rgba?\\(.+\\))$"
          },
          "note": {
            "type": "string"
          },
          "contrast": {
            "type": "string"
          },
          "width": {
            "type": "string"
          },
          "offset": {
            "type": "string"
          }
        }
      }
    },
    "avatar": {
      "type": "object",
      "required": [
        "pairs",
        "selfRing"
      ],
      "properties": {
        "note": {
          "type": "string"
        },
        "personNameText": {
          "type": "string"
        },
        "removed": {
          "type": "string"
        },
        "selfRing": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "pairs": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "fill",
              "onFill",
              "contrast"
            ],
            "properties": {
              "fill": {
                "type": "string",
                "pattern": "^#[0-9A-F]{6}$"
              },
              "onFill": {
                "type": "string",
                "pattern": "^#[0-9A-F]{6}$"
              },
              "contrast": {
                "type": "number",
                "minimum": 4.5
              }
            }
          }
        }
      }
    },
    "dataScale": {
      "type": "object",
      "required": [
        "sequential",
        "maxColouredSeries",
        "onFill",
        "$note"
      ],
      "additionalProperties": false,
      "properties": {
        "$note": {
          "type": "string"
        },
        "sequential": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-F]{6}$"
          }
        },
        "colouredSeriesSteps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "maxColouredSeries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "onFill": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-F]{6}$"
          }
        },
        "categorical": {
          "type": "null"
        }
      }
    },
    "contrastPolicy": {
      "type": "object",
      "required": [
        "floors",
        "exemptions",
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "largeTextFrom": {
          "type": "string"
        },
        "floors": {
          "type": "object",
          "required": [
            "smallText",
            "largeText",
            "graphicAndUi",
            "disabled"
          ],
          "properties": {
            "smallText": {
              "type": "number",
              "minimum": 4.5
            },
            "largeText": {
              "type": "number",
              "minimum": 3
            },
            "graphicAndUi": {
              "type": "number",
              "minimum": 3
            },
            "disabled": {
              "type": "number",
              "minimum": 3
            }
          }
        },
        "exemptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "token",
              "reason"
            ],
            "properties": {
              "token": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "contrastPairs": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "fg",
          "bg",
          "floor"
        ],
        "properties": {
          "fg": {
            "type": "string"
          },
          "bg": {
            "type": "string"
          },
          "floor": {
            "type": "number",
            "minimum": 3
          }
        }
      }
    },
    "docOnly": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            }
          }
        ]
      }
    },
    "typography": {
      "type": "object",
      "required": [
        "family",
        "weights",
        "roles",
        "rules",
        "styles"
      ],
      "properties": {
        "family": {
          "type": "string"
        },
        "italic": {
          "type": "string"
        },
        "weights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 100
          }
        },
        "numerals": {
          "type": "object"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "styles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "decoration": {
          "type": "object"
        },
        "roles": {
          "type": "object",
          "minProperties": 1,
          "description": "Fas 1: lineHeight är normativt och obligatoriskt — det låg tidigare hårdkodat i gen-app-theme.mjs.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "size",
              "weight",
              "lineHeight"
            ],
            "properties": {
              "size": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 200
              },
              "weight": {
                "type": "number",
                "enum": [
                  300,
                  400,
                  500,
                  600,
                  700,
                  800
                ]
              },
              "lineHeight": {
                "type": "number",
                "minimum": 0.8,
                "maximum": 2.5
              },
              "letterSpacing": {
                "type": "number"
              },
              "note": {
                "type": "string"
              },
              "figures": {
                "type": "string",
                "enum": [
                  "tabular",
                  "proportional"
                ],
                "description": "Sifferbredd. Utelämnad = proportional (numerals.proportional: löpande text); tabular för roller där siffror ska ligga i kolumn."
              },
              "transform": {
                "type": "string"
              },
              "tracking": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?px$",
                "description": "teckenavstånd med enhet, t.ex. \"-0.4px\""
              }
            }
          }
        },
        "$lineHeightNote": {
          "type": "string"
        }
      }
    },
    "space": {
      "type": "object",
      "required": [
        "scale",
        "radius",
        "layoutMargin"
      ],
      "properties": {
        "scale": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "radius": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "layoutMargin": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "touchTarget": {
      "type": "object",
      "required": [
        "min",
        "unit",
        "minGap",
        "rule"
      ],
      "properties": {
        "min": {
          "const": 48
        },
        "unit": {
          "const": "dp"
        },
        "minGap": {
          "type": "number",
          "minimum": 8
        },
        "iosEquivalent": {
          "type": "number",
          "minimum": 44
        },
        "iosUnit": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        }
      }
    },
    "motion": {
      "type": "object",
      "required": [
        "durations",
        "easing",
        "reducedMotion"
      ],
      "properties": {
        "durations": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "easing": {
          "type": "object",
          "required": [
            "standard"
          ],
          "properties": {
            "standard": {
              "type": "string"
            }
          }
        },
        "reducedMotion": {
          "type": "object"
        }
      }
    },
    "platformMapping": {
      "type": "object"
    },
    "unitPolicy": {
      "type": "object"
    },
    "$note": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "controls": {
      "type": "object",
      "description": "Låst kontrollgeometri (B-37). Fas 1: varje normativt fält har typ och gränser, och objekten är slutna — tidigare kunde godtyckliga fält och felstavningar passera. 13 komponenter.",
      "required": [
        "checkbox",
        "radio",
        "toggle",
        "chip",
        "chipCompactInField",
        "statusPill",
        "badge",
        "button",
        "stepper",
        "avatarScale",
        "avatarStackRing",
        "lines",
        "calendarPresenceRow"
      ],
      "additionalProperties": false,
      "properties": {
        "$note": {
          "type": "string"
        },
        "checkbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "radius",
            "border",
            "checkStroke",
            "hitbox"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "radius": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 400
                },
                {
                  "const": "pill"
                }
              ]
            },
            "border": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "checkStroke": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "hitbox": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            }
          }
        },
        "radio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "border",
            "hitbox"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "border": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "hitbox": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            }
          }
        },
        "toggle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "knob",
            "hitbox"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "knob": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "hitbox": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            }
          }
        },
        "chip": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fontSize",
            "weight",
            "paddingY",
            "paddingX",
            "radius",
            "hitbox"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "fontSize": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "weight": {
              "type": "number",
              "enum": [
                300,
                400,
                500,
                600,
                700,
                800
              ],
              "description": "fontvikt ur typskalan"
            },
            "paddingY": {
              "type": "number",
              "minimum": 0,
              "maximum": 400,
              "description": "dp, får vara 0"
            },
            "paddingX": {
              "type": "number",
              "minimum": 0,
              "maximum": 400,
              "description": "dp, får vara 0"
            },
            "radius": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 400
                },
                {
                  "const": "pill"
                }
              ]
            },
            "minGap": {
              "type": "number",
              "minimum": 0,
              "maximum": 400,
              "description": "dp, får vara 0"
            },
            "hitbox": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            }
          }
        },
        "chipCompactInField": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paddingY",
            "paddingX"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "paddingY": {
              "type": "number",
              "minimum": 0,
              "maximum": 400,
              "description": "dp, får vara 0"
            },
            "paddingX": {
              "type": "number",
              "minimum": 0,
              "maximum": 400,
              "description": "dp, får vara 0"
            }
          }
        },
        "statusPill": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fontSize",
            "weight",
            "paddingY",
            "paddingX",
            "radius"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "fontSize": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "weight": {
              "type": "number",
              "enum": [
                300,
                400,
                500,
                600,
                700,
                800
              ],
              "description": "fontvikt ur typskalan"
            },
            "paddingY": {
              "type": "number",
              "minimum": 0,
              "maximum": 400,
              "description": "dp, får vara 0"
            },
            "paddingX": {
              "type": "number",
              "minimum": 0,
              "maximum": 400,
              "description": "dp, får vara 0"
            },
            "radius": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 400
                },
                {
                  "const": "pill"
                }
              ]
            }
          }
        },
        "badge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paddingY",
            "paddingX"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "paddingY": {
              "type": "number",
              "minimum": 0,
              "maximum": 400,
              "description": "dp, får vara 0"
            },
            "paddingX": {
              "type": "number",
              "minimum": 0,
              "maximum": 400,
              "description": "dp, får vara 0"
            }
          }
        },
        "button": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minHeight",
            "compactVisual",
            "compactHitbox",
            "fontSize",
            "weight"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "minHeight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "maxHeight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "compactVisual": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "compactHitbox": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "minWidth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "fontSize": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "weight": {
              "type": "number",
              "enum": [
                300,
                400,
                500,
                600,
                700,
                800
              ],
              "description": "fontvikt ur typskalan"
            },
            "iconSize": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 400,
                "description": "dp"
              }
            },
            "iconGap": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 400,
                "description": "dp, får vara 0"
              }
            }
          }
        },
        "stepper": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visual",
            "hitbox"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "visual": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "hitbox": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            }
          }
        },
        "avatarScale": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 400,
            "description": "dp"
          },
          "description": "Avatarens storleksskala i dp."
        },
        "avatarStackRing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            }
          }
        },
        "lines": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hairline",
            "sectionRule",
            "control"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "hairline": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "sectionRule": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "control": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "outlinedEdge": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "cellAccent": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "cellUnderline": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            }
          }
        },
        "calendarPresenceRow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "height",
            "avatar",
            "maxFaces",
            "labelSize",
            "labelWeight"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "avatar": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "maxFaces": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "labelSize": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 400,
              "description": "dp"
            },
            "labelWeight": {
              "type": "number",
              "enum": [
                300,
                400,
                500,
                600,
                700,
                800
              ],
              "description": "fontvikt ur typskalan"
            },
            "degradeTo": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "emptyStateGlyph": {
      "type": "object",
      "description": "Tomlägesglyfens två fall. Fas 1: tidigare helt ovaliderad.",
      "required": [
        "inline",

platform :ios, '17.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# firebase_core 5.1 pins the Firebase iOS SDK to 12.19.3, but CocoaPods trunk has
# no FirebaseAnalytics 12.19.3, so pod install cannot resolve. Remove once every
# Firebase pod has the pinned version (BUT-2508).
$FirebaseSDKVersion = '12.19.0'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # :static linkage required — flutter_onnxruntime ships static xcframeworks
  # that CocoaPods refuses to mix with dynamic frameworks in the same target.
  use_frameworks! :linkage => :static
  use_modular_headers!

  # download.onnxruntime.ai, where the trunk specs for these two pods download
  # from, failed TLS on every try from 2026-11-21 (TestFlight run 44918119033),
  # and github.com/microsoft/onnxruntime asked for credentials on 2026-11-22.
  # The C pod takes its xcframework from Microsoft's NuGet package, pinned by
  # sha256. The Objective-C pod's sources are vendored from tag v1.28.0
  # (revision da9b5e364c46), as archived by Software Heritage. Keep the version
  # equal to flutter_onnxruntime's pin.
  pod 'onnxruntime-c', :podspec => 'vendor-pods/onnxruntime-c.podspec.json'
  pod 'onnxruntime-objc', :path => 'vendor-pods/onnxruntime-objc'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # Flutter's helper applies its own deployment-target floor (often 13.0)
    # which masks the Podfile's `platform`. Re-pin every pod to match the
    # app target so deps using iOS 17 APIs (e.g. connectivity_plus's
    # NWPath.isUltraConstrained) compile cleanly.
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
      # permission_handler compiles every iOS permission out unless its macro is
      # set, and a compiled-out permission reports denied without ever asking,
      # so the app never appears under Settings for it. One macro per
      # Permission.* that lib/ requests on iOS; each needs its usage string in
      # Info.plist.
      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      defs = defs.split(' ') if defs.is_a?(String)
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs + [
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end
  end
end

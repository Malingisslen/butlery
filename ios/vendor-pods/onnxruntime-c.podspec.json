    "LICENSE"
  ],
  "description": "A pod for the ONNX Runtime C/C++ library.",
  "libraries": "c++",
  "pod_target_xcconfig": {
    "OTHER_CPLUSPLUSFLAGS": "-fvisibility=hidden -fvisibility-inlines-hidden"

  "prepare_command": "set -e\nunzip -q runtimes/ios/native/onnxruntime.xcframework.zip\nmkdir -p Headers\ncp onnxruntime.xcframework/ios-arm64/onnxruntime.framework/Headers/*.h Headers/",
  "summary": "ONNX Runtime C/C++ Pod",
  "platforms": {
    "ios": "15.1"
  },
  "vendored_frameworks": "onnxruntime.xcframework",

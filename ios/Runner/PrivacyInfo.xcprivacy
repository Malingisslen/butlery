<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Butlery — App Privacy Manifest (Apple required-reason API declarations)
		Evidence trail: docs/ops/ios-privacy-manifest-audit.md
		Last audited: 2026-04-24 (sprint BUT-568)

		NSPrivacyTracking = false: Butlery does NOT use IDFA, does NOT track
		users across apps/websites. Analytics is consent-gated (BUT-412).
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
		Required-reason APIs used by Butlery's own code (first-party).
		SDKs that ship their own PrivacyInfo.xcprivacy (Firebase, shared_preferences,
		path_provider, image_picker, url_launcher, connectivity_plus, device_info_plus,
		package_info_plus, permission_handler, sqflite/sqlcipher, flutter_secure_storage,
		file_picker) have their manifests auto-merged by Xcode at build time —
		we must NOT duplicate their reasons here.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
			UserDefaults — Butlery's native code does not read/write
			NSUserDefaults directly; shared_preferences covers its own
			usage via its bundled manifest. Reason CA92.1 retained
			defensively in case first-party plugin code touches defaults
			(e.g., freerasp state, image_cropper session flags).
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!--
			FileTimestamp C617.1 + 3B52.1:
			  C617.1 — image_picker / image_cropper read EXIF / creation
			  timestamps that are surfaced to the user (e.g. recipe photo
			  metadata).
			  3B52.1 — cached_network_image, flutter_image_compress, and
			  sqlcipher_flutter_libs read mtimes to manage app-internal
			  caches (LRU eviction by file age) — does not leave the device.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
				<string>3B52.1</string>
			</array>
		</dict>
		<!--
			DiskSpace E174.1: Firestore's on-device persistence cache
			(LRU garbage collector) and Firebase Crashlytics check
			available disk space before writing additional cache pages /
			crash reports. Firebase ships its own bundled manifest covering
			this; we declare it at app level defensively so the merged
			App Store privacy report enumerates the reason explicitly.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
		<!--
			SystemBootTime 35F9.1: Firebase Performance Monitoring uses
			mach_absolute_time / boot-relative timestamps to compute trace
			durations and Firebase Analytics derives session timing from
			the same source. All measurement stays on-device until the
			user has consented to analytics (BUT-412).
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>

	<!--
		NSPrivacyCollectedDataTypes — what Butlery (including Firebase
		back-end collection) actually collects. Cross-referenced against
		Firebase's data-collection disclosures as of 2026-04.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Email address — Firebase Auth account, friend invitations -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Name — display name shown in social features -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
			UserID (BUT-603) — Firebase Auth UID is collected, linked to
			the user (it IS the user's identity), and never used for
			cross-app tracking. Purpose: app functionality only — UID is
			the document key for every per-user Firestore subtree and the
			payload of every authenticated request.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Photos — recipe images uploaded to Firebase Storage -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
			Other user content — recipes, shopping lists, menu plans,
			comments, ratings, cooking-session state stored in Firestore.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
			Product interaction — Firebase Analytics events (consent-gated;
			only collected after the user opts in via the consent screen).
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- Crash data — Firebase Crashlytics -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Performance data — Firebase Performance Monitoring -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
			Device ID — device_info_plus and Firebase Installations
			generate a per-install device identifier used for FCM push
			routing and App Check attestation.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

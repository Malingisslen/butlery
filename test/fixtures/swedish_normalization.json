{
  "version": "1.0",
  "description": "CRIT-5: Test vectors for Swedish character normalization parity between Dart and TypeScript",
  "contract": "å→a, ä→a, ö→o (case-insensitive)",
  "normalizations": [
    {"input": "Köttfärs", "expected": "kottfars"},
    {"input": "Räkor", "expected": "rakor"},
    {"input": "Ägg", "expected": "agg"},
    {"input": "Löksoppa", "expected": "loksoppa"},
    {"input": "Grädde", "expected": "gradde"},
    {"input": "Smör", "expected": "smor"},
    {"input": "Mjölk", "expected": "mjolk"},
    {"input": "Bröd", "expected": "brod"},
    {"input": "Ärtor", "expected": "artor"},
    {"input": "Rödlök", "expected": "rodlok"},
    {"input": "KÖTTBULLAR", "expected": "kottbullar"},
    {"input": "ÄGG OCH BACON", "expected": "agg och bacon"},
    {"input": "äppelkräm", "expected": "appelkram"},
    {"input": "grönsaksbulljong", "expected": "gronsaksbulljong"},
    {"input": "rödbetssoppa", "expected": "rodbetssoppa"},
    {"input": "", "expected": ""},
    {"input": "a", "expected": "a"},
    {"input": "abc", "expected": "abc"},
    {"input": "åäö", "expected": "aao"},
    {"input": "fläsk", "expected": "flask"},
    {"input": "lök", "expected": "lok"},
    {"input": "morot", "expected": "morot"},
    {"input": "potatis", "expected": "potatis"},
    {"input": "tomat", "expected": "tomat"},
    {"input": "vitlök", "expected": "vitlok"},
    {"input": "persilja", "expected": "persilja"},
    {"input": "dill", "expected": "dill"},
    {"input": "Blåbär", "expected": "blabar"}
  ]
}

void main() {
  group('YourRepository/Service', () {
    // Declare your test subject and mocks
    late YourRepository repository;
    late MockDependency1 mockDep1;
    late MockDependency2 mockDep2;
    
    setUpAll(() {
      // Register fallback values for mocktail ONLY
      // Do NOT put BaseUnitTest.setupUnit() here
      registerFallbackValue(FakeSomeClass());
      registerFallbackValue(DateTime.now());
    });
    
    setUp(() async {
      // Initialize base test infrastructure for EACH test
      await BaseUnitTest.setupUnit();
      
      // Initialize TestServiceLocator for EACH test
      await TestServiceLocator.initialize();
      
      // Get mocks from TestServiceLocator or create new ones
      mockDep1 = TestServiceLocator.mockAuthRepository;
      mockDep2 = MockDependency2();
      
      // Configure mock states (use configuration methods, not stubbing)
      mockDep1.setAuthState(
        userId: 'test-user-123',
        isAuthenticated: true,
      );
      
      // Register additional mocks if needed
      TestServiceLocator.registerMock<Dependency2>(mockDep2);
      
      // Create test subject with mocks
      repository = YourRepository(
        dependency1: mockDep1,
        dependency2: mockDep2,
      );
    });
    
    tearDown(() async {
      // Clean up after EACH test
      await TestServiceLocator.reset();
      BaseUnitTest.resetMocks();
    });
    
    // tearDownAll is usually not needed
    // Only add if you have global resources to clean up
    
    group('CRUD Operations', () {
      test('should create item successfully', () async {
        // Arrange
        final item = YourModel(id: '123', name: 'Test');
        when(() => mockDep1.create(any())).thenAnswer((_) async => item);
        
        // Act
        final result = await repository.create(item);
        
        // Assert
        expect(result, equals(item));
        verify(() => mockDep1.create(item)).called(1);
      });
      
      test('should handle create error', () async {
        // Arrange
        final item = YourModel(id: '123', name: 'Test');
        when(() => mockDep1.create(any())).thenThrow(
          Exception('Network error'),
        );
        
        // Act & Assert
        expect(
          () => repository.create(item),
          throwsException,
        );
      });
    });
    
    group('Query Operations', () {
      test('should fetch items with filter', () async {
        // Arrange
        final items = [
          YourModel(id: '1', name: 'Item 1'),
          YourModel(id: '2', name: 'Item 2'),
        ];
        when(() => mockDep1.query(any())).thenAnswer((_) async => items);
        
        // Act
        final result = await repository.fetchFiltered('filter');
        
        // Assert
        expect(result, hasLength(2));
        expect(result.first.id, equals('1'));
      });
    });
  });
}
import 'package:flutter_test/flutter_test.dart';
import 'package:mocktail/mocktail.dart';
import 'package:butlery/services/unified/operations/realtime_recipe_operations.dart';
import 'package:butlery/services/unified/unified_recipe_service.dart';
import 'package:butlery/services/realtime_sync_service.dart';
import 'package:butlery/models/recipe_unified.dart';
import 'package:butlery/services/permission_service.dart';

import '../../../../test_support/base_unit_test.dart';
import '../../../../infrastructure/di/test_service_locator.dart';
import '../../../../infrastructure/builders/recipe_builder.dart';
import '../../../../infrastructure/mocks/production_mocks.dart';

// Simplified mock classes
class MockUnifiedRecipeService extends Mock implements UnifiedRecipeService {
  String? _currentUserId = 'test-user-123';
  List<Recipe> _recipes = [];
  
  void setServiceState({
    String? userId,
    List<Recipe>? recipes,
  }) {
    if (userId != null) _currentUserId = userId;
    if (recipes != null) _recipes = recipes;
  }
  
  @override
  String? get currentUserId => _currentUserId;
  
  @override
  List<Recipe> get recipes => _recipes;
}

class MockRealtimeSyncService extends Mock implements RealtimeSyncService {
  bool _isConnected = true;
  
  void setServiceState({
    bool? isConnected,
  }) {
    if (isConnected != null) _isConnected = isConnected;
  }
  
  @override
  bool get isConnected => _isConnected;
}

void main() {
  group('RealtimeRecipeOperations (Simplified)', () {
    late RealtimeRecipeOperations operations;
    late MockUnifiedRecipeService mockParent;
    late MockRealtimeSyncService mockRealtimeService;
    late Recipe testRecipe;
    
    setUpAll(() async {
      await BaseUnitTest.setupUnit();
    });
    
    setUp(() async {
      await TestServiceLocator.initialize();
      
      // Configure PermissionService mock
      final permissionService = TestServiceLocator.get<PermissionService>();
      if (permissionService is MockPermissionService) {
        permissionService.setPermissionState(
          currentUserId: 'test-user-123',
          userDisplayName: 'Test User',
          defaultHasPermission: true,
        );
      }
      
      // Create mocks
      mockParent = MockUnifiedRecipeService();
      mockRealtimeService = MockRealtimeSyncService();
      
      // Create test data
      testRecipe = RecipeBuilder()
          .withId('recipe-123')
          .withTitle('Test Recipe')
          .asCollaborative()
          .build();
      
      // Configure mocks
      mockParent.setServiceState(
        userId: 'test-user-123',
        recipes: [testRecipe],
      );
      
      mockRealtimeService.setServiceState(
        isConnected: true,
      );
      
      // Create operations instance
      operations = RealtimeRecipeOperations(mockParent, mockRealtimeService);
    });
    
    tearDown(() async {
      BaseUnitTest.resetMocks();
      await TestServiceLocator.reset();
    });
    
    tearDownAll(() async {
      await BaseUnitTest.teardownUnit();
    });
    
    group('Basic Operations', () {
      test('should initialize with correct service name', () {
        // Assert
        expect(operations.serviceName, equals('RealtimeRecipeOperations'));
      });
      
      test('should report connection status', () {
        // Assert
        expect(operations.isConnected, isTrue);
      });
      
      test('should handle operations without realtime service', () {
        // Arrange
        final ops = RealtimeRecipeOperations(mockParent, null);
        
        // Assert
        expect(ops.isConnected, isFalse);
      });
      
      test('should check if watching is available', () {
        // Act
        final available = operations.isWatchingAvailable();
        
        // Assert
        expect(available, isA<bool>());
      });
      
      test('should get watching capabilities', () {
        // Act
        final capabilities = operations.getWatchingCapabilities();
        
        // Assert
        expect(capabilities, isA<Map<String, bool>>());
      });
    });
    
    group('Editing Operations', () {
      test('should check if recipe is in realtime editing mode', () {
        // Act
        final isEditing = operations.isInRealtimeEditingMode('recipe-123');
        
        // Assert
        expect(isEditing, isA<bool>());
      });
      
      test('should validate edit changes', () {
        // Act
        final isValid = operations.validateEditChanges(
          'recipe-123',
          {'title': 'Updated Title'},
        );
        
        // Assert
        expect(isValid, isA<bool>());
      });
      
      test('should get edit validation rules', () {
        // Act
        final rules = operations.getEditValidationRules();
        
        // Assert
        expect(rules, isA<Map<String, dynamic>>());
        expect(rules.containsKey('title'), isTrue);
        expect(rules.containsKey('ingredients'), isTrue);
      });
      
      test('should get editing status', () {
        // Act
        final status = operations.getEditingStatus('recipe-123');
        
        // Assert
        expect(status, isA<Map<String, dynamic>>());
      });
    });
    
    group('Collaboration Management', () {
      test('should check if can enable collaboration', () {
        // Act
        final canEnable = operations.canEnableCollaboration('recipe-123');
        
        // Assert
        expect(canEnable, isA<bool>());
      });
      
      test('should check if can disable collaboration', () {
        // Act
        final canDisable = operations.canDisableCollaboration('recipe-123');
        
        // Assert
        expect(canDisable, isA<bool>());
      });
      
      test('should validate member permissions', () {
        // Act
        final validation = operations.validateCollaborationSettings(
          memberIds: ['member-1', 'member-2'],
          memberPermissions: {'member-1': 'admin'},
        );
        
        // Assert
        expect(validation, isA<Map<String, String>>());
      });
      
      test('should get collaboration details', () {
        // Act
        final details = operations.getCollaborationDetails('recipe-123');
        
        // Assert
        expect(details, isA<Map<String, dynamic>>());
      });
    });
    
    group('Statistics', () {
      test('should get collaboration stats', () {
        // Act
        final stats = operations.getCollaborationStats('recipe-123');
        
        // Assert
        expect(stats, isA<Map<String, dynamic>>());
      });
      
      test('should get presence statistics', () {
        // Act
        final stats = operations.getPresenceStatistics();
        
        // Assert
        expect(stats, isA<Map<String, dynamic>>());
      });
      
      test('should get editing history statistics', () async {
        // Act
        final history = await operations.getEditHistory('recipe-123');
        
        // Assert
        expect(history, isA<List<Map<String, dynamic>>>());
      });
    });
  });
}
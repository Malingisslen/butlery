rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user is the owner of the document
    function isDocumentOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }
    
    // Check if user is creating their own document
    function isCreatingOwnDocument() {
      return isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    
    // Check if user is in a list of users
    function isInList(field) {
      return isAuthenticated() && request.auth.uid in resource.data[field];
    }
    
    // Check if user is creating a document with themselves in a list
    function isAddingSelfToList(field) {
      return isAuthenticated() && request.auth.uid in request.resource.data[field];
    }
    
    // Validate that required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    // Check if timestamp is server timestamp
    function isServerTimestamp(field) {
      return request.resource.data[field] == request.time;
    }
    
    // ========================================
    // USER DATA - Private to each user
    // ========================================
    
    // User's private data (recipes, friends, etc.)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // User's recipes
      match /recipes/{recipeId} {
        allow read, write: if isOwner(userId);
      }
      
      // Recipe summaries (lightweight documents)
      match /recipe_summaries/{recipeId} {
        allow read, write: if isOwner(userId);
      }
      
      // User's unified shopping lists
      match /unified_shopping_lists/{listId} {
        allow read, write: if isOwner(userId);
        
        // Shopping list items subcollection
        match /items/{itemId} {
          allow read, write: if isOwner(userId);
        }
      }
      
      // User's friends list
      match /friends/{friendId} {
        allow read, write: if isOwner(userId);
      }
      
      // Friend categories/groups
      match /friendCategories/{categoryId} {
        // Owner has full read/write access
        allow read, write: if isOwner(userId);

        // ✅ CRITICAL FIX: Allow getting specific group by ID (needed for invitation acceptance)
        // Users can fetch a specific category if they know the ID (from invitation)
        // List queries are still protected by the owner check above
        allow get: if isAuthenticated();

        // Group members can read the group they're in
        allow read: if isInList('friendUserIds');

        // ✅ CRITICAL FIX: Allow updating if adding yourself OR already a member
        allow update: if isAuthenticated() && (
          isInList('friendUserIds') ||
          request.auth.uid in request.resource.data.friendUserIds
        );
      }
      
      // Connection tests (for app initialization)
      match /connection_tests/{document} {
        allow read, write: if isOwner(userId);
      }

      // User's conversations metadata (read receipts, per-user settings)
      match /conversations/{conversationId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // ========================================
    // PUBLIC PROFILES - Readable by all authenticated users
    // ========================================
    
    match /public_profiles/{userId} {
      // Anyone authenticated can read profiles for user search functionality
      allow read: if isAuthenticated();
      
      // Only profile owner can write
      allow create: if isOwner(userId) 
        && hasRequiredFields(['displayName', 'email'])
        && request.resource.data.isSearchable is bool;
        
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    // ========================================
    // FRIEND REQUESTS - Between users
    // ========================================
    
    match /friend_requests/{requestId} {
      // Can read if you're the sender or recipient
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      
      // Can create if you're the sender
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.status == 'pending'
        && hasRequiredFields(['fromUserId', 'toUserId', 'status', 'sentAt']);
      
      // Can update if you're the recipient (to accept/reject)
      allow update: if isAuthenticated() 
        && request.auth.uid == resource.data.toUserId
        && request.resource.data.status in ['accepted', 'rejected'];
      
      // Can delete if you're the sender or recipient
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
    }
    
    // ========================================
    // GROUP INVITATIONS - For friend categories
    // ========================================
    
    match /group_invitations/{invitationId} {
      // Can read if you're the sender or recipient
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      
      // Can create if you're the sender
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.status == 'pending'
        && hasRequiredFields(['groupId', 'fromUserId', 'toUserId', 'status', 'sentAt']);
      
      // Can update if you're the recipient
      allow update: if isAuthenticated() 
        && request.auth.uid == resource.data.toUserId
        && request.resource.data.status in ['accepted', 'rejected'];
      
      // Can delete if you're the sender or recipient
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
    }
    
    // ========================================
    // SHARED RECIPES - Shared between users
    // ========================================

    match /shared_recipes/{shareId} {
      // Allow list queries for authenticated users (needed for arrayContainsAny)
      allow list: if isAuthenticated();

      // Can read specific document if you're in the sharedWithUserIds list or the sharedByUserId
      allow get: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.sharedWithUserIds
      );

      // Can create if you're the sharedByUserId and you're in the shared list
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.sharedByUserId
        && request.auth.uid in request.resource.data.sharedWithUserIds
        && request.resource.data.sharedWithUserIds is list
        && hasRequiredFields(['sharedByUserId', 'sharedWithUserIds', 'recipeId', 'sharedAt']);

      // Can update if you're the sharedByUserId or in the shared list
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.get('sharedWithUserIds', [])
      );

      // Can delete if you're the sharedByUserId or in sharedWithUserIds (to remove from your list)
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.sharedWithUserIds
      );

      // ========================================
      // SUBCOLLECTIONS (Issue #014: Unlimited Sharing)
      // ========================================

      // Members subcollection - who the recipe is shared with
      match /members/{userId} {
        // Owner and members can read member list
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/shared_recipes/$(shareId)).data.sharedByUserId ||
          exists(/databases/$(database)/documents/shared_recipes/$(shareId)/members/$(request.auth.uid))
        );

        // Only owner can add members
        allow create: if isAuthenticated()
          && request.auth.uid == get(/databases/$(database)/documents/shared_recipes/$(shareId)).data.sharedByUserId
          && hasRequiredFields(['userId', 'addedBy', 'addedAt']);

        // Members can remove themselves, owner can remove anyone
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          request.auth.uid == get(/databases/$(database)/documents/shared_recipes/$(shareId)).data.sharedByUserId
        );
      }

      // Views subcollection - who has viewed the recipe
      match /views/{userId} {
        // Anyone with access to the recipe can read views
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/shared_recipes/$(shareId)).data.sharedByUserId ||
          exists(/databases/$(database)/documents/shared_recipes/$(shareId)/members/$(request.auth.uid))
        );

        // Users can mark themselves as having viewed
        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && hasRequiredFields(['userId', 'viewedAt']);
      }

      // Engagements subcollection - who has imported the recipe
      match /engagements/{userId} {
        // Anyone with access to the recipe can read engagements
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/shared_recipes/$(shareId)).data.sharedByUserId ||
          exists(/databases/$(database)/documents/shared_recipes/$(shareId)/members/$(request.auth.uid))
        );

        // Users can mark themselves as having engaged (imported)
        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && hasRequiredFields(['userId', 'action', 'engagedAt']);
      }

      // Dismissals subcollection - who has dismissed the recipe
      match /dismissals/{userId} {
        // Owner can read who dismissed, users can read their own dismissal
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/shared_recipes/$(shareId)).data.sharedByUserId ||
          request.auth.uid == userId
        );

        // Users can dismiss for themselves
        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && hasRequiredFields(['userId', 'dismissedAt']);

        // Users can undismiss for themselves
        allow delete: if isAuthenticated()
          && request.auth.uid == userId;
      }

      // Collaborators subcollection - who is actively collaborating
      match /collaborators/{userId} {
        // Anyone with access can read collaborators
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/shared_recipes/$(shareId)).data.sharedByUserId ||
          exists(/databases/$(database)/documents/shared_recipes/$(shareId)/members/$(request.auth.uid))
        );

        // Owner can add collaborators, users can add themselves if collaboration allowed
        allow create: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/shared_recipes/$(shareId)).data.sharedByUserId ||
          (request.auth.uid == userId && get(/databases/$(database)/documents/shared_recipes/$(shareId)).data.allowCollaboration == true)
        ) && hasRequiredFields(['userId', 'joinedAt']);

        // Owner can remove collaborators, users can remove themselves
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          request.auth.uid == get(/databases/$(database)/documents/shared_recipes/$(shareId)).data.sharedByUserId
        );
      }
    }
    
    // ========================================
    // MENUS - User's personal menus
    // ========================================
    
    match /menus/{menuId} {
      // Can read if you're the owner or the menu is shared with you
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.sharedToUserIds
      );
      
      // Can create if you're the sharedByUserId
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.sharedByUserId
        && hasRequiredFields(['sharedByUserId', 'sharedToUserIds', 'title', 'createdAt']);
      
      // Can update if you're the sharedByUserId or in sharedToUserIds
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.sharedToUserIds
      );
      
      // Can delete if you're the sharedByUserId
      allow delete: if isAuthenticated() 
        && request.auth.uid == resource.data.sharedByUserId;
    }
    
    // ========================================
    // SHARED MENUS - Bulk recipe sharing
    // ========================================

    match /shared_menus/{menuId} {
      // Allow list queries for authenticated users (needed for arrayContainsAny)
      allow list: if isAuthenticated();

      // Can read specific document if you're in the sharedToUserIds list or the sharedByUserId
      allow get: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.sharedToUserIds
      );

      // Can create if you're the sharedByUserId
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.sharedByUserId
        && request.resource.data.sharedToUserIds is list
        && hasRequiredFields(['sharedByUserId', 'sharedToUserIds', 'menuSnapshot', 'sharedAt']);

      // Can update if you're the sharedByUserId
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.sharedByUserId;

      // Can delete if you're the sharedByUserId
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.sharedByUserId;

      // ========================================
      // SUBCOLLECTIONS (Issue #014: Unlimited Sharing)
      // ========================================

      // Members subcollection - who the menu is shared with
      match /members/{userId} {
        // Owner and members can read member list
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/shared_menus/$(menuId)).data.sharedByUserId ||
          exists(/databases/$(database)/documents/shared_menus/$(menuId)/members/$(request.auth.uid))
        );

        // Only owner can add members
        allow create: if isAuthenticated()
          && request.auth.uid == get(/databases/$(database)/documents/shared_menus/$(menuId)).data.sharedByUserId
          && hasRequiredFields(['userId', 'addedBy', 'addedAt']);

        // Members can remove themselves, owner can remove anyone
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          request.auth.uid == get(/databases/$(database)/documents/shared_menus/$(menuId)).data.sharedByUserId
        );
      }

      // Views subcollection - who has viewed the menu
      match /views/{userId} {
        // Anyone with access to the menu can read views
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/shared_menus/$(menuId)).data.sharedByUserId ||
          exists(/databases/$(database)/documents/shared_menus/$(menuId)/members/$(request.auth.uid))
        );

        // Users can mark themselves as having viewed
        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && hasRequiredFields(['userId', 'viewedAt']);
      }

      // Engagements subcollection - who has imported the menu
      match /engagements/{userId} {
        // Anyone with access to the menu can read engagements
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/shared_menus/$(menuId)).data.sharedByUserId ||
          exists(/databases/$(database)/documents/shared_menus/$(menuId)/members/$(request.auth.uid))
        );

        // Users can mark themselves as having engaged (imported)
        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && hasRequiredFields(['userId', 'action', 'engagedAt']);
      }

      // Dismissals subcollection - who has dismissed the menu
      match /dismissals/{userId} {
        // Owner can read who dismissed, users can read their own dismissal
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/shared_menus/$(menuId)).data.sharedByUserId ||
          request.auth.uid == userId
        );

        // Users can dismiss for themselves
        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && hasRequiredFields(['userId', 'dismissedAt']);

        // Users can undismiss for themselves
        allow delete: if isAuthenticated()
          && request.auth.uid == userId;
      }

      // Collaborators subcollection - who is actively collaborating
      match /collaborators/{userId} {
        // Anyone with access can read collaborators
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/shared_menus/$(menuId)).data.sharedByUserId ||
          exists(/databases/$(database)/documents/shared_menus/$(menuId)/members/$(request.auth.uid))
        );

        // Owner can add collaborators, users can add themselves if collaboration allowed
        allow create: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/shared_menus/$(menuId)).data.sharedByUserId ||
          (request.auth.uid == userId && get(/databases/$(database)/documents/shared_menus/$(menuId)).data.isCollaborative == true)
        ) && hasRequiredFields(['userId', 'joinedAt']);

        // Owner can remove collaborators, users can remove themselves
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          request.auth.uid == get(/databases/$(database)/documents/shared_menus/$(menuId)).data.sharedByUserId
        );
      }
    }
    
    // ========================================
    // SHARED SHOPPING LISTS - Collaborative lists
    // ========================================
    
    match /shared_shopping_lists/{listId} {
      // Can read if you're in the sharedToUserIds list or the sharedByUserId
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.sharedToUserIds
      );

      // Can create if you're the sharedByUserId and adding yourself to the list
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.sharedByUserId
        && request.auth.uid in request.resource.data.sharedToUserIds
        && hasRequiredFields(['sharedByUserId', 'sharedToUserIds', 'listSnapshot', 'sharedAt']);

      // Can update if you're in the sharedToUserIds (for real-time collaboration)
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.sharedToUserIds
      );

      // Can delete if you're the sharedByUserId
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.sharedByUserId;

      // ========================================
      // SUBCOLLECTIONS (Issue #014: Unlimited Sharing)
      // ========================================

      // Members subcollection - who the shopping list is shared with
      match /members/{userId} {
        // Owner and members can read member list
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/shared_shopping_lists/$(listId)).data.sharedByUserId ||
          exists(/databases/$(database)/documents/shared_shopping_lists/$(listId)/members/$(request.auth.uid))
        );

        // Only owner can add members
        allow create: if isAuthenticated()
          && request.auth.uid == get(/databases/$(database)/documents/shared_shopping_lists/$(listId)).data.sharedByUserId
          && hasRequiredFields(['userId', 'addedBy', 'addedAt']);

        // Members can remove themselves, owner can remove anyone
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          request.auth.uid == get(/databases/$(database)/documents/shared_shopping_lists/$(listId)).data.sharedByUserId
        );
      }

      // Views subcollection - who has viewed the shopping list
      match /views/{userId} {
        // Anyone with access to the shopping list can read views
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/shared_shopping_lists/$(listId)).data.sharedByUserId ||
          exists(/databases/$(database)/documents/shared_shopping_lists/$(listId)/members/$(request.auth.uid))
        );

        // Users can mark themselves as having viewed
        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && hasRequiredFields(['userId', 'viewedAt']);
      }

      // Engagements subcollection - who has joined the shopping list
      match /engagements/{userId} {
        // Anyone with access to the shopping list can read engagements
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/shared_shopping_lists/$(listId)).data.sharedByUserId ||
          exists(/databases/$(database)/documents/shared_shopping_lists/$(listId)/members/$(request.auth.uid))
        );

        // Users can mark themselves as having engaged (joined)
        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && hasRequiredFields(['userId', 'action', 'engagedAt']);
      }

      // Dismissals subcollection - who has dismissed the shopping list
      match /dismissals/{userId} {
        // Owner can read who dismissed, users can read their own dismissal
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/shared_shopping_lists/$(listId)).data.sharedByUserId ||
          request.auth.uid == userId
        );

        // Users can dismiss for themselves
        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && hasRequiredFields(['userId', 'dismissedAt']);

        // Users can undismiss for themselves
        allow delete: if isAuthenticated()
          && request.auth.uid == userId;
      }

      // ========================================
      // SHOPPING LIST ITEMS SUBCOLLECTION (Issue #015)
      // ========================================
      // Allows collaborative editing: all members can add/modify/remove items
      match /items/{itemId} {
        // Helper function to check if user has access to the shopping list
        function isSharedWithUser(userId) {
          return userId == get(/databases/$(database)/documents/shared_shopping_lists/$(listId)).data.sharedByUserId
              || exists(/databases/$(database)/documents/shared_shopping_lists/$(listId)/members/$(userId));
        }

        // Members can read all items
        allow read: if isAuthenticated() && isSharedWithUser(request.auth.uid);

        // Members can add items (collaborative shopping)
        // Validates: required fields, itemId matches document ID, user claims their own ID
        allow create: if isAuthenticated()
          && isSharedWithUser(request.auth.uid)
          && hasRequiredFields(['id', 'name', 'amount', 'unit', 'category', 'bought'])
          && request.resource.data.id == itemId
          && request.resource.data.addedByUserId == request.auth.uid;

        // Members can update items (check off, modify quantities, add notes)
        // Validates: user claims their own ID in lastModifiedByUserId
        allow update: if isAuthenticated()
          && isSharedWithUser(request.auth.uid)
          && request.resource.data.lastModifiedByUserId == request.auth.uid;

        // Members can delete items (remove from shared list)
        allow delete: if isAuthenticated() && isSharedWithUser(request.auth.uid);
      }
    }
    
    // ========================================
    // REALTIME RECIPES - Collaborative editing
    // ========================================
    
    match /realtime_recipes/{recipeId} {
      // Can read if you're a participant in the collaborative recipe
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.participants.keys()
      );
      
      // Allow listing for authenticated users (needed for broad queries)
      allow list: if isAuthenticated();
      
      // Can create if you're the owner and adding yourself as participant
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.participants.keys()
        && hasRequiredFields(['ownerId', 'participants', 'recipe', 'createdAt']);
      
      // Can update if you're a participant (for real-time collaboration)
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.participants.keys()
      );
      
      // Can delete if you're the owner
      allow delete: if isAuthenticated() 
        && request.auth.uid == resource.data.ownerId;
      
      // Presence subcollection for real-time collaboration
      match /presence/{userId} {
        // Can read presence if you're a participant in the recipe
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/realtime_recipes/$(recipeId)).data.ownerId ||
          request.auth.uid in get(/databases/$(database)/documents/realtime_recipes/$(recipeId)).data.participants.keys()
        );
        
        // Can write your own presence if you're a participant
        allow write: if isAuthenticated() 
          && request.auth.uid == userId
          && (
            request.auth.uid == get(/databases/$(database)/documents/realtime_recipes/$(recipeId)).data.ownerId ||
            request.auth.uid in get(/databases/$(database)/documents/realtime_recipes/$(recipeId)).data.participants.keys()
          );
      }
    }
    
    // ========================================
    // RECIPE COMMENTS - Threaded comments
    // ========================================

    match /recipe_comments/{commentId} {
      // Can read if you have access to the parent recipe
      // (This requires checking the shared recipe permissions)
      allow read: if isAuthenticated();

      // Can create if authenticated and providing required fields
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.authorId
        && hasRequiredFields(['authorId', 'recipeId', 'text', 'createdAt'])
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;

      // Can update only your own comments
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.authorId
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;

      // Can delete only your own comments
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.authorId;
    }
    
    // ========================================
    // BUTLERY ARCHIVE - Read-only community recipes
    // ========================================
    
    match /butlery_archive/recipes/{recipeId} {
      // Anyone authenticated can read archive recipes
      allow read: if isAuthenticated();
      // No writing allowed - admin only via server
      allow write: if false;
    }
    
    match /butlery_archive/recipe_summaries/{recipeId} {
      // Anyone authenticated can read archive summaries
      allow read: if isAuthenticated();
      // No writing allowed - admin only via server
      allow write: if false;
    }
    
    // ========================================
    // PERSONAL MENUS - User's individual menus
    // ========================================
    
    match /menus/{menuId} {
      // Can read if you're the owner (userId) or the sharer (sharedByUserId) or in shared list
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.get('sharedByUserId', '') ||
        (resource.data.keys().hasAny(['sharedToUserIds']) && request.auth.uid in resource.data.get('sharedToUserIds', []))
      );
      
      // Can create if you're the owner or sharer
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.get('userId', '') ||
        request.auth.uid == request.resource.data.get('sharedByUserId', '')
      );
      
      // Can update if you're the owner or sharer
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.get('userId', '') ||
        request.auth.uid == resource.data.get('sharedByUserId', '')
      );
      
      // Can delete if you're the owner or sharer
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.get('userId', '') ||
        request.auth.uid == resource.data.get('sharedByUserId', '')
      );
    }
    
    // ========================================
    // CONVERSATIONS - User messaging
    // ========================================

    match /conversations/{conversationId} {
      // Can read if you're a participant
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;

      // Can create if you're adding yourself as a participant
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participantIds
        && hasRequiredFields(['participantIds', 'createdAt']);

      // Can update if you're a participant
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;

      // Can delete if you're a participant
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
    }

    // ========================================
    // MESSAGES - Top-level messages collection (used by repository)
    // ========================================

    match /messages/{messageId} {
      // Can read messages if authenticated AND you're a participant in the conversation
      allow read: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds;

      // Can create messages if you're the sender
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.senderId
        && hasRequiredFields(['senderId', 'conversationId', 'content', 'sentAt']);

      // Can update your own messages
      allow update: if isAuthenticated() && request.auth.uid == resource.data.senderId;

      // Can delete your own messages
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.senderId;
    }
    
    // ========================================
    // CONNECTIVITY TEST - App initialization
    // ========================================
    
    match /connectivity_test/{document} {
      // Anyone authenticated can read connectivity test documents
      allow read: if isAuthenticated();
      // No writing allowed - this is just for testing connectivity
      allow write: if false;
    }
    
    
    // ========================================
    // CONNECTIVITY TEST - Connection validation
    // ========================================
    
    match /connectivity_test/{document} {
      // Allow all authenticated users to read/write for connection testing
      allow read, write: if isAuthenticated();
    }
    
    // ========================================
    // UNIFIED SHARED SHOPPING LISTS - Collaborative shopping
    // ========================================
    
    match /unified_shared_shopping_lists/{listId} {
      // Can read if you're the owner or a collaborator
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.collaborators
      );
      
      // Can create if you're the owner and adding yourself as collaborator
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.collaborators
        && hasRequiredFields(['ownerId', 'collaborators', 'items', 'createdAt']);
      
      // Can update if you're a collaborator (for real-time collaboration)
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.collaborators
      );
      
      // Can delete if you're the owner
      allow delete: if isAuthenticated() 
        && request.auth.uid == resource.data.ownerId;
        
      // Allow listing for authenticated users
      allow list: if isAuthenticated();
    }
    
    // ========================================
    // SHOPPING LISTS - Top-level personal shopping lists
    // ========================================

    match /shoppingLists/{listId} {
      // Can read if you're the owner
      allow read: if isAuthenticated()
        && request.auth.uid == resource.data.ownerId;

      // Can create if authenticated and providing ownerId
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.ownerId;

      // Can update if you're the owner
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.ownerId;

      // Can delete if authenticated and you're the owner
      allow delete: if isAuthenticated()
        && (request.auth.uid == resource.data.get('ownerId', request.auth.uid));
    }

    // ========================================
    // SHARED SHOPPING LISTS - Shopping list sharing system
    // ========================================

    match /sharedShoppingLists/{listId} {
      // Allow list queries for authenticated users (needed for arrayContainsAny)
      allow list: if isAuthenticated();

      // Can read specific document if you shared it or it's shared with you
      allow get: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.sharedWithUserIds
      );

      // Can create if you're the sharer
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.sharedByUserId
        && hasRequiredFields(['sharedByUserId', 'sharedWithUserIds', 'listData', 'sharedAt']);

      // Can update if you're the sharer
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.sharedByUserId;

      // Can delete if you're the sharer
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.sharedByUserId;
    }

    // ========================================
    // USER SHARED SHOPPING LISTS - Tracking received lists
    // ========================================

    match /userSharedShoppingLists/{userId}/receivedLists/{listId} {
      // Users can read their own received lists
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Users can manage their own lists, OR sharers can create notification records
      allow write: if isAuthenticated() && (
        request.auth.uid == userId ||
        request.auth.uid == request.resource.data.sharedByUserId
      );
    }

    // ========================================
    // SHARED MENUS - Menu sharing system
    // ========================================

    match /sharedMenus/{menuId} {
      // Allow list queries for authenticated users (needed for arrayContainsAny)
      allow list: if isAuthenticated();

      // Can read specific document if you shared it or it's shared with you
      allow get: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.sharedWithUserIds
      );

      // Can create if you're the sharer
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.sharedByUserId;

      // Can update if you're the sharer
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.sharedByUserId;

      // Can delete if you're the sharer
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.sharedByUserId;
    }

    // ========================================
    // USER SHARED MENUS - Subcollection tracking
    // ========================================

    match /userSharedMenus/{userId}/receivedMenus/{menuId} {
      // Users can read their own received menus
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Users can manage their own menus, OR sharers can create notification records
      allow write: if isAuthenticated() && (
        request.auth.uid == userId ||
        request.auth.uid == request.resource.data.sharedByUserId
      );
    }

    // ========================================
    // PRESENCE - Online status and typing indicators
    // ========================================

    match /presence/{userId} {
      // Anyone authenticated can read presence for online status
      allow read: if isAuthenticated();

      // Can only write your own presence
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ========================================
    // SHARED CONTENT - Generic content sharing system
    // ========================================

    match /shared_content/{contentId} {
      // Can read if you're the sender or recipient
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );

      // Can create if you're the sender
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.fromUserId != request.resource.data.toUserId
        && hasRequiredFields(['fromUserId', 'toUserId', 'contentType', 'contentData', 'sharedAt']);

      // Can update if you're the sender or recipient (for status updates)
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );

      // Can delete if you're the sender or recipient
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
    }

    // ========================================
    // RECIPE RATINGS - User ratings for recipes
    // ========================================

    match /recipe_ratings/{ratingId} {
      // Can read all ratings (public social feature)
      allow read: if isAuthenticated();

      // Can create if authenticated and rating as yourself
      // Rating ID format: {recipeId}_{userId}
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && hasRequiredFields(['recipeId', 'userId', 'rating', 'createdAt']);

      // Can update only your own ratings
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.userId
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      // Can delete only your own ratings
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.userId;
    }

    // ========================================
    // USER NOTIFICATIONS - Push notifications
    // ========================================

    match /user_notifications/{notificationId} {
      // Can read only your own notifications
      allow read: if isAuthenticated()
        && request.auth.uid == resource.data.userId;

      // System/authenticated users can create notifications for any user
      // (supports server-side notification delivery)
      allow create: if isAuthenticated()
        && hasRequiredFields(['userId', 'type', 'title', 'body', 'createdAt']);

      // Can update only your own notifications (mark as read)
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.userId;

      // Can delete only your own notifications
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.userId;
    }

    // ========================================
    // FCM TOKENS - Firebase Cloud Messaging tokens
    // ========================================

    match /user_fcm_tokens/{userId} {
      // Can read only your own token
      allow read: if isAuthenticated()
        && request.auth.uid == userId;

      // Can write only your own token
      allow write: if isAuthenticated()
        && request.auth.uid == userId;
    }

    // ========================================
    // NOTIFICATION PREFERENCES - User notification settings
    // ========================================

    match /user_notification_preferences/{userId} {
      // Can read only your own preferences
      allow read: if isAuthenticated()
        && request.auth.uid == userId;

      // Can write only your own preferences
      allow write: if isAuthenticated()
        && request.auth.uid == userId;
    }

    // ========================================
    // AUDIT LOGS - GDPR Article 30 compliance
    // ========================================

    match /audit_logs/{logId} {
      // Users can read their own audit logs (GDPR Article 15 - Right of Access)
      allow read: if isAuthenticated()
        && request.auth.uid == resource.data.userId;

      // Only system/server can create audit logs (fire-and-forget from app)
      // In practice, client-side creates are allowed but validated
      allow create: if isAuthenticated()
        && hasRequiredFields(['userId', 'operation', 'resourceType', 'timestamp']);

      // No updates or deletes allowed (immutable audit trail)
      allow update, delete: if false;
    }

    // ========================================
    // USER CONSENT - GDPR Article 7 compliance
    // ========================================

    match /users/{userId}/consent/{consentDoc} {
      // Users can read only their own consent records
      allow read: if isAuthenticated()
        && request.auth.uid == userId;

      // Users can write only their own consent records
      allow write: if isAuthenticated()
        && request.auth.uid == userId
        && hasRequiredFields(['consentVersion', 'purposes', 'timestamp']);
    }

    // ========================================
    // MENU RATINGS - Collaborative menu ratings
    // ========================================

    match /menu_ratings/{menuId}/ratings/{ratingId} {
      // Can read all ratings for a menu you have access to
      allow read: if isAuthenticated();

      // Can create rating if authenticated and rating as yourself
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.ratedBy
        && request.resource.data.rating >= 1.0
        && request.resource.data.rating <= 5.0
        && hasRequiredFields(['rating', 'ratedBy', 'ratedByDisplayName', 'ratedAt']);

      // Can update only your own rating
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.ratedBy;

      // Can delete only your own rating
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.ratedBy;
    }

    // ========================================
    // MENU COMMENTS - Collaborative menu comments
    // ========================================

    match /menu_comments/{menuId}/comments/{commentId} {
      // Can read all comments for a menu you have access to
      allow read: if isAuthenticated();

      // Can create comment if authenticated and commenting as yourself
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.commentedBy
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 1000
        && hasRequiredFields(['comment', 'commentedBy', 'commentedByDisplayName', 'commentedAt']);

      // Can update only your own comment
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.commentedBy;

      // Can delete only your own comment
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.commentedBy;
    }

    // ========================================
    // MENU TEMPLATES - Reusable menu templates
    // ========================================

    match /menu_templates/{templateId} {
      // Can read public templates and your own templates
      allow read: if isAuthenticated() && (
        resource.data.get('isPublic', false) == true ||
        request.auth.uid == resource.data.ownerId
      );

      // Can create if authenticated and creating as yourself
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.ownerId
        && hasRequiredFields(['templateName', 'ownerId', 'menuSnapshot', 'createdAt']);

      // Can update only your own templates
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.ownerId;

      // Can delete only your own templates
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.ownerId;
    }

    // ========================================
    // MENU ACTIVITY - Collaboration activity logs
    // ========================================

    match /menu_activity/{menuId}/activities/{activityId} {
      // Can read activities for menus you have access to
      allow read: if isAuthenticated();

      // Can create activity if authenticated (logged by collaborators)
      allow create: if isAuthenticated()
        && hasRequiredFields(['menuId', 'timestamp']);

      // No updates or deletes allowed (immutable activity trail)
      allow update, delete: if false;
    }

    // ========================================
    // DEFAULT DENY - Catch all other paths
    // ========================================

    // Deny all other document access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user is the owner of the document
    function isDocumentOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }
    
    // Check if user is creating their own document
    function isCreatingOwnDocument() {
      return isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    
    // Check if user is in a list of users
    function isInList(field) {
      return isAuthenticated() && request.auth.uid in resource.data[field];
    }
    
    // Check if user is creating a document with themselves in a list
    function isAddingSelfToList(field) {
      return isAuthenticated() && request.auth.uid in request.resource.data[field];
    }
    
    // Validate that required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    // Check if timestamp is server timestamp
    function isServerTimestamp(field) {
      return request.resource.data[field] == request.time;
    }
    
    // ========================================
    // USER DATA - Private to each user
    // ========================================
    
    // User's private data (recipes, friends, etc.)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // User's recipes
      match /recipes/{recipeId} {
        allow read, write: if isOwner(userId);
      }
      
      // Recipe summaries (lightweight documents)
      match /recipe_summaries/{recipeId} {
        allow read, write: if isOwner(userId);
      }
      
      // User's unified shopping lists
      match /unified_shopping_lists/{listId} {
        allow read, write: if isOwner(userId);
        
        // Shopping list items subcollection
        match /items/{itemId} {
          allow read, write: if isOwner(userId);
        }
      }
      
      // User's friends list
      match /friends/{friendId} {
        allow read, write: if isOwner(userId);
      }
      
      // Friend categories/groups
      match /friendCategories/{categoryId} {
        allow read, write: if isOwner(userId);
      }
      
      // Connection tests (for app initialization)
      match /connection_tests/{document} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // ========================================
    // PUBLIC PROFILES - Readable by all authenticated users
    // ========================================
    
    match /public_profiles/{userId} {
      // Anyone authenticated can read profiles for user search functionality
      allow read: if isAuthenticated();
      
      // Only profile owner can write
      allow create: if isOwner(userId) 
        && hasRequiredFields(['displayName', 'email'])
        && request.resource.data.isSearchable is bool;
        
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    // ========================================
    // FRIEND REQUESTS - Between users
    // ========================================
    
    match /friend_requests/{requestId} {
      // Can read if you're the sender or recipient
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      
      // Can create if you're the sender
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.status == 'pending'
        && hasRequiredFields(['fromUserId', 'toUserId', 'status', 'sentAt']);
      
      // Can update if you're the recipient (to accept/reject)
      allow update: if isAuthenticated() 
        && request.auth.uid == resource.data.toUserId
        && request.resource.data.status in ['accepted', 'rejected'];
      
      // Can delete if you're the sender or recipient
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
    }
    
    // ========================================
    // GROUP INVITATIONS - For friend categories
    // ========================================
    
    match /group_invitations/{invitationId} {
      // Can read if you're the sender or recipient
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      
      // Can create if you're the sender
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.status == 'pending'
        && hasRequiredFields(['groupId', 'fromUserId', 'toUserId', 'status', 'sentAt']);
      
      // Can update if you're the recipient
      allow update: if isAuthenticated() 
        && request.auth.uid == resource.data.toUserId
        && request.resource.data.status in ['accepted', 'rejected'];
      
      // Can delete if you're the sender or recipient
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
    }
    
    // ========================================
    // SHARED RECIPES - Shared between users
    // ========================================
    
    match /shared_recipes/{shareId} {
      // Can read if you're in the sharedToUserIds list or the sharedByUserId
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.sharedToUserIds
      );
      
      // Can create if you're the sharedByUserId
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.sharedByUserId
        && request.resource.data.sharedToUserIds is list
        && hasRequiredFields(['sharedByUserId', 'sharedToUserIds', 'recipeSnapshot', 'sharedAt']);
      
      // Can update if you're the sharedByUserId
      allow update: if isAuthenticated() 
        && request.auth.uid == resource.data.sharedByUserId;
      
      // Can delete if you're the sharedByUserId or in sharedToUserIds (to remove from your list)
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.sharedToUserIds
      );
    }
    
    // ========================================
    // MENUS - User's personal menus
    // ========================================
    
    match /menus/{menuId} {
      // Can read if you're the owner or the menu is shared with you
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.sharedToUserIds
      );
      
      // Can create if you're the sharedByUserId
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.sharedByUserId
        && hasRequiredFields(['sharedByUserId', 'sharedToUserIds', 'title', 'createdAt']);
      
      // Can update if you're the sharedByUserId or in sharedToUserIds
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.sharedToUserIds
      );
      
      // Can delete if you're the sharedByUserId
      allow delete: if isAuthenticated() 
        && request.auth.uid == resource.data.sharedByUserId;
    }
    
    // ========================================
    // SHARED MENUS - Bulk recipe sharing
    // ========================================
    
    match /shared_menus/{menuId} {
      // Can read if you're in the sharedToUserIds list or the sharedByUserId
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.sharedToUserIds
      );
      
      // Can create if you're the sharedByUserId
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.sharedByUserId
        && request.resource.data.sharedToUserIds is list
        && hasRequiredFields(['sharedByUserId', 'sharedToUserIds', 'menuSnapshot', 'sharedAt']);
      
      // Can update if you're the sharedByUserId
      allow update: if isAuthenticated() 
        && request.auth.uid == resource.data.sharedByUserId;
      
      // Can delete if you're the sharedByUserId
      allow delete: if isAuthenticated() 
        && request.auth.uid == resource.data.sharedByUserId;
    }
    
    // ========================================
    // SHARED SHOPPING LISTS - Collaborative lists
    // ========================================
    
    match /shared_shopping_lists/{listId} {
      // Can read if you're in the sharedToUserIds list or the sharedByUserId
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.sharedToUserIds
      );
      
      // Can create if you're the sharedByUserId and adding yourself to the list
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.sharedByUserId
        && request.auth.uid in request.resource.data.sharedToUserIds
        && hasRequiredFields(['sharedByUserId', 'sharedToUserIds', 'listSnapshot', 'sharedAt']);
      
      // Can update if you're in the sharedToUserIds (for real-time collaboration)
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId ||
        request.auth.uid in resource.data.sharedToUserIds
      );
      
      // Can delete if you're the sharedByUserId
      allow delete: if isAuthenticated() 
        && request.auth.uid == resource.data.sharedByUserId;
    }
    
    // ========================================
    // REALTIME RECIPES - Collaborative editing
    // ========================================
    
    match /realtime_recipes/{recipeId} {
      // Can read if you're a participant in the collaborative recipe
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.participants.keys()
      );
      
      // Allow listing for authenticated users (needed for broad queries)
      allow list: if isAuthenticated();
      
      // Can create if you're the owner and adding yourself as participant
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.participants.keys()
        && hasRequiredFields(['ownerId', 'participants', 'recipe', 'createdAt']);
      
      // Can update if you're a participant (for real-time collaboration)
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.participants.keys()
      );
      
      // Can delete if you're the owner
      allow delete: if isAuthenticated() 
        && request.auth.uid == resource.data.ownerId;
      
      // Presence subcollection for real-time collaboration
      match /presence/{userId} {
        // Can read presence if you're a participant in the recipe
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/realtime_recipes/$(recipeId)).data.ownerId ||
          request.auth.uid in get(/databases/$(database)/documents/realtime_recipes/$(recipeId)).data.participants.keys()
        );
        
        // Can write your own presence if you're a participant
        allow write: if isAuthenticated() 
          && request.auth.uid == userId
          && (
            request.auth.uid == get(/databases/$(database)/documents/realtime_recipes/$(recipeId)).data.ownerId ||
            request.auth.uid in get(/databases/$(database)/documents/realtime_recipes/$(recipeId)).data.participants.keys()
          );
      }
    }
    
    // ========================================
    // RECIPE COMMENTS - Threaded comments
    // ========================================
    
    match /recipe_comments/{commentId} {
      // Can read if you have access to the parent recipe
      // (This requires checking the shared recipe permissions)
      allow read: if isAuthenticated();
      
      // Can create if authenticated and providing required fields
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.userId
        && hasRequiredFields(['userId', 'recipeId', 'content', 'createdAt'])
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000;
      
      // Can update only your own comments
      allow update: if isAuthenticated() 
        && request.auth.uid == resource.data.userId
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000;
      
      // Can delete only your own comments
      allow delete: if isAuthenticated() 
        && request.auth.uid == resource.data.userId;
    }
    
    // ========================================
    // BUTLERY ARCHIVE - Read-only community recipes
    // ========================================
    
    match /butlery_archive/recipes/{recipeId} {
      // Anyone authenticated can read archive recipes
      allow read: if isAuthenticated();
      // No writing allowed - admin only via server
      allow write: if false;
    }
    
    match /butlery_archive/recipe_summaries/{recipeId} {
      // Anyone authenticated can read archive summaries
      allow read: if isAuthenticated();
      // No writing allowed - admin only via server
      allow write: if false;
    }
    
    // ========================================
    // PERSONAL MENUS - User's individual menus
    // ========================================
    
    match /menus/{menuId} {
      // Can read if you're the owner (userId) or the sharer (sharedByUserId) or in shared list
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.get('sharedByUserId', '') ||
        (resource.data.keys().hasAny(['sharedToUserIds']) && request.auth.uid in resource.data.get('sharedToUserIds', []))
      );
      
      // Can create if you're the owner or sharer
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.get('userId', '') ||
        request.auth.uid == request.resource.data.get('sharedByUserId', '')
      );
      
      // Can update if you're the owner or sharer
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.get('userId', '') ||
        request.auth.uid == resource.data.get('sharedByUserId', '')
      );
      
      // Can delete if you're the owner or sharer
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.get('userId', '') ||
        request.auth.uid == resource.data.get('sharedByUserId', '')
      );
    }
    
    // ========================================
    // CONVERSATIONS - User messaging
    // ========================================
    
    match /conversations/{conversationId} {
      // Can read if you're a participant
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      
      // Can create if you're adding yourself as a participant
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.participantIds
        && hasRequiredFields(['participantIds', 'createdAt']);
      
      // Can update if you're a participant
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      
      // Can delete if you're a participant
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      
      // Messages subcollection
      match /messages/{messageId} {
        // Can read messages if you're a participant in the conversation
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        
        // Can create messages if you're a participant and the sender
        allow create: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.auth.uid == request.resource.data.senderId
          && hasRequiredFields(['senderId', 'content', 'timestamp']);
        
        // Can update your own messages
        allow update: if isAuthenticated() && request.auth.uid == resource.data.senderId;
        
        // Can delete your own messages
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.senderId;
      }
    }
    
    // ========================================
    // CONNECTIVITY TEST - App initialization
    // ========================================
    
    match /connectivity_test/{document} {
      // Anyone authenticated can read connectivity test documents
      allow read: if isAuthenticated();
      // No writing allowed - this is just for testing connectivity
      allow write: if false;
    }
    
    // ========================================
    // CONVERSATIONS - Chat messages
    // ========================================
    
    match /conversations/{conversationId} {
      // Can read if you're a participant
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participantIds
      );
      
      // Can create if you're adding yourself as participant
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.participantIds
        && hasRequiredFields(['participantIds', 'createdAt']);
      
      // Can update if you're a participant
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participantIds
      );
      
      // Can delete if you're a participant
      allow delete: if isAuthenticated() && (
        request.auth.uid in resource.data.participantIds
      );
    }
    
    // ========================================
    // CONNECTIVITY TEST - Connection validation
    // ========================================
    
    match /connectivity_test/{document} {
      // Allow all authenticated users to read/write for connection testing
      allow read, write: if isAuthenticated();
    }
    
    // ========================================
    // UNIFIED SHARED SHOPPING LISTS - Collaborative shopping
    // ========================================
    
    match /unified_shared_shopping_lists/{listId} {
      // Can read if you're the owner or a collaborator
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.collaborators
      );
      
      // Can create if you're the owner and adding yourself as collaborator
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.collaborators
        && hasRequiredFields(['ownerId', 'collaborators', 'items', 'createdAt']);
      
      // Can update if you're a collaborator (for real-time collaboration)
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.collaborators
      );
      
      // Can delete if you're the owner
      allow delete: if isAuthenticated() 
        && request.auth.uid == resource.data.ownerId;
        
      // Allow listing for authenticated users
      allow list: if isAuthenticated();
    }
    
    // ========================================
    // USER SHARED MENUS - Subcollection tracking
    // ========================================
    
    match /userSharedMenus/{userId}/receivedMenus/{menuId} {
      // Can read/write if you're the user
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // ========================================
    // DEFAULT DENY - Catch all other paths
    // ========================================
    
    // Deny all other document access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
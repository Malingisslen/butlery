rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // COLLECTION INVENTORY (quick reference — does this collection have rules?)
    //
    // User-scoped (under users/{userId}):
    //   recipes, unified_shopping_lists(/items), ingredients, personal_tags,
    //   personal_tag_groups, friends, friend_categories, conversations,
    //   rate_limits, counters, conversation_memberships,
    //   settings, consent, category_preferences, list_category_orders,
    //   canonical_rating_events (pooled-ratings pool events, server-only writes)
    //
    // Social / shared:
    //   public_profiles, social_requests,
    //   shared_content(/members/views/engagements/dismissals/collaborators/items),
    //   recipe_comments(/likes), recipe_ratings,
    //   recipe_social_stats (server-only),
    //   canonical_recipe_stats (pooled-ratings aggregate, server-only)
    //
    // Realtime collaboration:
    //   realtime_recipes(/presence), recipePresence(/activeUsers)
    //
    // Infrastructure / read-only:
    //   ingredients (global), ingredient_substitutions, tag_configs,
    //   site_configs, globalRecipeCache, connectivity_test
    //
    // Notifications / messaging:
    //   user_notifications, user_fcm_tokens, user_notification_preferences,
    //   notification_history, notification_batches, conversations, messages
    //
    // Other:
    //   menus, blocks, presence, feedback, deep_links(/clicks), reports,
    //   audit_logs, deletion_audit_logs, llm_response_samples (server-only),
    //   ingredient_suggestions, butlery_archive,
    //   unified_shared_shopping_lists, shopping_list_templates,
    //   user_shared_shopping_lists, user_shared_menus, menu_templates
    //
    // Collection groups: members, engagements, comments, ratings
    //
    // Notification analytics:
    //   notification_delivery, notification_engagement, notification_metrics

    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user is a moderator/admin.
    // Admin UIDs are stored as documents in the `admins/{uid}` collection.
    // The collection itself is write-locked (seeded server-side via Firebase
    // Console / Admin SDK only).
    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user is the owner of the document
    function isDocumentOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }
    
    // Check if user is creating their own document
    function isCreatingOwnDocument() {
      return isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    
    // Check if user is in a list of users
    function isInList(field) {
      return isAuthenticated() && request.auth.uid in resource.data[field];
    }
    
    // Check if user is creating a document with themselves in a list
    function isAddingSelfToList(field) {
      return isAuthenticated() && request.auth.uid in request.resource.data[field];
    }
    
    // Validate that required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    // Check if timestamp is server timestamp
    function isServerTimestamp(field) {
      return request.resource.data[field] == request.time;
    }

    // Check that an update does not modify immutable fields
    function cannotModify(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // BUT-659: anti-spam cooldown for high-friction social actions on
    // brand-new accounts. Returns true when the account is "matured":
    //   - email is verified, OR
    //   - the user document was created at least 60 minutes ago.
    // Treats a missing user doc / missing createdAt as "not matured" so
    // pre-onboarding bots cannot bypass the gate.
    //
    // Constant kept in sync with `kAccountMaturityMinutes` on the Dart
    // side (lib/services/auth/account_maturity_helper.dart).
    function isAccountMatured() {
      return isAuthenticated() && (
        request.auth.token.email_verified == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          'createdAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
          (request.time.toMillis()
            - get(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdAt.toMillis())
          >= 60 * 60 * 1000
        )
      );
    }

    // BUT-1386 (ADR-0002): server-authoritative age gate. True only when the
    // `verifySignupAge` Cloud Function has set the `ageCompliant` custom claim
    // (≥15). Fails CLOSED — a missing/false claim, or a stale token issued
    // before the claim was set, evaluates to false and denies. Composed with
    // (not merged into) isAccountMatured(): maturity is anti-spam, age is legal
    // eligibility; a write must satisfy both where both apply.
    function isAgeCompliant() {
      return isAuthenticated() && request.auth.token.ageCompliant == true;
    }

    // CRIT-8: Validate user-defined ingredient structure (allergen safety-critical)
    // Prevents injection of malicious ingredient properties
    function _isValidUserIngredient(ingredient, ingredientId) {
      return ingredient == null || (
        // ID must match document ID (prevents path traversal)
        ingredient.get('id', '') == ingredientId &&
        // Status must be 'user-defined' (not 'active' which is for admin ingredients)
        ingredient.get('status', '') == 'user-defined' &&
        // Swedish name is required for lookup
        ingredient.get('swedish', '').size() > 0 &&
        ingredient.get('swedish', '').size() <= 100 &&
        // Properties must be a list with reasonable size
        ingredient.get('properties', []) is list &&
        ingredient.get('properties', []).size() <= 20 &&
        // Aliases limited to prevent storage abuse
        ingredient.get('aliasesSv', []).size() <= 10 &&
        ingredient.get('aliasesEn', []).size() <= 10 &&
        ingredient.get('searchTerms', []).size() <= 20
      );
    }

    // CRIT-2: Validate tagResult field structure (allergen safety-critical data)
    // Prevents client-side tampering with allergen status
    function isValidTagResult(tagResult) {
      return tagResult == null || (
        // Only allow known fields (including isPartial, schemaVersion added in v1.0)
        tagResult.keys().hasOnly(['tags', 'allergenStatus', 'dietaryStatus',
                                  'coverage', 'unknownIngredients', 'generatedAt',
                                  'generatorVersion', 'isPartial', 'schemaVersion',
                                  'errorReason', 'hasDraftIngredients']) &&
        // Coverage must be valid percentage (0.0-1.0)
        (tagResult.get('coverage', 0) >= 0 && tagResult.get('coverage', 0) <= 1) &&
        // GeneratedAt must be a timestamp if present
        (tagResult.get('generatedAt', null) == null || tagResult.get('generatedAt', null) is timestamp) &&
        // CRIT-2: isPartial must be boolean if present
        (tagResult.get('isPartial', false) is bool) &&
        // CRIT-2: schemaVersion must be valid (1 or 2) if present
        (tagResult.get('schemaVersion', 1) >= 1 && tagResult.get('schemaVersion', 1) <= 2) &&
        // CRIT-2: Limit unknownIngredients size to prevent storage abuse
        (tagResult.get('unknownIngredients', []).size() <= 100) &&
        // H15: Validate allergenStatus and dietaryStatus have valid TriState values
        _isValidTriStateMap(tagResult.get('allergenStatus', {})) &&
        _isValidTriStateMap(tagResult.get('dietaryStatus', {}))
      );
    }

    // H15: Validate that all values in a map are valid TriState strings
    // Valid values: both legacy uppercase (FREE, CONTAINS, UNKNOWN) and current lowercase
    function _isValidTriStateMap(statusMap) {
      return statusMap == null || statusMap.size() == 0 || (
        statusMap is map &&
        // Limit map size to prevent storage abuse
        statusMap.size() <= 50 &&
        // Validate every value is a recognized TriState string
        statusMap.values().hasOnly(['contains', 'free', 'unknown', 'CONTAINS', 'FREE', 'UNKNOWN'])
      );
    }

    // P3-14: Check if the requesting user is blocked by the target user
    // Uses dedicated blocks collection with composite-key docs for O(1) lookups
    function isNotBlockedBy(targetUserId) {
      return !exists(/databases/$(database)/documents/blocks/$(targetUserId + '_' + request.auth.uid));
    }

    // P3-13: Server-side UGC rate limiting via rate_limits subcollection
    function rateLimitWrite(collection, seconds) {
      let limitsPath = /databases/$(database)/documents/users/$(request.auth.uid)/rate_limits/$(collection);
      return !exists(limitsPath)
        || get(limitsPath).data.lastWrite + duration.value(seconds, 's') <= request.time;
    }

    // ------------------------------------------------------------------
    // BUT-674: 1:1 DM minor-safety helpers.
    // A non-friend must not be able to open a direct-message conversation
    // with a minor. `isMinor:true` is written server-authoritatively by the
    // verifySignupAge CF onto users/{uid} for a compliant 15–17-year-old.
    // These helpers fire ONLY on a 1:1 conversation create (participantIds
    // size == 2); Firestore rules cannot iterate a group participant list.
    // ------------------------------------------------------------------

    // The participant who is NOT the creator, for a 2-person conversation.
    function otherParticipant(participantIds) {
      return participantIds[0] == request.auth.uid
        ? participantIds[1]
        : participantIds[0];
    }

    // True only when the other user's profile doc exists and explicitly
    // carries isMinor == true. A missing doc or absent/false field is
    // treated as NON-minor (fail-open for adults — adults are unaffected).
    function otherIsMinor(otherUid) {
      let userPath = /databases/$(database)/documents/users/$(otherUid);
      return exists(userPath)
        && get(userPath).data.get('isMinor', false) == true;
    }

    // The creator is a friend of the (minor) other user: a doc exists at
    // users/{other}/friends/{creator} (same directional pattern as
    // cook_snaps read ~L1250 and activity_events read ~L1354).
    function creatorIsFriendOf(otherUid) {
      return exists(/databases/$(database)/documents/users/$(otherUid)/friends/$(request.auth.uid));
    }

    // 1:1-only minor gate. For a 2-person conversation, if the OTHER
    // participant is a minor, the creator must be their friend. Adults
    // (or missing/false isMinor) pass unchanged. Group conversations
    // (size != 2) are NOT gated here — see the create rule comment.
    function passesMinorDmGate(participantIds) {
      return participantIds.size() != 2
        || !otherIsMinor(otherParticipant(participantIds))
        || creatorIsFriendOf(otherParticipant(participantIds));
    }

    // BUT-1626 (BUT-674): server-side hard-deny of minor discoverability.
    // A compliant 15–17-year-old (isMinor:true on the CF-set users/{uid} doc)
    // must never be searchable. BUT-1454 item #1 already keeps a minor out of
    // search on every ordinary write — UserProfile.toFirestore forces
    // public_profiles.isSearchable:false for minors — but that is CLIENT-side
    // only; a tampered client could still write isSearchable:true. This helper
    // closes the hole at the rules layer. Cost: one get() on users/{uid}, and the
    // callers short-circuit so it fires ONLY when a write actually SETS
    // isSearchable:true — ordinary minor saves (isSearchable:false) pay nothing.
    // A missing users/{uid} doc or absent/false isMinor reads as non-minor
    // (adults unaffected).
    function accountIsMinor(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return exists(userPath)
        && get(userPath).data.get('isMinor', false) == true;
    }

    // Shared content helpers — used by shared_content collection
    function getDocData(collectionName, docId) {
      return get(/databases/$(database)/documents/$(collectionName)/$(docId)).data;
    }
    function isSharedOwner(collectionName, docId) {
      return request.auth.uid == getDocData(collectionName, docId).sharedByUserId;
    }
    function isSharedMember(collectionName, docId) {
      return exists(/databases/$(database)/documents/$(collectionName)/$(docId)/members/$(request.auth.uid));
    }
    function hasSharedAccess(collectionName, docId) {
      return isSharedOwner(collectionName, docId) || isSharedMember(collectionName, docId);
    }

    // Realtime collaboration helper — used by realtime_recipes, realtime_menus, realtime_resources
    // Uses get() which returns null for non-existent docs (avoids exists()+get() double read)
    function isRealtimeParticipant(collectionName, docId) {
      let parentPath = /databases/$(database)/documents/$(collectionName)/$(docId);
      let parentDoc = get(parentPath);
      return parentDoc != null
        && (request.auth.uid == parentDoc.data.ownerId
            || request.auth.uid in parentDoc.data.participantIds);
    }

    // ===== Family-rating feature: household-scoped membership =====
    // A household (households/{hid}) is the shared identity scoping diner
    // profiles + family ratings. Membership/permission live on the household
    // doc as denormalised memberUserIds (list) + memberPermissions
    // ({uid: 'view'|'edit'|'admin'}). Null-safe get() (no exists()+get() double read).
    function householdDoc(hid) {
      return get(/databases/$(database)/documents/households/$(hid));
    }
    function isHouseholdMember(hid) {
      let doc = householdDoc(hid);
      return isAuthenticated()
        && doc != null
        && request.auth.uid in doc.data.memberUserIds;
    }
    function familyStarsValid(stars) {
      return stars is int && stars >= 1 && stars <= 5;
    }
    function dinerHasAllergenData(data) {
      return 'allergenPreferences' in data
        && (data.allergenPreferences.get('trackedAllergens', []).size() > 0
            || data.allergenPreferences.get('trackedDietary', []).size() > 0);
    }
    // Server-side replication of the repository consent guard (the one layer the
    // inherited createBatch path cannot bypass): a minor must carry guardian
    // consent; allergen (Art. 9) data requires explicit includesAllergenConsent.
    function dinerConsentValid(data) {
      return (data.ageBand == 'adult'
              || ('guardianConsent' in data && data.guardianConsent != null))
        && (!dinerHasAllergenData(data)
            || (data.get('guardianConsent', {}).get('includesAllergenConsent', false) == true));
    }

    // ========================================
    // USER DATA - Private to each user
    // ========================================
    
    // User's private data (recipes, friends, etc.)
    match /users/{userId} {
      // Admin dashboard reads the users collection to count accounts
      // (count() aggregation needs collection-level read). Write stays
      // owner-only — admin never mutates user docs.
      allow read: if isOwner(userId) || isAdmin();

      // BUT-1386 (ADR-0002): `birthYear` is dual-located (profile doc here +
      // settings/preferences) and is now written ONLY by the `verifySignupAge`
      // Cloud Function (Admin SDK bypasses these rules). The client must not
      // create or mutate it on the profile doc either — the gate's integrity
      // wants a single trusted writer. Split the former `allow write` so the
      // birthYear-immutability clause can sit on create + update; delete stays
      // owner-only.
      //
      // BUT-674: `isMinor` is the same shape — server-authoritative, set ONLY by
      // verifySignupAge (Admin SDK). It gates DMs to a minor, so a client that
      // could write `isMinor:false` would un-gate itself. Mirror birthYear's
      // create-absent + update-immutable clauses. NOTE: `isSearchable` stays
      // freely client-writable — a minor's private default is set once by the CF,
      // but the user may later opt into discovery by toggling it (Q1).
      allow create: if isOwner(userId)
        && request.resource.data.get('birthYear', null) == null
        && request.resource.data.get('isMinor', null) == null;
      allow update: if isOwner(userId)
        && request.resource.data.get('birthYear', null)
           == resource.data.get('birthYear', null)
        && request.resource.data.get('isMinor', null)
           == resource.data.get('isMinor', null);
      allow delete: if isOwner(userId);

      // User's recipes
      match /recipes/{recipeId} {
        // Read access for the owner, OR any uid the owner explicitly shared
        // this recipe with (key in socialData.memberPermissions). Read-only —
        // the allergen-critical create/update validation below stays owner-only.
        allow read: if isOwner(userId)
          || (isAuthenticated()
              && request.auth.uid in resource.data.get('socialData', {})
                                             .get('memberPermissions', {}));

        // TagResult validation on create/update (allergen safety critical)
        allow create: if isOwner(userId)
          && isValidTagResult(request.resource.data.get('core', {}).get('tagResult', null));

        // Update: tagResult valid AND cookCount, if present, only moves by +1
        // or stays equal. Handles three legal cases:
        //   1. new value absent (unchanged on this write) -> always fine
        //   2. legacy->1: resource.data.core.cookCount was null, new is 1
        //   3. normal bump: new == old + 1, or equal (no-op/other field edit)
        // Arbitrary values (e.g. +5, reset to 0) are rejected.
        allow update: if isOwner(userId)
          && isValidTagResult(request.resource.data.get('core', {}).get('tagResult', null))
          && (
            !('cookCount' in request.resource.data.get('core', {}))
            || request.resource.data.core.cookCount
                 == resource.data.get('core', {}).get('cookCount', null)
            || request.resource.data.core.cookCount
                 == resource.data.get('core', {}).get('cookCount', 0) + 1
          );

        allow delete: if isOwner(userId);

        // Moderation override: admins may remove user-owned recipes flagged
        // via the reports workflow. Read is needed so the moderator view can
        // fetch a preview before acting.
        allow read, delete: if isAdmin();
      }

      // User's unified shopping lists
      match /unified_shopping_lists/{listId} {
        allow read, write: if isOwner(userId);

        // Shopping list items subcollection
        match /items/{itemId} {
          allow read, write: if isOwner(userId);
        }
      }

      // CRIT-8: User-defined ingredients (allergen-safety critical)
      // Prevents cross-user ingredient tampering that could inject false allergen data
      match /ingredients/{ingredientId} {
        // Owner can read their own ingredients
        allow read: if isOwner(userId);

        // Owner can create/update with validation to prevent malicious data
        allow create, update: if isOwner(userId)
          && _isValidUserIngredient(request.resource.data, ingredientId);

        // Owner can delete their own ingredients
        allow delete: if isOwner(userId);
      }

      // User's personal tags for custom recipe categorization
      match /personal_tags/{tagId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
          // Structural validation: prevent oversized documents
          && request.resource.data.get('name', '').size() <= 50
          && request.resource.data.get('rules', []).size() <= 20;
      }

      // User's personal tag groups for organizing tags
      match /personal_tag_groups/{groupId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
          && request.resource.data.get('name', '').size() <= 50;
      }

      // User's friends list
      // Pre-release audit B1: a user may only WRITE into their OWN friends
      // subcollection. The mutual friend-doc write on acceptance moves to the
      // `acceptFriendRequest` Cloud Function (Admin SDK), which validates the
      // social_request first. This closes the hole where the old
      // `request.auth.uid == friendId` write branch let any signed-in user
      // insert themselves into a victim's friends list (no consent) and thereby
      // read the victim's private cook_snaps / activity_events.
      //
      // Read stays bidirectional (you can see a friend doc that names you).
      // Delete stays bidirectional so client-side mutual removal still works
      // (removing yourself from the other party's list is not a privacy
      // escalation).
      match /friends/{friendId} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == friendId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || (isAuthenticated() && request.auth.uid == friendId);
      }
      
      // Friend categories/groups
      match /friend_categories/{categoryId} {
        // Owner: read access
        allow read: if isOwner(userId);

        // Owner: create and delete
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId);

        // Owner: standard updates — protect immutable fields (ownerId, createdAt)
        allow update: if isOwner(userId)
          && cannotModify(['ownerId', 'createdAt']);

        // Owner: ownership transfer — only ownerId + updatedAt may change
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ownerId', 'updatedAt']);

        // Group members can read the group they're in
        allow read: if isInList('friendUserIds');

        // get requires membership (pendingInviteUserIds removed — dead field)
        allow get: if isAuthenticated() && isInList('friendUserIds');

        // Non-owner members can only modify friendUserIds and updatedAt.
        // BUT-464: tighten so a member can ONLY add or remove their OWN UID.
        // Without this, any member could bloat the array up to size 200 with
        // arbitrary userIds, degrading UX / causing client OOM on reads.
        // Bulk-edit by the owner is unaffected (owner uses the rule above).
        allow update: if isAuthenticated()
          && isInList('friendUserIds')
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['friendUserIds', 'updatedAt'])
          && request.resource.data.friendUserIds.size() <= 200
          // Symmetric difference of the array (treated as a set) must be a
          // subset of [auth.uid] — i.e. the only UID that may have moved
          // in/out of the membership is the requesting user's own.
          && request.resource.data.friendUserIds.toSet()
               .difference(resource.data.friendUserIds.toSet())
               .union(resource.data.friendUserIds.toSet()
                  .difference(request.resource.data.friendUserIds.toSet()))
               .hasOnly([request.auth.uid])
          && rateLimitWrite('friend_category_member', 5);

        // Moderation override (BUT-511): admins may read + delete any
        // reported group via the reports workflow. Read is needed so the
        // moderator review view can show a preview before acting.
        allow read, delete: if isAdmin();
      }
      
      // User's conversations metadata (read receipts, per-user settings)
      match /conversations/{conversationId} {
        allow read, write: if isOwner(userId);
      }

      // P3-06: Rate limit tracking subcollection — owner read/write only
      match /rate_limits/{type} {
        allow read, write: if isOwner(userId);
      }

      // Shared content counters — cross-user writes for sharing notifications
      match /counters/{counterId} {
        allow read: if isOwner(userId);
        // Any authenticated user can increment counters (sharing notifications)
        // Rate limited to prevent counter-spam attacks
        allow create, update: if isAuthenticated()
          && request.resource.data.keys().hasOnly([
            'shared_recipes', 'shared_menus', 'shared_shopping_lists',
            'totalSharedContent', 'lastUpdated'
          ])
          && isServerTimestamp('lastUpdated')
          && rateLimitWrite('shared_content_counter', 5);
        allow delete: if isOwner(userId);
      }

      // Conversation memberships — cross-user writes when adding to group chats
      match /conversation_memberships/{conversationId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isAuthenticated()
          && request.resource.data.keys().hasOnly([
            'conversationId', 'conversationTitle', 'isGroup',
            'lastActivityAt', 'hasUnread', 'joinedAt', 'isArchived'
          ])
          && request.resource.data.conversationId == conversationId
          && rateLimitWrite('conversation_membership', 5);
      }

      // User settings subcollection — owner-only.
      // The `preferences` doc carries `birthYear` (age floor for Butlery's
      // social/UGC service, floor = 15 per ADR-0001 / Dataskyddslag 2 kap. 4 §).
      // BUT-1386 (ADR-0002): `birthYear` is now written ONLY by the
      // `verifySignupAge` Cloud Function (Admin SDK, which bypasses these
      // rules). Clients may write the rest of preferences but may NOT create or
      // mutate `birthYear` — that closes the old "skip / null-out birthYear"
      // self-declaration bypass. The CF, not the rule arithmetic, is the
      // authoritative age check; the `ageCompliant` claim is the gate.
      match /settings/{settingId} {
        allow read: if isOwner(userId);

        // Client create must not carry birthYear or isMinor at all — both are
        // CF-set (BUT-674 mirrors isMinor here so the client profile can read it
        // for analytics minimization; a client that could forge isMinor:false
        // would defeat that minimization and mislead any minor-aware client logic).
        allow create: if isOwner(userId)
          && request.resource.data.get('birthYear', null) == null
          && request.resource.data.get('isMinor', null) == null;

        // Client update must leave birthYear and isMinor exactly as the CF set
        // them (or absent if not yet set). Comparing post-write to existing denies
        // any add/change/remove while allowing all other settings edits.
        allow update: if isOwner(userId)
          && request.resource.data.get('birthYear', null)
             == resource.data.get('birthYear', null)
          && request.resource.data.get('isMinor', null)
             == resource.data.get('isMinor', null);

        allow delete: if isOwner(userId);
      }

      // User's pantry ("skafferi") — owner-only
      match /pantry/{pantryItemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User's shopping category preferences (BUT-379)
      match /category_preferences/{prefId} {
        allow read, write: if isOwner(userId);
      }

      // User's list category display orders (BUT-379)
      match /list_category_orders/{orderId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ========================================
    // DELETION AUDIT LOGS - Server-only
    // ========================================

    // P3-06: Audit logs for account deletions — deny all client access
    match /deletion_audit_logs/{logId} {
      allow read, write: if false;
    }

    // BUT-1451: paid-LLM input/output samples (scrubbed, TTL'd via expireAt)
    // captured by Cloud Functions for parser/prompt mining. Admin-SDK writes
    // only; deny ALL client access (incl. admin client) given the content
    // sensitivity — a future mining surface would relax read to isAdmin() with
    // DPO sign-off, not before.
    match /llm_response_samples/{sampleId} {
      allow read, write: if false;
    }

    // ========================================
    // PUBLIC PROFILES - Readable by all authenticated users
    // ========================================
    
    match /public_profiles/{userId} {
      // Anyone authenticated can read profiles for user search functionality
      allow read: if isAuthenticated();

      // Only profile owner can write — reject sensitive fields
      allow create: if isOwner(userId)
        && hasRequiredFields(['displayName', 'email'])
        && request.resource.data.isSearchable is bool
        // BUT-1626: a minor may not create a searchable public profile. The
        // legitimate minor opt-in (deferred) writes via a trusted Cloud
        // Function (admin SDK bypasses rules); every CLIENT create that sets
        // isSearchable:true for a minor is denied here.
        && (request.resource.data.isSearchable != true
          || !accountIsMinor(userId))
        && !request.resource.data.keys().hasAny([
          'fcmToken', 'fcmTokenUpdatedAt', 'notificationsEnabled',
          'allergenPreferences', 'hasCompletedOnboarding', 'preferredLocale'
        ]);

      // BUG-011 fix: Allow friendsCount updates during bidirectional friend creation
      // Owner can update anything, OR authenticated users can update ONLY friendsCount.
      // S2 note: Friendship document verification is not added here because
      // addMutualFriends() creates the friend document and updates the count
      // in the same transaction — rules see pre-transaction state, so the
      // friend doc doesn't exist yet when the count update is evaluated.
      // The ±1 constraint and rate limiting mitigate abuse.
      allow update: if (isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'fcmToken', 'fcmTokenUpdatedAt', 'notificationsEnabled',
          'allergenPreferences', 'hasCompletedOnboarding', 'preferredLocale',
          // Moderation-controlled fields — owner can read but never write,
          // so a hidden user cannot un-hide themselves.
          'isHidden', 'hiddenAt'
        ])
        // BUT-1626: block a client update that flips a minor's profile to
        // searchable. Gated on the DIFF (only when isSearchable is being SET to
        // true), so a minor with a legacy true value can still edit their name /
        // avatar, and a normal minor save (isSearchable:false) still corrects it.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSearchable'])
          || request.resource.data.isSearchable != true
          || !accountIsMinor(userId))
      ) || (
        isAuthenticated() &&
        // Only friendsCount field is being changed
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendsCount']) &&
        // friendsCount change is exactly +1 or -1 (adding or removing friend)
        (request.resource.data.friendsCount == resource.data.get('friendsCount', 0) + 1 ||
         request.resource.data.friendsCount == resource.data.get('friendsCount', 0) - 1) &&
        // Rate limit: max one friendsCount update per 5 seconds
        rateLimitWrite('friendsCount', 5)
      );
      allow delete: if isOwner(userId);

      // Hard delete is intentionally NOT granted — hide is reversible;
      // delete would orphan the auth account and break friendships/groups.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isHidden', 'hiddenAt'])
        && request.resource.data.isHidden is bool;
    }

    // ========================================
    // SOCIAL REQUESTS - Friend requests + group invitations (unified)
    // ========================================

    match /social_requests/{requestId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );

      // BUT-659: gate friend-requests + group-invitations behind the
      // new-account cooldown. Spam vector is "register, blast, abandon"
      // — requiring email verification or 60min account age neutralizes
      // it without blocking organic users (verification is a one-tap path).
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.status == 'pending'
        && hasRequiredFields(['type', 'fromUserId', 'toUserId', 'status', 'sentAt'])
        && isNotBlockedBy(request.resource.data.toUserId)
        && isAccountMatured()
        && isAgeCompliant()
        && rateLimitWrite('social_requests', 10);

      // Recipient can accept/reject/expire
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.toUserId
        && request.resource.data.status in ['accepted', 'rejected', 'expired']
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'respondedAt', 'expiredAt']);

      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
    }
    
    // ========================================
    // SHARED CONTENT - Unified collection for shared recipes, menus, shopping lists
    // Each document has a 'contentType' field: 'recipe' | 'menu' | 'shopping_list'
    // ========================================

    match /shared_content/{contentId} {
      // List is permitted to the sharer OR a recipient. The recipient branch
      // is required because the group shared-content query filters by
      // `sharedToUserIds arrayContainsAny [...]` (recipients reading what was
      // shared with them) — without it the entire query is permission-denied
      // for every recipient (the normal case) and silently returns empty.
      // The rules engine evaluates this per candidate document, so a recipient
      // can only list documents whose sharedToUserIds actually contains their
      // uid; it does not widen access to docs they were not shared into.
      allow list: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId
        || request.auth.uid in resource.data.sharedToUserIds
      );
      allow get: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId
        || isSharedMember('shared_content', contentId)
        || request.auth.uid in resource.data.sharedToUserIds
      );
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.sharedByUserId
        && hasRequiredFields(['sharedByUserId', 'contentType', 'sharedAt'])
        && rateLimitWrite('shared_content', 10);
      allow update: if isAuthenticated()
        && cannotModify(['sharedByUserId', 'contentType', 'sharedAt'])
        && (request.auth.uid == resource.data.sharedByUserId
            || isSharedMember('shared_content', contentId));
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.sharedByUserId;

      match /members/{userId} {
        allow read: if isAuthenticated() && (
          userId == request.auth.uid || isSharedOwner('shared_content', contentId) || isSharedMember('shared_content', contentId)
        );
        allow create: if isAuthenticated()
          && isSharedOwner('shared_content', contentId)
          && hasRequiredFields(['userId', 'addedBy', 'addedAt']);
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId || isSharedOwner('shared_content', contentId)
        );
      }

      match /views/{userId} {
        allow read: if isAuthenticated() && hasSharedAccess('shared_content', contentId);
        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && hasRequiredFields(['userId', 'viewedAt']);
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }

      match /engagements/{userId} {
        allow read: if isAuthenticated() && hasSharedAccess('shared_content', contentId);
        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && hasRequiredFields(['userId', 'action', 'engagedAt']);
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }

      match /dismissals/{userId} {
        allow read: if isAuthenticated() && (isSharedOwner('shared_content', contentId) || request.auth.uid == userId);
        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && hasRequiredFields(['userId', 'timestamp']);
        allow delete: if isAuthenticated()
          && request.auth.uid == userId;
      }

      match /collaborators/{userId} {
        allow read: if isAuthenticated() && hasSharedAccess('shared_content', contentId);
        allow create: if isAuthenticated() && (
          isSharedOwner('shared_content', contentId) ||
          (request.auth.uid == userId && getDocData('shared_content', contentId).allowCollaboration == true)
        ) && hasRequiredFields(['userId', 'joinedAt']);
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId || isSharedOwner('shared_content', contentId)
        );
      }

      match /items/{itemId} {
        allow read: if isAuthenticated() && hasSharedAccess('shared_content', contentId);
        allow create: if isAuthenticated()
          && hasSharedAccess('shared_content', contentId)
          && hasRequiredFields(['id', 'name', 'amount', 'unit', 'category', 'bought'])
          && request.resource.data.id == itemId
          && request.resource.data.addedByUserId == request.auth.uid;
        // BUT-238: update covers claim/unclaim (assignedToUserId/DisplayName/At).
        // Authorization is hasSharedAccess — ANY member may edit a shared
        // (collaborative) list. The lastModifiedByUserId check is
        // attribution-only: it forces the writer to stamp their OWN uid; it
        // does NOT restrict who may write.
        allow update: if isAuthenticated()
          && hasSharedAccess('shared_content', contentId)
          && request.resource.data.lastModifiedByUserId == request.auth.uid;
        allow delete: if isAuthenticated() && hasSharedAccess('shared_content', contentId);
      }
    }

    // ========================================
    // MENUS - User's personal menus (Issue #014 aligned)
    // ========================================

    match /menus/{menuId} {
      // Owner OR recipient can read. Mirrors unified_shared_shopping_lists.
      // BUT-747: recipient access also unblocks the GDPR scrub
      // (recipient must be able to read+update to remove their own UID).
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.sharedByUserId
        || (resource.data.sharedToUserIds is list
            && request.auth.uid in resource.data.sharedToUserIds)
      );

      // Can create if you're the sharedByUserId
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.sharedByUserId
        && hasRequiredFields(['sharedByUserId', 'menuTitle', 'sharedAt']);

      // Owner: full update with the standard immutability guard.
      // Recipient (BUT-747): may ONLY shrink `sharedToUserIds` to remove
      // themselves. The in/!in pair ensures self was a member and is gone
      // after the write; `hasOnly([sharedToUserIds])` blocks other field
      // mutations. BUT-749 adds two further constraints to close a griefing
      // gap (recipient could previously boot OTHER recipients in the same
      // update): the new array must be a subset of the old (no additions),
      // and the only element removed must be auth.uid (no booting others).
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.sharedByUserId
          && cannotModify(['sharedByUserId', 'sharedAt']))
        || (resource.data.sharedToUserIds is list
          && request.resource.data.sharedToUserIds is list
          && request.auth.uid in resource.data.sharedToUserIds
          && !(request.auth.uid in request.resource.data.sharedToUserIds)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['sharedToUserIds'])
          && request.resource.data.sharedToUserIds
              .removeAll(resource.data.sharedToUserIds).size() == 0
          && resource.data.sharedToUserIds
              .removeAll(request.resource.data.sharedToUserIds)
              .hasOnly([request.auth.uid]))
      );

      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.sharedByUserId;
    }

    // ========================================
    // WEEKLY MENU PLANS - Calendar view of veckomeny (BUT-211)
    // ========================================
    // Doc ID is `{userId}_{YYYY}-W{WW}` so ownership is encoded in the path.
    // Owner-only read/write — no sharing in Phase 1.

    match /weekly_menu_plans/{planId} {
      allow read: if isAuthenticated()
        && planId.matches('^' + request.auth.uid + '_.*');

      allow create: if isAuthenticated()
        && planId.matches('^' + request.auth.uid + '_.*')
        && request.auth.uid == request.resource.data.userId;

      allow update: if isAuthenticated()
        && planId.matches('^' + request.auth.uid + '_.*')
        && request.auth.uid == resource.data.userId
        && request.auth.uid == request.resource.data.userId
        && cannotModify(['userId', 'createdAt']);

      allow delete: if isAuthenticated()
        && planId.matches('^' + request.auth.uid + '_.*');
    }

    // ========================================
    // GROUP WEEKLY MENU PLANS - Collaborative weekly plans (BUT-405)
    // ========================================
    // Doc ID is `{groupId}_{YYYY}-W{WW}`. Access is gated by the denormalised
    // `participantUserIds` list + the nested `participants[].permission`
    // field (mirrors SharedListPermission: 'view' | 'edit' | 'admin').
    //
    // Helpers are inlined rather than declared at top-level because the
    // participant-permission lookup is specific to this collection's shape.

    match /group_weekly_menu_plans/{planId} {
      // Access is gated by the `memberPermissions` map: {uid: 'view'|'edit'|'admin'}.
      // Mirrors the `unified_shared_shopping_lists` model so rules can do
      // direct map-key lookups (Firestore rules language cannot filter
      // arrays of maps, so a denormalised permission map is the idiomatic
      // choice).

      // Any participant can read (any permission level).
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.memberPermissions;

      // Creator must (a) match the doc-ID prefix with their submitted
      // groupId, (b) include themselves in memberPermissions as edit/admin.
      allow create: if isAuthenticated()
        && planId.matches('^' + request.resource.data.groupId + '_.*')
        && request.auth.uid in request.resource.data.memberPermissions
        && request.resource.data.memberPermissions[request.auth.uid] in ['edit', 'admin']
        && hasRequiredFields([
             'groupId', 'participants', 'participantUserIds',
             'memberPermissions', 'entries', 'createdAt', 'lastModifiedAt'
           ]);

      // Editors + admins may update entries. Immutable fields: groupId,
      // createdAt. Participants/permissions changes require admin.
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.memberPermissions
        && resource.data.memberPermissions[request.auth.uid] in ['edit', 'admin']
        && cannotModify(['groupId', 'createdAt'])
        && (
          // Either the participant list/permissions are unchanged…
          (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['participants', 'participantUserIds', 'memberPermissions']))
          // …or the writer is an admin (can manage membership).
          || resource.data.memberPermissions[request.auth.uid] == 'admin'
        );

      // Admin-only delete.
      allow delete: if isAuthenticated()
        && request.auth.uid in resource.data.memberPermissions
        && resource.data.memberPermissions[request.auth.uid] == 'admin';
    }

    // ========================================
    // FAMILY RATING — shared household, diner profiles, family ratings
    // ========================================
    // The household is the symmetric shared identity; diner profiles and family
    // ratings are scoped to it by householdId. Access reads the denormalised
    // memberUserIds/memberPermissions, so both are kept consistent on write.

    match /households/{householdId} {
      // Any member reads; only an admin writes/deletes.
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.memberUserIds;

      // Creator seeds themselves as admin; projections must agree with the set
      // of members (rules trust the projections for every membership lookup).
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.createdBy
        && request.auth.uid in request.resource.data.memberUserIds
        && request.resource.data.memberPermissions[request.auth.uid] == 'admin'
        && request.resource.data.memberUserIds.toSet()
             == request.resource.data.memberPermissions.keys().toSet()
        && hasRequiredFields(['name', 'members', 'memberUserIds',
             'memberPermissions', 'createdBy', 'createdAt', 'updatedAt']);

      // Admin-only update; createdBy/createdAt immutable; projections stay consistent.
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.memberUserIds
        && resource.data.memberPermissions[request.auth.uid] == 'admin'
        && cannotModify(['createdBy', 'createdAt'])
        && request.resource.data.memberUserIds.toSet()
             == request.resource.data.memberPermissions.keys().toSet();

      // Admin-only delete.
      allow delete: if isAuthenticated()
        && request.auth.uid in resource.data.memberUserIds
        && resource.data.memberPermissions[request.auth.uid] == 'admin';
    }

    match /diner_profiles/{profileId} {
      // Any household member may read/create/update/delete profiles in their
      // household. The consent invariant is replicated server-side, and
      // householdId is immutable (no re-parenting a child's profile).
      allow read: if isHouseholdMember(resource.data.householdId);

      allow create: if isHouseholdMember(request.resource.data.householdId)
        && hasRequiredFields(['householdId', 'name', 'ageBand',
             'createdBy', 'createdAt', 'updatedAt'])
        && dinerConsentValid(request.resource.data);

      allow update: if isHouseholdMember(resource.data.householdId)
        && cannotModify(['householdId', 'createdBy', 'createdAt'])
        && dinerConsentValid(request.resource.data);

      allow delete: if isHouseholdMember(resource.data.householdId);
    }

    match /family_ratings/{ratingId} {
      // Household members read/write. Stars 1-5 enforced server-side (the real
      // backstop for the createBatch path); recipeId/memberId/householdId/
      // createdAt immutable; enteredByUid pinned to the writer on create.
      allow read: if isHouseholdMember(resource.data.householdId);

      allow create: if isHouseholdMember(request.resource.data.householdId)
        && hasRequiredFields(['recipeId', 'householdId', 'memberId', 'memberType',
             'stars', 'enteredByUid', 'createdAt', 'lastUpdatedAt'])
        && familyStarsValid(request.resource.data.stars)
        && request.resource.data.enteredByUid == request.auth.uid;

      allow update: if isHouseholdMember(resource.data.householdId)
        && cannotModify(['recipeId', 'memberId', 'householdId', 'createdAt'])
        && familyStarsValid(request.resource.data.stars);

      allow delete: if isHouseholdMember(resource.data.householdId);
    }

    // ========================================
    // REALTIME RECIPES - Collaborative editing
    // ========================================
    
    match /realtime_recipes/{recipeId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.participantIds);

      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.participantIds
        && hasRequiredFields(['ownerId', 'participants', 'participantIds', 'recipe', 'createdAt']);

      allow update: if isAuthenticated()
        && (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.participantIds)
        && cannotModify(['ownerId', 'createdAt']);

      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.ownerId;

      match /presence/{userId} {
        allow read: if isAuthenticated() && isRealtimeParticipant('realtime_recipes', recipeId);
        allow write: if isAuthenticated()
          && request.auth.uid == userId
          && isRealtimeParticipant('realtime_recipes', recipeId);
      }
    }

    // ========================================
    // REALTIME MENUS - Collaborative menu editing
    // ========================================

    match /realtime_menus/{menuId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.participantIds);

      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.participantIds
        && hasRequiredFields(['ownerId', 'participants', 'participantIds', 'createdAt']);

      allow update: if isAuthenticated()
        && (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.participantIds)
        && cannotModify(['ownerId', 'createdAt']);

      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.ownerId;

      match /presence/{userId} {
        allow read: if isAuthenticated() && isRealtimeParticipant('realtime_menus', menuId);
        allow write: if isAuthenticated()
          && request.auth.uid == userId
          && isRealtimeParticipant('realtime_menus', menuId);
      }

      // BUT-773: explicit rule block for the votes subcollection. Firestore
      // does NOT inherit parent rules into subcollections — the absence of
      // this match block left the path on default-deny, which masks the
      // missing rule (clients silently failed) but also blocks the intended
      // collaborative-vote flow without an obvious reason.
      //
      // Doc-id == voter uid by convention. That keeps the per-user-one-vote
      // constraint enforceable at the rules layer (the rule rejects writes
      // where voteId != request.auth.uid), and means no extra `userId` field
      // is needed for spoof-prevention — though we still validate it on
      // update for defence in depth.
      match /votes/{voteId} {
        allow read: if isAuthenticated()
          && isRealtimeParticipant('realtime_menus', menuId);

        allow create: if isAuthenticated()
          && request.auth.uid == voteId
          && isRealtimeParticipant('realtime_menus', menuId);

        // Update: same uid as the doc id, AND the existing doc's `userId`
        // (if present) matches — defence-in-depth against legacy votes
        // written without the doc-id-as-uid convention. `cannotModify(['userId'])`
        // (BUT-781 review): keeps the field structurally immutable post-create
        // so a regression that loosened the userId match couldn't also let a
        // voter rewrite the field.
        allow update: if isAuthenticated()
          && request.auth.uid == voteId
          && (
            !('userId' in resource.data)
            || resource.data.userId == request.auth.uid
          )
          && cannotModify(['userId'])
          && isRealtimeParticipant('realtime_menus', menuId);

        allow delete: if isAuthenticated() && request.auth.uid == voteId;
      }
    }

    // ========================================
    // RECIPE PRESENCE - Real-time presence tracking for recipe viewing
    // ========================================
    // Note: This is separate from realtime_recipes/presence which is for collaborative editing.
    // This collection tracks ALL users viewing recipes (not just collaborative ones).
    
    match /recipePresence/{recipeId} {
      // S8: Restrict presence reads to users who have their own presence
      // entry (meaning they are currently viewing the recipe).
      // This prevents arbitrary users from surveilling who views which recipes.
      allow read: if isAuthenticated()
        && exists(/databases/$(database)/documents/recipePresence/$(recipeId)/activeUsers/$(request.auth.uid));

      match /activeUsers/{userId} {
        // Users can read active users only if they also have presence (collaborative awareness)
        allow read: if isAuthenticated()
          && (request.auth.uid == userId
            || exists(/databases/$(database)/documents/recipePresence/$(recipeId)/activeUsers/$(request.auth.uid)));

        // Users can write their own presence
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // ========================================
    // PINGS - Group-scoped nudges (BUT-407)
    // ========================================
    // Path: /pings/{groupId}/pings/{pingId}
    //
    // Rate-limit tradeoff: Firestore rules cannot efficiently run
    // count-over-window aggregations. The client enforces a strict 5/h cap by
    // querying `fromUserId` + `createdAt` in the last hour. The rule below
    // provides a burst guard (1 ping per 60s per user) via the existing
    // `rateLimitWrite` helper. A Cloud Function sweeper is tracked as a
    // follow-up to enforce the 5/h aggregate cap server-side and to purge
    // expired pings (see `kPingDefaultTtl` on the model).
    //
    // Group membership: pings live OUTSIDE the `users/{ownerId}/` tree so we
    // can't reuse the `users/{userId}/friend_categories/{categoryId}` rule.
    // Instead we lean on the collection-group rule for friend_categories and
    // require the group doc to exist with the writer in `friendUserIds` OR
    // as the owner. Rules do a single `get()` per create/update — acceptable
    // cost for write-rare ops.

    match /pings/{groupId}/pings/{pingId} {
      // Helper: is the requesting user a member of the group?
      // Reads the group's friend_category doc (owned by ownerId — stored in
      // `ownerId` field on the doc itself). Since groups are user-owned
      // collections, we need to scan — but the client always passes groupId
      // that matches a doc already visible via the collection-group rule,
      // so the get() cost is a single document read.
      //
      // NOTE: Because friend_categories live at
      // `users/{ownerId}/friend_categories/{categoryId}`, we cannot directly
      // look up by groupId alone. We therefore require the writer to include
      // their own uid either as the group owner (writes fail if they pass a
      // group they don't own AND aren't in) — in practice, client code
      // resolves membership via the collection-group read first.
      //
      // Defense: writer must match `request.resource.data.fromUserId`, and
      // we only allow create if the doc's `groupId` matches the path. The
      // client-side `categoriesList` check gates the actual semantic
      // "are you in this group" call; the rule catches impersonation and
      // cross-group writes via the fromUserId assertion.

      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId
            || resource.data.toUserId == null);

      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.groupId == groupId
        && hasRequiredFields([
             'groupId', 'fromUserId', 'type', 'createdAt', 'expiresAt',
             'acknowledged'
           ])
        && request.resource.data.acknowledged == false
        // Message length cap (mirrors client-side kPingMaxMessageLength).
        && (request.resource.data.get('message', '') == null
            || request.resource.data.get('message', '').size() <= 100)
        // Burst guard — hourly aggregate cap handled client-side + CF sweeper.
        && rateLimitWrite('pings', 60);

      // Updates: only the `acknowledged` flag may be flipped to true, and
      // only by the recipient (directed pings) or any group member
      // (broadcast pings). Since we can't cheaply verify group membership
      // in rules for broadcasts, we allow ack on broadcasts by any
      // authenticated user — the worst case is a peer acknowledging on
      // behalf of the group, which is acceptable (ack is idempotent + UI-only).
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['acknowledged'])
        && request.resource.data.acknowledged == true
        && (
          // Directed → only the recipient
          (resource.data.toUserId != null
           && request.auth.uid == resource.data.toUserId)
          // Broadcast → any authenticated user (see comment above)
          || resource.data.toUserId == null
        );

      // Delete: creator (self-cleanup) or the recipient of a directed ping.
      allow delete: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
    }

    // ========================================
    // SHOPPING PRESENCE - "Anna handlar nu" indicators (BUT-238)
    // ========================================
    // Per-list presence for collaborative shopping. Same pattern as recipePresence.

    match /shoppingPresence/{listId} {
      // Any member with their own presence entry can read the parent doc.
      allow read: if isAuthenticated()
        && exists(/databases/$(database)/documents/shoppingPresence/$(listId)/activeUsers/$(request.auth.uid));

      match /activeUsers/{userId} {
        // Peers can read each other's presence once they're active themselves.
        allow read: if isAuthenticated()
          && (request.auth.uid == userId
            || exists(/databases/$(database)/documents/shoppingPresence/$(listId)/activeUsers/$(request.auth.uid)));

        // Users can write their own presence document (30s TTL heartbeat).
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
    }
    // ========================================
    // RECIPE COMMENTS - Threaded comments
    // ========================================

    match /recipe_comments/{commentId} {
      // BUT-458: Read access is now restricted to the recipe owner, the
      // recipe's shared recipients, the comment author, and admins.
      // Possible because the comment doc carries denormalized
      // `recipeOwnerId` and `sharedWithUserIds` written at create time.
      //
      // Legacy comments (pre-BUT-458, no `recipeOwnerId` field) fall
      // through to author-only read — this is a deliberate, one-time
      // degradation; the backfill migration restores recipe-owner /
      // shared-recipient visibility once it runs. Admin moderation
      // override below covers reports flagged against legacy rows.
      allow read: if isAuthenticated() && (
        // Author can always read their own comment.
        request.auth.uid == resource.data.authorId
        // New comments: recipe owner gets read access.
        || ('recipeOwnerId' in resource.data
            && request.auth.uid == resource.data.recipeOwnerId)
        // New comments: shared recipients get read access.
        || ('sharedWithUserIds' in resource.data
            && request.auth.uid in resource.data.sharedWithUserIds)
      );

      // Moderation override: admins can read any comment for review.
      allow read: if isAdmin();

      // Can create if authenticated, not blocked by the recipe owner,
      // and within rate limit. The blocking gate (BUT-459) needs the
      // denormalized recipeOwnerId; if absent (legacy callers), we
      // fall back to skipping the gate — but the create rule still
      // requires the author to be the auth uid and the rate limit to
      // hold, so spam vectors stay closed.
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.authorId
        && isAgeCompliant()
        // BUT-1419: maturity-gated, matching messages/social_requests. Comments
        // are public-facing UGC and an identical spam vector to DMs — a fresh
        // "register → blast → abandon" bot was blocked from DMs/friend-requests
        // but could still post comments (subject only to the 5s rate limit).
        && isAccountMatured()
        && hasRequiredFields(['authorId', 'recipeId', 'text', 'createdAt'])
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && isServerTimestamp('createdAt')
        // BUT-1049: comments may carry attached image URLs. When present the
        // field must be a list of at most 3 strings (Storage write rules gate
        // who can produce these URLs; this just bounds the denormalised list).
        && (
          !('imageUrls' in request.resource.data)
          || (request.resource.data.imageUrls is list
              && request.resource.data.imageUrls.size() <= 3)
        )
        && (
          !('recipeOwnerId' in request.resource.data)
          || isNotBlockedBy(request.resource.data.recipeOwnerId)
        )
        && rateLimitWrite('comments', 5);

      // Can update only your own comments — immutable fields protected
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.authorId
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'updatedAt', 'editedAt']);

      // Any authenticated user can update counters (likes, replies) (BUT-381)
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['replyCount', 'likesCount']);

      // Can delete only your own comments
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.authorId;

      // Moderation override: admins may delete any reported comment.
      allow delete: if isAdmin();

      // Comment likes — users can like/unlike comments
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['userId', 'likedAt']);
        allow delete: if isAuthenticated() && request.auth.uid == userId;
        allow update: if false;
      }
    }

    // Friends-only read: caller must be the snap-owner or in the snap-owner's
    // /users/{ownerId}/friends/ subcollection. Pair queries with a
    // userId-in-[self+friends] whereIn — rules eval per-doc, so any stranger
    // snap in a result set fails the entire query.
    //
    // BUT-1214: a snap marked visibility == 'onlyMe' is author-only — friends
    // are denied. The friend branch requires STRICT equality on
    // 'sameAsRecipe': any back-compat shape (`!('visibility' in data)` or
    // `get('visibility', default)`) is a proven privacy leak — at query time
    // the engine evaluates an unconstrained field as absent, which satisfies
    // the permissive clause and ALLOWS the old unconstrained query shape to
    // return onlyMe docs (rules are not filters). Verified on the emulator
    // 2026-06-10. Consequence: legacy docs (field missing) are
    // friend-unreadable until the backfill runs — so
    // functions/scripts/backfill-cook-snap-visibility.js MUST run BEFORE
    // this rules version is deployed.
    match /cook_snaps/{snapId} {
      // Read: snap-owner OR (friend-of-snap-owner AND visibility is
      // explicitly sameAsRecipe). Admin override below.
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId
        || (
          exists(/databases/$(database)/documents/users/$(resource.data.userId)/friends/$(request.auth.uid))
          && resource.data.visibility == 'sameAsRecipe'
        )
      );

      // Create: caller must be the snap-owner. Structural validation prevents
      // oversized documents and forged identity.
      // BUT-1418: age-gated. A cook-snap broadcasts a photo + caption to the
      // owner's friends — self-authored UGC published to other users, the exact
      // category ADR-0002 gates. Kept consistent with recipe_comments/messages.
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        && isAgeCompliant()
        && hasRequiredFields(['recipeId', 'userId', 'userDisplayName', 'photoUrl', 'createdAt'])
        && request.resource.data.recipeId is string
        && request.resource.data.userId is string
        && request.resource.data.userDisplayName is string
        && request.resource.data.userDisplayName.size() <= 100
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 1000
        && (
          !('caption' in request.resource.data)
          || request.resource.data.caption == null
          || (request.resource.data.caption is string
              && request.resource.data.caption.size() <= 200)
        )
        && isValidSnapVisibility()
        && rateLimitWrite('cook_snaps', 5);

      // Update: only the snap-owner. Identity fields are immutable.
      // Visibility IS mutable (owner may retro-hide or re-share a snap).
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.userId
        && cannotModify(['recipeId', 'userId', 'createdAt'])
        && isValidSnapVisibility();

      // BUT-1214: a forged visibility value (neither enum member) would be
      // readable via get but invisible to the friends query — reject it.
      function isValidSnapVisibility() {
        return !('visibility' in request.resource.data)
          || request.resource.data.visibility in ['sameAsRecipe', 'onlyMe'];
      }

      // Delete: only the snap-owner.
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.userId;

      // Moderation override: admins may read + delete any reported snap.
      // Read needed for moderator preview before takedown.
      allow read, delete: if isAdmin();
    }

    // ========================================
    // RECIPE COOK EVENTS - per-user append-only cook log (BUT-838)
    // ========================================
    // One doc per "mark as cooked": {recipeId, cookedAt}. Written in the
    // same WriteBatch as the recipe's core.cookCount bump. The read rule
    // depends only on the {userId} path segment, so the client's
    // countSince aggregate (`where cookedAt >= since` + count()) is
    // provable for the owner without per-doc data access. Events are
    // immutable (no update); delete stays owner-only. The server-side
    // GDPR cascade uses the Admin SDK and bypasses these rules.
    match /recipe_cook_events/{userId}/events/{eventId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;

      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && hasRequiredFields(['recipeId', 'cookedAt'])
        && request.resource.data.keys().hasOnly(['recipeId', 'cookedAt', 'attendeeMemberIds'])
        && request.resource.data.recipeId is string
        && request.resource.data.recipeId.size() > 0
        && request.resource.data.recipeId.size() <= 200
        && request.resource.data.cookedAt is timestamp
        // attendeeMemberIds optional (who's-eating pick); when present it must be
        // a bounded list — a household roster is small, the cap blocks abuse.
        && (!('attendeeMemberIds' in request.resource.data)
            || (request.resource.data.attendeeMemberIds is list
                && request.resource.data.attendeeMemberIds.size() <= 50));

      allow update: if false;

      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // ========================================
    // ACTIVITY EVENTS - Social activity feed (BUT-1294)
    // ========================================
    // Top-level collection: one doc per social event {actorId, type, recipeId,
    // recipeTitle, createdAt, ...}. The feed query is a batched
    // `where('actorId', whereIn: [self + friendIds])` + orderBy createdAt
    // (see FirebaseActivityEventRepository.fetchFriendActivity), so the read
    // rule must allow a doc when the requester is the actor OR a friend of the
    // actor. Friendship is the snap-owner pattern: a friend doc exists at
    // users/{actorId}/friends/{request.auth.uid} (mirrors cook_snaps).
    //
    // Until this block existed the collection sat on Firestore default-deny —
    // every feed read AND every "mark as cooked"/shared write was silently
    // rejected in production, so the activity feed could not function.
    match /activity_events/{eventId} {
      // Read: the actor themselves, OR a friend of the actor. Pair queries
      // with a `whereIn` over [self + friends] — rules evaluate per candidate
      // doc, so a stranger's event in a result set fails the whole query.
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.actorId
        || exists(/databases/$(database)/documents/users/$(resource.data.actorId)/friends/$(request.auth.uid))
      );

      // Create: only the actor may write their own event. Structural
      // validation prevents identity forgery and oversized documents.
      // BUT-1418: age-gated. Activity events publish self-authored social-feed
      // items to the actor's friends — same UGC-broadcast category as cook_snaps
      // and comments, so the ADR-0002 age gate applies here too.
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.actorId
        && isAgeCompliant()
        && hasRequiredFields(['actorId', 'type', 'recipeId', 'createdAt'])
        && request.resource.data.actorId is string
        && request.resource.data.type is string
        && request.resource.data.recipeId is string
        && request.resource.data.recipeId.size() <= 200
        && (
          !('recipeTitle' in request.resource.data)
          || (request.resource.data.recipeTitle is string
              && request.resource.data.recipeTitle.size() <= 300)
        )
        && rateLimitWrite('activity_events', 2);

      // Update: only the actor, and the identity/anchor fields are immutable.
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.actorId
        && cannotModify(['actorId', 'recipeId', 'createdAt']);

      // Delete: only the actor (also the GDPR self-cascade path; the
      // server-side Admin SDK cascade bypasses these rules).
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.actorId;
    }

    // ========================================
    // BUTLERY ARCHIVE - Read-only community recipes
    // ========================================

    match /butlery_archive/{recipeId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    // NOTE: /menus/ rules are defined earlier in this file (line ~315)
    // Duplicate rule block removed to prevent override conflicts

    // ========================================
    // CONVERSATIONS - User messaging
    // ========================================

    match /conversations/{conversationId} {
      // Can read if you're a participant
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;

      // Can create if you're adding yourself as a participant.
      // BUT-674: for a 1:1 conversation (participantIds.size() == 2), if the
      // OTHER participant is a minor (users/{other}.isMinor == true, written
      // server-side by verifySignupAge), the creator must already be their
      // friend. This is the chokepoint for 1:1 DMs — participantIds is set at
      // create and immutable after, so message access is decided here.
      //
      // GROUP conversations (size > 2) are intentionally NOT gated here:
      // Firestore rules cannot iterate the participant list to find the minor.
      // Group minor-protection is instead provided by the default-private
      // profile (a non-friend can't discover the minor to add them) plus the
      // enforceGroupMinorMembership Cloud Function (BUT-1626), which removes a
      // minor added to a group by a non-friend. That CF trusts
      // metadata.creatorId as the "who added them" identity, so the create rule
      // below binds it to the caller. The get() cost is bounded:
      // otherIsMinor()/creatorIsFriendOf() only fire on a 1:1 create.
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participantIds
        && hasRequiredFields(['participantIds', 'createdAt'])
        && passesMinorDmGate(request.resource.data.participantIds)
        // BUT-1626: bind the recorded creator to the caller so the group
        // minor-safety CF can trust metadata.creatorId. Without this a tampered
        // client could add a non-friend minor to a group and set creatorId to
        // the minor's own uid (hitting the uid===creatorId skip) or to any
        // friend of the minor, defeating the friend check. A conversation that
        // records no creator stays safe — the CF fails closed and removes the
        // minor when creatorId is absent.
        && (
          !('metadata' in request.resource.data)
          || !('creatorId' in request.resource.data.metadata)
          || request.resource.data.metadata.creatorId == request.auth.uid
        )
        && rateLimitWrite('conversations', 10);

      // Can update if you're a participant (but cannot modify participantIds or createdAt)
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participantIds
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['participantIds', 'createdAt']);

      // Can delete if you're a participant
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.participantIds;

      // Per-user settings subcollection (archive, pin, etc.)
      match /userSettings/{settingsUserId} {
        allow read, write: if isAuthenticated()
          && request.auth.uid == settingsUserId
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }

    // ========================================
    // MESSAGES - Top-level messages collection (used by repository)
    // ========================================

    match /messages/{messageId} {
      // Can read messages if authenticated AND you're a participant in the conversation
      allow read: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds;

      // Can create messages if you're the sender, within rate limit.
      // BUT-659: also gate behind the new-account cooldown — DMs are a
      // primary spam vector and per-user 5/min rate limit alone doesn't
      // stop a freshly-registered bot from blasting 50 unrelated users.
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.senderId
        && hasRequiredFields(['senderId', 'conversationId', 'content', 'sentAt'])
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 5000
        && isAccountMatured()
        && isAgeCompliant()
        && rateLimitWrite('messages', 5);

      // Can update your own messages (content only — identity fields are immutable)
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.senderId
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 5000
        && cannotModify(['senderId', 'conversationId', 'sentAt']);

      // Can delete your own messages
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.senderId;

      // Moderation override: admins may read + delete any reported message.
      // Read needed for moderator preview — base read rule restricts to
      // conversation participants, which excludes admins by default.
      allow read, delete: if isAdmin();
    }
    
    // ========================================
    // CONNECTIVITY TEST - App initialization
    // ========================================
    
    match /connectivity_test/{document} {
      // Anyone authenticated can read connectivity test documents
      allow read: if isAuthenticated();
      // No writing allowed - this is just for testing connectivity
      allow write: if false;
    }
    
    
    // ========================================
    // UNIFIED SHARED SHOPPING LISTS - Collaborative shopping
    // ========================================
    
    match /unified_shared_shopping_lists/{listId} {
      // Can read if you're the owner or a member (key in memberPermissions map)
      // BUT-238: read access implicitly covers assignedToUserId/assignedToDisplayName/assignedAt
      // since items are embedded in the list doc.
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.memberPermissions
      );

      // Can create if you're the owner
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.memberPermissions
        && hasRequiredFields(['ownerId', 'memberPermissions', 'items', 'createdAt']);

      // Can update if you're a member with edit/admin permission (for real-time collaboration).
      // BUT-238: claim/unclaim (assignedToUserId/assignedToDisplayName/assignedAt fields on items[])
      // is just an item-array mutation — allowed for edit/admin. View-only members cannot write.
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerId ||
        (request.auth.uid in resource.data.memberPermissions
         && resource.data.memberPermissions[request.auth.uid] in ['edit', 'admin']
         && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ownerId', 'memberPermissions', 'createdAt']))
      );

      // Can delete if you're the owner
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.ownerId;
    }

    // ========================================
    // SHOPPING LIST TEMPLATES - Reusable shopping list patterns
    // ========================================
    
    match /shopping_list_templates/{templateId} {
      // Public templates can be read by anyone
      // Private templates can only be read by the owner
      allow read: if isAuthenticated() && (
        resource.data.isPublic == true ||
        request.auth.uid == resource.data.ownerId
      );

      // Can create if authenticated and setting yourself as owner
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.ownerId
        && hasRequiredFields(['ownerId', 'name', 'items', 'isPublic', 'createdAt']);

      // Can update if you're the owner
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.ownerId;

      // Can delete if you're the owner
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.ownerId;
    }
    
    // ========================================
    // USER SHARED SHOPPING LISTS - Tracking received lists
    // ========================================

    match /user_shared_shopping_lists/{userId}/received_lists/{listId} {
      allow read, delete: if isOwner(userId);
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.sharedByUserId
        && hasRequiredFields(['sharedByUserId', 'listId', 'sharedAt'])
        && rateLimitWrite('received_list', 10);
      allow update: if isOwner(userId);
    }

    // ========================================
    // USER SHARED MENUS - Subcollection tracking
    // ========================================

    match /user_shared_menus/{userId}/received_menus/{menuId} {
      allow read, delete: if isOwner(userId);
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.sharedByUserId
        && hasRequiredFields(['sharedByUserId', 'menuId', 'sharedAt'])
        && rateLimitWrite('received_menu', 10);
      allow update: if isOwner(userId);
    }

    // ========================================
    // PRESENCE - Online status and typing indicators
    // ========================================

    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && request.auth.uid == userId
        && rateLimitWrite('presence', 30);
    }

    // ========================================
    // BLOCKS - User block relationships (composite-key: {blockerId}_{blockedId})
    // ========================================

    match /blocks/{blockId} {
      // Users can read blocks they are involved in (either direction)
      allow read: if isAuthenticated() && (
        resource.data.blockerId == request.auth.uid ||
        resource.data.blockedId == request.auth.uid
      );

      // Only the blocker can create a block, and must be the blockerId
      allow create: if isAuthenticated()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockerId != request.resource.data.blockedId
        && blockId == request.resource.data.blockerId + '_' + request.resource.data.blockedId;

      // Blocks are immutable — no updates
      allow update: if false;

      // Only the blocker can delete (unblock)
      allow delete: if isAuthenticated()
        && resource.data.blockerId == request.auth.uid;
    }

    // ========================================
    // RECIPE RATINGS - User ratings for recipes
    // ========================================

    match /recipe_ratings/{ratingId} {
      // Can read all ratings (public social feature)
      allow read: if isAuthenticated();

      // Can create if authenticated and rating as yourself.
      // Rating ID format: {recipeId}_{userId}
      // BUT-459: when the new optional `recipeOwnerId` field is present,
      // the rater must not be blocked by the recipe owner. Legacy
      // callers without the field skip the gate (rest of validation
      // still applies; rate limit + auth uid pinning prevent spam).
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        && isAgeCompliant()
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && hasRequiredFields(['recipeId', 'userId', 'rating', 'createdAt'])
        && isServerTimestamp('createdAt')
        && (
          !('recipeOwnerId' in request.resource.data)
          || isNotBlockedBy(request.resource.data.recipeOwnerId)
        )
        && rateLimitWrite('recipe_ratings', 5);

      // Can update only your own ratings. Pin identity/anchor fields so a
      // rating can't be re-pointed to another recipe/user or backdated
      // (the client only ever changes rating/review/updatedAt).
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.userId
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && cannotModify(['recipeId', 'userId', 'createdAt']);

      // Can delete only your own ratings
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.userId;

      // Moderation override: admins may delete any reported rating.
      allow delete: if isAdmin();
    }

    // ========================================
    // USER NOTIFICATIONS - Push notifications
    // ========================================

    match /user_notifications/{notificationId} {
      // Can read only your own notifications
      allow read: if isAuthenticated()
        && request.auth.uid == resource.data.userId;

      // Users can create notifications if:
      // - Sending to themselves (system notifications), OR
      // - They are friends with the recipient AND not blocked by them (BUT-459)
      // This prevents notification spam attacks — blocking has to gate
      // notification creation OR a blocked user can pierce the block via
      // notifications that the blocker still sees.
      allow create: if isAuthenticated()
        && hasRequiredFields(["userId", "senderId", "type", "title", "body", "createdAt"])
        && isServerTimestamp('createdAt')
        && request.resource.data.senderId == request.auth.uid
        && (
          // Allow self-notification (system events) — never blocked.
          request.resource.data.userId == request.auth.uid ||
          // Or sender and recipient are friends AND not blocked.
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(request.resource.data.userId))
            && isNotBlockedBy(request.resource.data.userId)
          )
        );

      // Can update only your own notifications (mark as read)
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.userId;

      // Can delete only your own notifications
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.userId;
    }

    // ========================================
    // FCM TOKENS - Firebase Cloud Messaging tokens
    // ========================================

    match /user_fcm_tokens/{tokenDocId} {
      // Per-device document model: doc ID is {userId}_{deviceId}
      // The userId field inside the document must match the authenticated user

      // Can read only your own token documents
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // Can create/update only your own token documents
      allow create, update: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // Can delete only your own token documents (GDPR Art. 17 — needed by
      // the account-deletion cascade). The previous `allow write` clause
      // also covered delete in name, but its predicate referenced
      // `request.resource.data` which is null on delete — silently rejected
      // every delete. BUT-498.
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // ========================================
    // NOTIFICATION PREFERENCES - User notification settings
    // ========================================

    match /user_notification_preferences/{userId} {
      // Can read only your own preferences
      allow read: if isAuthenticated()
        && request.auth.uid == userId;

      // Can write only your own preferences
      allow write: if isAuthenticated()
        && request.auth.uid == userId;
    }

    // ========================================
    // AUDIT LOGS - GDPR Article 30 compliance
    // ========================================

    match /audit_logs/{logId} {
      // BUT-424: Audit logs are admin-only readable from the client.
      // Allowing users to read their own audit trail defeats the
      // tamper-detection purpose (a compromised account could enumerate
      // exactly which operations were observed and craft attacks around
      // gaps). The repository docstring says so explicitly:
      // "Users CANNOT read their own audit logs (prevents tampering
      //  detection). Only admins can read audit logs (via backend tools)."
      // GDPR Article 15 (Right of Access) is satisfied via a server-side
      // export Cloud Function that uses the Admin SDK to bypass these
      // rules — see follow-up: /functions/src/exports/audit-logs.ts (TBD).
      allow read: if isAdmin();

      // Client-side fire-and-forget creates remain allowed: users can
      // log their own permission checks, but they can't read them back.
      // SECURITY: User can only create audit logs for themselves (prevents tampering).
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        && hasRequiredFields(['userId', 'operation', 'resourceType', 'timestamp'])
        && rateLimitWrite('audit_logs', 2);

      // No updates or deletes allowed (immutable audit trail)
      allow update, delete: if false;
    }

    // ========================================
    // BUT-627 audit ledger (admin-only) — defence-in-depth deny.
    // Top-level `audit/{category}/entries/{auto}` rows are written by Cloud
    // Functions via admin SDK (e.g. ping rate-limit violations). No client
    // path should reach them; the admin SDK bypasses rules anyway. Explicit
    // deny ensures a future wildcard rule cannot accidentally widen access.
    // ========================================
    match /audit/{document=**} {
      allow read, write: if false;
    }

    // ========================================
    // BUT-482 internal scratch space (admin-only) — defence-in-depth deny.
    // `_internal/rating_debounce/markers/{recipeId}` is written by the
    // rating-aggregation debounce path. Functions-only collection.
    // ========================================
    match /_internal/{document=**} {
      allow read, write: if false;
    }

    // ========================================
    // USER CONSENT - GDPR Article 7 compliance
    // ========================================

    match /users/{userId}/consent/{consentDoc} {
      // Users can read only their own consent records
      allow read: if isAuthenticated()
        && request.auth.uid == userId;

      allow create, update: if isAuthenticated()
        && request.auth.uid == userId
        && hasRequiredFields(['consentVersion', 'purposes', 'grantedAt']);
      allow delete: if isAuthenticated()
        && request.auth.uid == userId;
    }

    // ========================================
    // ACQUISITION ATTRIBUTION (BUT-612)
    // First-write-wins UTM data mirroring `campaign_click` events for
    // server-side cohort/retention analysis. Owner reads + creates only;
    // updates are blocked so original-source attribution is immutable.
    // Deletes go through admin tooling, not the client.
    // ========================================
    match /users/{userId}/acquisition/{acquisitionDoc} {
      allow read: if isAuthenticated()
        && request.auth.uid == userId;

      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && hasRequiredFields(['source', 'medium', 'campaign', 'firstSeenAt'])
        && request.resource.data.firstSeenAt == request.time;

      // First-write-wins: clients cannot modify or delete acquisition data
      // once written. Admin/server flows handle erasure (GDPR Art. 17).
      allow update: if false;
      allow delete: if false;
    }

    // ========================================
    // ONBOARDING PROGRESS (BUT-675)
    // Resume-onboarding state: which step the user finished, when, and
    // whether onboarding has been completed. Owner-only read/write.
    // Doc shape: { step: string, completedAt: timestamp, completed: bool }
    // ========================================
    match /users/{userId}/onboarding/{progressDoc} {
      allow read, write: if isAuthenticated()
        && request.auth.uid == userId;
    }

    // ========================================
    // REPORT THROTTLE (BUT-781)
    // Per-(reporter, contentOwner) sentinel doc that powers the brigade
    // rate-limit on /reports. The reporter writes one of these alongside
    // each report (in a single batch) so the next /reports create-rule
    // evaluation sees the fresh `lastReportAt` and denies a follow-up
    // report against the same owner inside the 24h window.
    //
    // Doc id is the contentOwnerId being reported. Self-report attempts
    // (doc id == reporter uid) are blocked at the rules layer too — even
    // if a buggy client tried to write one, /reports would still reject
    // the parent report on the contentOwnerId != reporter check.
    // ========================================
    match /users/{userId}/report_throttle/{ownerId} {
      // Owner reads their own throttle (used by the client to know if a
      // re-report is allowed without round-tripping through a denied
      // create attempt).
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Owner writes the throttle alongside each /reports create.
      // `ownerId == request.auth.uid` would be a self-report — the parent
      // /reports rule blocks it independently, but rejecting here keeps
      // the throttle collection clean (no orphan self-throttle docs).
      allow create, update: if isAuthenticated()
        && request.auth.uid == userId
        && ownerId != request.auth.uid
        && hasRequiredFields(['lastReportAt'])
        && request.resource.data.lastReportAt == request.time;

      // Throttle docs are append/update-only from the client; deletion is
      // admin-driven (e.g. report-retention sweeps). Deny client deletes.
      allow delete: if false;
    }

    // ========================================
    // CANONICAL RATING EVENTS (pooled ratings "Butlery-betyget", decision 10)
    // ========================================
    // One frozen pool event per pool the user has voted in, written ONLY by the
    // Stage-A mirror Cloud Function (Admin SDK bypasses these rules). The owner
    // may READ their own events (GDPR export + any future "my contributions" UI);
    // ALL client writes are denied — the poolKey and ratingValue are
    // server-authoritative (a client write could poison a pool or forge a vote).
    // The doc-ID is the poolKey. This is pseudonymous data (uid + reproducible
    // hash), covered by the deletion cascade + export (Increment 5).
    match /users/{userId}/canonical_rating_events/{poolKey} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update, delete: if false;  // CF-only via Admin SDK
    }

    // ========================================
    // MENU TEMPLATES - Reusable menu templates
    // ========================================

    match /menu_templates/{templateId} {
      // Can read public templates and your own templates
      allow read: if isAuthenticated() && (
        resource.data.get('isPublic', false) == true ||
        request.auth.uid == resource.data.ownerId
      );

      // Can create if authenticated and creating as yourself
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.ownerId
        && hasRequiredFields(['templateName', 'ownerId', 'menuSnapshot', 'createdAt']);

      // Can update only your own templates
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.ownerId;

      // Can delete only your own templates
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.ownerId;
    }

    // ========================================
    // GLOBAL RECIPE CACHE - Cross-user recipe deduplication
    // ========================================

    match /globalRecipeCache/{docId} {
      // Any authenticated user can read cache entries
      allow read: if isAuthenticated();

      // Authenticated users can create cache entries with ownership and rate limit
      allow create: if isAuthenticated()
        && hasRequiredFields(['url', 'title', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && rateLimitWrite('globalRecipeCache', 30);

      // Updates allowed only for access statistics (accessCount, lastAccessedAt)
      // Prevents modification of cached recipe data
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['accessCount', 'lastAccessedAt'])
        && rateLimitWrite('globalRecipeCache_access', 10);

      // No deletes from client - cleanup handled by Cloud Functions
      allow delete: if false;
    }

    // ========================================
    // SITE CONFIGS - Dynamic parsing configurations
    // ========================================

    match /site_configs/{domain} {
      // Authenticated users can read site configs
      allow read: if isAuthenticated();

      // No client writes - admin only via console/server
      allow write: if false;
    }

    // ========================================
    // MENU LEXICON - Parser vocabulary overrides (BUT-370)
    // ========================================

    match /menu_lexicon/{category} {
      // Authenticated users can read lexicon overrides
      allow read: if isAuthenticated();

      // No client writes - admin only via console
      allow write: if false;
    }

    // ========================================
    // PARSING CORRECTIONS - Parser improvement analytics
    // ========================================

    match /parsing_corrections/{correctionId} {
      // Users can only read their own corrections (GDPR). Admins read across
      // all corrections to power the parsing-details admin dashboard.
      allow read: if (isAuthenticated()
        && request.auth.uid == resource.data.userId)
        || isAdmin();

      // Users can only create corrections for themselves
      // SECURITY: Prevents data poisoning attacks
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        && hasRequiredFields(['id', 'userId', 'source', 'timestamp']);

      // No updates allowed - corrections are immutable
      allow update: if false;

      // Users can delete their own corrections (GDPR Article 17)
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.userId;
    }

    // ========================================
    // TAG OVERRIDES LOG (BUT-1473) — allergen tag-override corrections
    // ========================================
    // Own-data, append-only capture of allergen verdict overrides feeding the
    // tagging learning loop. Same ownership + immutability contract as
    // parsing_corrections above (GDPR read/delete of own data; admins read all
    // for the learning-loop dashboard). Writes are the caller's OWN data
    // (userId == auth.uid), enforced here — the only thing that makes the
    // client's fire-and-forget TagOverridesLogRepository.save() land instead of
    // default-denying.
    match /tag_overrides_log/{entryId} {
      // Users read their own corrections (GDPR); admins read across all.
      allow read: if (isAuthenticated()
        && request.auth.uid == resource.data.userId)
        || isAdmin();

      // Users can only create corrections for themselves.
      // SECURITY: prevents cross-user data-poisoning of the learning loop.
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        && hasRequiredFields(['id', 'userId', 'recipeId', 'type', 'tag', 'direction', 'timestamp']);

      // Immutable — corrections are an append-only log.
      allow update: if false;

      // Users can delete their own corrections (GDPR Article 17). The account-
      // deletion cascade (deleteTagOverridesLog) also removes them server-side.
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.userId;
    }

    // ========================================
    // PARSE CORRECTIONS V2 (BUT-595) — server-write-only per-field log
    // ========================================
    // Per-field correction telemetry. Documents are written by the
    // `logParseCorrection` Cloud Function via the admin SDK only. Userids and
    // recipeIds arrive pre-hashed; raw IDs never land here. The collection is
    // append-only and not user-readable — analytics happens server-side.
    match /parse_corrections_v2/{correctionId} {
      allow read: if false;
      allow write: if false;
    }

    // ========================================
    // COLLECTION GROUP RULES (Issue #014: Unlimited Sharing)
    // Required for collectionGroup('members') queries
    // ========================================

    // ⚠️ SAFETY CONTRACT (BUT-463): Matches ALL `members/{id}` subcollections
    // across the database via collection-group. The rule depends on TWO
    // invariants that must hold for every existing AND future `members`
    // subcollection:
    //   (1) Each `members/{id}` doc carries a `userId` field that names the
    //       owning user (i.e. the row belongs to the user identified by
    //       `userId`, not to a foreign user the app is "tagging in").
    //   (2) The doc is created/updated only by trusted server code or by
    //       a NARROWER explicit rule on the parent path.
    // Today: only `shared_content/{}/members/{}` and similar shared-content
    // subcollections use this shape. `friend_categories` does NOT use a
    // `members` subcollection (membership is inline as `friendUserIds`).
    //
    // FAILURE MODE: if a future feature adds a `members/{id}` subcollection
    // that violates (1) — e.g. stores `userId: foreignUid` to model "users
    // this row references" rather than ownership — this collection-group
    // rule would unintentionally allow `foreignUid` to read/delete it.
    // Mitigation: any new `members` subcollection MUST add a stricter
    // explicit rule on its parent path BEFORE relying on this catch-all.
    // The rules unit test in `members-collection-group-rules.test.ts`
    // enforces this contract by attempting a foreign-userId fixture.
    match /{path=**}/members/{memberId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Users can read friend_categories they belong to across all users.
    // This enables: firestore.collectionGroup('friend_categories').where('friendUserIds', arrayContains: uid)
    match /{path=**}/friend_categories/{categoryId} {
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.friendUserIds;
    }

    // Users can read their OWN engagement documents across all collections
    // This enables: firestore.collectionGroup('engagements').where('userId', isEqualTo: currentUserId)
    // Applies to: shared_content/engagements (all content types)
    match /{path=**}/engagements/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
    }

    // Users can read/delete their OWN comments via collectionGroup (GDPR export + erasure).
    // NOTE: Matches ALL 'comments' subcollections.
    // If new 'comments' subcollections are added, review this rule.
    match /{path=**}/comments/{commentId} {
      allow read, delete: if isAuthenticated()
        && resource.data.commentedBy == request.auth.uid;
    }

    // Users can read/delete their OWN ratings via collectionGroup (GDPR export + erasure).
    // NOTE: Matches ALL 'ratings' subcollections.
    // If new 'ratings' subcollections are added, review this rule.
    match /{path=**}/ratings/{ratingId} {
      allow read, delete: if isAuthenticated()
        && resource.data.ratedBy == request.auth.uid;
    }

    // Admin dashboard counts recipes by import method via
    // collectionGroup('recipes'). The per-user nested rule
    // (users/{uid}/recipes) does NOT enable collection-group queries, so this
    // admin-only catch-all is required. Read-only; admins never write here.
    match /{path=**}/recipes/{recipeId} {
      allow read: if isAdmin();
    }

    // BUT-407: Users can read/delete their OWN pings via collectionGroup.
    // Enables GDPR erasure cascade in `SocialDeletionOperations.deletePingsByUser`
    // and lets recipients dismiss a directed ping without first resolving the
    // full path. The direct-match rules above still gate normal CRUD —
    // this entry intentionally only grants read + delete, not write.
    match /{path=**}/pings/{pingId} {
      allow read, delete: if isAuthenticated()
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);
    }

    // ========================================
    // CONTENT REPORTS - User-submitted reports
    // ========================================

    match /reports/{reportId} {
      // Users can read their own reports; admins can read all reports.
      allow read: if isAuthenticated() && (
        resource.data.reporterId == request.auth.uid
        || isAdmin()
      );

      // Authenticated users can create reports (must be reporting as themselves)
      // and the report must start in the 'new' state of the moderation machine.
      //
      // BUT-781: tightened against brigade abuse + analytics-polluting typos
      // + GDPR-erasure dangling owner refs. Four additional constraints over
      // the original create rule:
      //   1. `contentOwnerId` is required (was nullable). Without it the
      //      cascade in on-user-deleted.ts cannot find the report on the
      //      target user's deletion → GDPR Art. 17 gap.
      //   2. Self-report block (`contentOwnerId != reporter`). Some
      //      moderation pipelines treat self-reports as plausible evidence,
      //      so an attacker self-reporting to manufacture a paper trail is
      //      a real concern.
      //   3. `reason` enum constraint. The previous free-form string let
      //      typos pollute analytics (`'spamm'`, `'sapm'`) and made the
      //      admin-side dispatcher unreliable.
      //   4. Rate-limit per (reporter, contentOwner) at most one report per
      //      24h via the /users/{reporter}/report_throttle/{owner} sentinel.
      //      Client must write the throttle in the same batch as the report
      //      (rules can't write atomically); without the throttle, the limit
      //      doesn't engage but the per-create cost stays the same.
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'new'
        && hasRequiredFields(['reporterId', 'contentType', 'contentId', 'contentOwnerId', 'reason', 'status', 'createdAt'])
        && request.resource.data.contentOwnerId is string
        && request.resource.data.contentOwnerId != request.auth.uid
        && request.resource.data.reason in [
          'spam', 'abuse', 'harassment', 'csam',
          'copyright', 'misinformation', 'other'
        ]
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)/report_throttle/$(request.resource.data.contentOwnerId))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)/report_throttle/$(request.resource.data.contentOwnerId)).data.lastReportAt < request.time - duration.value(24, 'h')
        );

      // Admin-only, forward-only state machine:
      //   new -> in_review -> actioned -> closed
      // Reject backward transitions and mutations of immutable identity fields.
      allow update: if isAdmin()
        && cannotModify(['reporterId', 'contentType', 'contentId', 'createdAt'])
        && (
          (resource.data.status == 'new'
             && request.resource.data.status in ['new', 'in_review'])
          || (resource.data.status == 'in_review'
             && request.resource.data.status in ['in_review', 'actioned'])
          || (resource.data.status == 'actioned'
             && request.resource.data.status in ['actioned', 'closed'])
          || (resource.data.status == 'closed'
             && request.resource.data.status == 'closed')
        );

      allow delete: if isAdmin();
    }

    // ========================================
    // ADMINS - Moderator allow-list (seeded server-side only)
    // ========================================
    // Documents here simply mark a UID as an admin. The collection is
    // write-locked at the rules layer; entries are seeded via Firebase
    // Console / Admin SDK. Mirror-reads are restricted to admins themselves
    // to avoid leaking the moderator list to regular users.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ========================================
    // GLOBAL INGREDIENT DATABASE - Allergen/dietary lookup
    // ========================================

    // Admin-curated ingredient database used by the tagging system.
    // Authenticated users need read access for ingredient lookup during
    // tag generation. Write access restricted to admin (Cloud Functions).
    match /ingredients/{ingredientId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ========================================
    // INGREDIENT SUBSTITUTIONS - Read-only reference data
    // ========================================

    match /ingredient_substitutions/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ========================================
    // TAG CONFIGS - Admin-managed tagging configuration
    // ========================================

    // Read-only tag configuration documents (allergens, dietary, cuisine,
    // properties, display). Managed by admin via console/Cloud Functions.
    match /tag_configs/{doc} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ========================================
    // FEEDBACK - Beta user feedback submissions
    // ========================================

    match /feedback/{feedbackId} {
      // Users can submit their own feedback.
      // BUT-1407: constrain shape + size — an unconstrained create let a beta
      // user write a near-1MB description or a giant recentInteractions array,
      // inflating admin-dashboard read cost. The allowlist is exactly the keys
      // FeedbackEntry.toMap writes (the client always sends all 10, optional
      // ones as null). hasOnly permits a subset, so older minimal writes still
      // pass; it only blocks UNKNOWN extra fields.
      allow create: if isAuthenticated()
        && isCreatingOwnDocument()
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'category', 'description', 'email',
          'screenshotUrl', 'recentInteractions', 'createdAt',
          'deviceInfo', 'status',
        ])
        && hasRequiredFields(['userId', 'category', 'description', 'createdAt'])
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 5000
        && request.resource.data.recentInteractions is list
        && request.resource.data.recentInteractions.size() <= 50;
      // Admins read all feedback for the admin dashboard inbox
      allow read: if isAdmin();
      // Admins may only change the triage `status` field — never rewrite the
      // submission itself
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['status']);
      // Feedback is never deleted by clients
      allow delete: if false;
    }

    // ========================================
    // DEEP LINKS - Shareable recipe/content links
    // ========================================

    match /deep_links/{linkId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && hasRequiredFields(['longUrl', 'createdAt', 'createdBy']);
      // Creator can update all fields; any user can update click tracking (rate limited)
      allow update: if isAuthenticated()
        && (resource.data.createdBy == request.auth.uid
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount', 'lastClickedAt'])
              && rateLimitWrite('deep_link_click', 10)));
      allow delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;

      match /clicks/{clickId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.keys().hasOnly(['userId', 'clickedAt', 'referrer'])
          && request.resource.data.userId == request.auth.uid
          && rateLimitWrite('deep_link_click', 10);
        allow update, delete: if false;
      }
    }

    // ========================================
    // INGREDIENT SUGGESTIONS - User-submitted ingredients
    // ========================================

    match /ingredient_suggestions/{suggestionId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && hasRequiredFields(['userId', 'ingredientName', 'originalName', 'status', 'createdAt'])
        && request.resource.data.ingredientName.size() <= 100;
      allow update, delete: if false;  // Admin-only via console
    }

    // ========================================
    // NOTIFICATION HISTORY - Per-notification delivery tracking
    // ========================================

    match /notification_history/{notificationId} {
      allow read, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'notificationId', 'category', 'type', 'data',
          'sentAt', 'delivered', 'opened', 'deliveredAt', 'openedAt'
        ])
        // S2: Limit data field size to prevent abuse
        && request.resource.data.get('data', {}).size() <= 20;
    }

    // ========================================
    // NOTIFICATION BATCHES - Batched notification queue
    // ========================================

    match /notification_batches/{batchKey} {
      allow read, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'batchKey', 'notifications', 'count',
          'lastUpdated', 'createdAt', 'scheduledFor'
        ]);
    }

    // ========================================
    // NOTIFICATION ANALYTICS - Delivery, engagement, and metrics tracking
    // ========================================

    match /notification_delivery/{notificationId} {
      allow read: if isAuthenticated()
        && (resource.data.senderId == request.auth.uid
            || resource.data.targetUserId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'notificationId', 'senderId', 'targetUserId', 'category',
          'type', 'status', 'sentAt', 'metadata',
          'delivered', 'deliveredAt', 'opened', 'openedAt',
          'failedAt', 'errorCode', 'errorMessage', 'deliveryMetadata',
          // 90-day TTL field stamped by NotificationAnalyticsManager; the TTL
          // policy itself is configured via gcloud, not in firestore.indexes.json.
          'expireAt'
        ]);
      // Sender can update all mutable fields; target can only mark as opened
      allow update: if isAuthenticated()
        && cannotModify(['senderId', 'targetUserId', 'notificationId'])
        && (resource.data.senderId == request.auth.uid
            || (resource.data.targetUserId == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['opened', 'openedAt'])));
      allow delete: if isAuthenticated()
        && (resource.data.senderId == request.auth.uid
            || resource.data.targetUserId == request.auth.uid);
    }

    match /notification_engagement/{engagementId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'notificationId', 'userId', 'action', 'timestamp',
          'context', 'actionId', 'actionData', 'reason',
          // 90-day TTL field stamped by NotificationAnalyticsManager.
          'expireAt'
        ]);
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /notification_metrics/{dateKey} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;  // No client writer exists
    }

    // ========================================
    // RECIPE SOCIAL STATS - Aggregate rating statistics
    // ========================================

    match /recipe_social_stats/{recipeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;  // Server-only via Cloud Functions (Admin SDK)
    }

    // Pooled ratings "Butlery-betyget" aggregate (decision 10). Same contract as
    // recipe_social_stats: any signed-in user reads the anonymous {count, average}
    // (the public number); writes are server-only via the Stage-B aggregator
    // Cloud Function (Admin SDK). Doc-ID is the opaque poolKey — no rater identity.
    match /canonical_recipe_stats/{poolKey} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;  // Server-only via Cloud Functions (Admin SDK)
    }

    // ========================================
    // DEFAULT DENY - Catch all other paths
    // ========================================

    // ========================================
    // ADMIN DASHBOARD READS (admin-only aggregate / ops data)
    // ========================================
    // These collections are written server-side by scheduled Cloud Functions
    // (analytics rollups, north-star snapshots, cleanup-job logs) and read by
    // the admin dashboard. Admin-only, read-only — clients and non-admins are
    // denied. Writes remain server-side (admin SDK bypasses rules).
    match /analytics/{document=**} {
      allow read: if isAdmin();
    }
    match /metrics/{document=**} {
      allow read: if isAdmin();
    }
    match /system_events/{eventId} {
      allow read: if isAdmin();
    }
    // Per-attempt parse events (domain/success/timestamp) — admin drill-down
    // from import health to the underlying failing imports. Written server-side
    // by logParseEvent; read-only for admins.
    match /parse_events/{eventId} {
      allow read: if isAdmin();
    }

    // Deny all other document access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
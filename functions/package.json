{
  "name": "butlery-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Butlery",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "sync-ingredients": "ts-node src/admin/sync-ingredients.ts",
    "sync-ingredients:dry-run": "ts-node src/admin/sync-ingredients.ts --dry-run --verbose",
    "export-ingredients": "ts-node src/admin/export-ingredients.ts",
    "seed-tag-configs": "ts-node src/admin/seed-tag-configs.ts",
    "test:parity": "ts-node src/__tests__/normalization-parity.test.ts",
    "test:rules": "ts-node src/__tests__/reports-rules.test.ts",
    "reset-user-data": "ts-node src/admin/reset-user-data.ts",
    "reset-user-data:dry-run": "ts-node src/admin/reset-user-data.ts --dry-run"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/vertexai": "1.12.0",
    "firebase-admin": "13.8.0",
    "firebase-functions": "7.2.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/node": "^22",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "private": true
}

{
  "name": "butlery-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Butlery",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "sync-ingredients": "ts-node src/admin/sync-ingredients.ts",
    "sync-ingredients:dry-run": "ts-node src/admin/sync-ingredients.ts --dry-run --verbose",
    "export-ingredients": "ts-node src/admin/export-ingredients.ts",
    "seed-tag-configs": "ts-node src/admin/seed-tag-configs.ts",
    "test:parity": "ts-node src/__tests__/normalization-parity.test.ts",
    "test:rules": "ts-node src/__tests__/reports-rules.test.ts",
    "test:rules:age-gate": "ts-node src/__tests__/age-gate-rules.test.ts",
    "test:rules:recipes-users": "ts-node src/__tests__/firestore-rules.test.ts",
    "test:rules:parse-corrections-v2": "ts-node src/__tests__/parse-corrections-v2-rules.test.ts",
    "test:rules:moderation": "ts-node src/__tests__/moderation-rules.test.ts",
    "test:rules:cook-snaps-and-message-mod": "ts-node src/__tests__/cook-snaps-and-message-mod-rules.test.ts",
    "test:rules:audit-logs": "ts-node src/__tests__/audit-logs-rules.test.ts",
    "test:rules:recipe-comments": "ts-node src/__tests__/recipe-comments-rules.test.ts",
    "test:rules:all": "ts-node src/__tests__/reports-rules.test.ts && ts-node src/__tests__/age-gate-rules.test.ts && ts-node src/__tests__/firestore-rules.test.ts && ts-node src/__tests__/parse-corrections-v2-rules.test.ts && ts-node src/__tests__/moderation-rules.test.ts && ts-node src/__tests__/cook-snaps-and-message-mod-rules.test.ts && ts-node src/__tests__/audit-logs-rules.test.ts && ts-node src/__tests__/recipe-comments-rules.test.ts",
    "test:lapsed-users": "ts-node src/__tests__/detect-lapsed-users.test.ts",
    "test:parse-correction": "ts-node src/__tests__/log-parse-correction.test.ts",
    "test:activity-digest": "ts-node src/__tests__/send-activity-digest.test.ts",
    "test:send-notification": "ts-node src/__tests__/send-notification.test.ts",
    "test:ocr-retry": "ts-node src/__tests__/ocr-retry.test.ts",
    "test:kill-switch": "ts-node src/__tests__/llm-kill-switch.test.ts",
    "test:web-error": "ts-node src/__tests__/log-web-error.test.ts",
    "test:presence-cascade": "ts-node src/__tests__/presence-cascade.test.ts",
    "test:ocr-validation": "ts-node src/__tests__/ocr-validation.test.ts",
    "test:notification-payload": "ts-node src/__tests__/notification-payload.test.ts",
    "test:prompts-config": "ts-node src/__tests__/prompts-config.test.ts",
    "test:quiet-hours": "ts-node src/__tests__/quiet-hours.test.ts",
    "test:notification-effectiveness": "ts-node src/__tests__/notification-effectiveness.test.ts",
    "test:north-star": "ts-node src/__tests__/north-star-weekly.test.ts",
    "test:record-opened": "ts-node src/__tests__/record-notification-opened.test.ts",
    "test:deliver-scheduled": "ts-node src/__tests__/deliver-scheduled-notifications.test.ts",
    "test:notification-gdpr": "ts-node src/__tests__/notification-queues-gdpr.test.ts",
    "test": "npm run test:parity && npm run test:lapsed-users && npm run test:parse-correction && npm run test:activity-digest && npm run test:send-notification && npm run test:ocr-retry && npm run test:kill-switch && npm run test:web-error && npm run test:presence-cascade && npm run test:ocr-validation && npm run test:notification-payload && npm run test:prompts-config && npm run test:quiet-hours && npm run test:notification-effectiveness && npm run test:north-star && npm run test:record-opened && npm run test:deliver-scheduled && npm run test:notification-gdpr",
    "reset-user-data": "ts-node src/admin/reset-user-data.ts",
    "reset-user-data:dry-run": "ts-node src/admin/reset-user-data.ts --dry-run"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/vertexai": "1.12.0",
    "firebase-admin": "13.8.0",
    "firebase-functions": "7.2.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@types/node": "^22",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "protobufjs": "^7.5.5"
  },
  "private": true
}

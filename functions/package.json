{
  "name": "butlery-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Butlery",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "sync-ingredients": "ts-node src/admin/sync-ingredients.ts",
    "sync-ingredients:dry-run": "ts-node src/admin/sync-ingredients.ts --dry-run --verbose",
    "export-ingredients": "ts-node src/admin/export-ingredients.ts",
    "seed-tag-configs": "ts-node src/admin/seed-tag-configs.ts",
    "test:parity": "ts-node src/__tests__/normalization-parity.test.ts",
    "test:rules": "ts-node src/__tests__/reports-rules.test.ts",
    "test:rules:age-gate": "ts-node src/__tests__/age-gate-rules.test.ts",
    "test:rules:recipes-users": "ts-node src/__tests__/firestore-rules.test.ts",
    "test:rules:parse-corrections-v2": "ts-node src/__tests__/parse-corrections-v2-rules.test.ts",
    "test:rules:moderation": "ts-node src/__tests__/moderation-rules.test.ts",
    "test:rules:cook-snaps-and-message-mod": "ts-node src/__tests__/cook-snaps-and-message-mod-rules.test.ts",
    "test:rules:all": "ts-node src/__tests__/reports-rules.test.ts && ts-node src/__tests__/age-gate-rules.test.ts && ts-node src/__tests__/firestore-rules.test.ts && ts-node src/__tests__/parse-corrections-v2-rules.test.ts && ts-node src/__tests__/moderation-rules.test.ts && ts-node src/__tests__/cook-snaps-and-message-mod-rules.test.ts",
    "test:lapsed-users": "ts-node src/__tests__/detect-lapsed-users.test.ts",
    "test:parse-correction": "ts-node src/__tests__/log-parse-correction.test.ts",
    "test:activity-digest": "ts-node src/__tests__/send-activity-digest.test.ts",
    "test:send-notification": "ts-node src/__tests__/send-notification.test.ts",
    "test:ocr-retry": "ts-node src/__tests__/ocr-retry.test.ts",
    "test": "npm run test:parity && npm run test:lapsed-users && npm run test:parse-correction && npm run test:activity-digest && npm run test:send-notification && npm run test:ocr-retry",
    "reset-user-data": "ts-node src/admin/reset-user-data.ts",
    "reset-user-data:dry-run": "ts-node src/admin/reset-user-data.ts --dry-run"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/vertexai": "1.12.0",
    "firebase-admin": "13.8.0",
    "firebase-functions": "7.2.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/node": "^22",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "protobufjs": "^7.5.5"
  },
  "private": true
}

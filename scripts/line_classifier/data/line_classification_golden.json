  {"text": "", "label": "empty", "recipe_id": 1, "source": "blog"},
  {"text": "Gör så här:", "label": "sectionHeader", "recipe_id": 1, "source": "blog"},
  {"text": "1. Blanda mjöl och salt i en bunke.", "label": "instruction", "recipe_id": 1, "source": "blog"},
  {"text": "2. Vispa i hälften av mjölken och rör till en slät smet.", "label": "instruction", "recipe_id": 1, "source": "blog"},
  {"text": "3. Tillsätt resten av mjölken, äggen och det smälta smöret.", "label": "instruction", "recipe_id": 1, "source": "blog"},
  {"text": "4. Låt smeten vila i 10 minuter.", "label": "instruction", "recipe_id": 1, "source": "blog"},
  {"text": "5. Stek tunna pannkakor i smör på medelvärme.", "label": "instruction", "recipe_id": 1, "source": "blog"},
  {"text": "Servera med sylt och grädde.", "label": "instruction", "recipe_id": 1, "source": "blog"},


  {"text": "Sätt ugnen på 200°C.", "label": "instruction", "recipe_id": 10, "source": "structured"},
  {"text": "Torka kycklingen med hushållspapper.", "label": "instruction", "recipe_id": 10, "source": "structured"},
  {"text": "Stoppa halva citronen och rosmarinkvistar i kycklingens hålighet.", "label": "instruction", "recipe_id": 10, "source": "structured"},
  {"text": "Gnid in kycklingen med olivolja, salt och peppar.", "label": "instruction", "recipe_id": 10, "source": "structured"},
  {"text": "Lägg i en ugnsform med vitlöksklyftor runt omkring.", "label": "instruction", "recipe_id": 10, "source": "structured"},
  {"text": "Grädda i ca 1 timme 15 minuter.", "label": "instruction", "recipe_id": 10, "source": "structured"},
  {"text": "Låt kycklingen vila 10 minuter innan servering.", "label": "instruction", "recipe_id": 10, "source": "structured"},
  {"text": "Tips: Stek potatis i samma form för en komplett middag!", "label": "noise", "recipe_id": 10, "source": "structured"},

  {"text": "MOROTSSOPPA MED INGEFÄRA", "label": "title", "recipe_id": 11, "source": "blog"},
  {"text": "", "label": "empty", "recipe_id": 11, "source": "blog"},
  {"text": "Denna värmande soppa är perfekt en kall vinterdag.", "label": "noise", "recipe_id": 11, "source": "blog"},
  {"text": "", "label": "empty", "recipe_id": 11, "source": "blog"},
  {"text": "Ingredienser (4 portioner):", "label": "sectionHeader", "recipe_id": 11, "source": "blog"},
  {"text": "500 g morötter", "label": "ingredient", "recipe_id": 11, "source": "blog"},
  {"text": "1 lök", "label": "ingredient", "recipe_id": 11, "source": "blog"},
  {"text": "2 cm färsk ingefära", "label": "ingredient", "recipe_id": 11, "source": "blog"},
  {"text": "8 dl grönsaksbuljong", "label": "ingredient", "recipe_id": 11, "source": "blog"},
  {"text": "1 dl kokosmjölk", "label": "ingredient", "recipe_id": 11, "source": "blog"},
  {"text": "1 msk olivolja", "label": "ingredient", "recipe_id": 11, "source": "blog"},
  {"text": "salt och peppar", "label": "ingredient", "recipe_id": 11, "source": "blog"},
  {"text": "", "label": "empty", "recipe_id": 11, "source": "blog"},
  {"text": "Gör så här:", "label": "sectionHeader", "recipe_id": 11, "source": "blog"},
  {"text": "Skala och skär morötter, lök och ingefära.", "label": "instruction", "recipe_id": 11, "source": "blog"},
  {"text": "Fräs grönsakerna i olivolja i 5 minuter.", "label": "instruction", "recipe_id": 11, "source": "blog"},
  {"text": "Häll på buljongen och koka tills morötterna är mjuka, ca 15 min.", "label": "instruction", "recipe_id": 11, "source": "blog"},
  {"text": "Mixa slät med stavmixer.", "label": "instruction", "recipe_id": 11, "source": "blog"},
  {"text": "Rör i kokosmjölken och smaka av.", "label": "instruction", "recipe_id": 11, "source": "blog"},

  {"text": "OVERNIGHT OATS", "label": "title", "recipe_id": 12, "source": "instagram"},
  {"text": "prep tid: 5 min", "label": "metadata", "recipe_id": 12, "source": "instagram"},
  {"text": "", "label": "empty", "recipe_id": 12, "source": "instagram"},
  {"text": "1 dl havregryn", "label": "ingredient", "recipe_id": 12, "source": "instagram"},
  {"text": "1,5 dl mjölk eller havredryck", "label": "ingredient", "recipe_id": 12, "source": "instagram"},
  {"text": "1 msk chiafrön", "label": "ingredient", "recipe_id": 12, "source": "instagram"},
  {"text": "1 msk honung eller lönnsirap", "label": "ingredient", "recipe_id": 12, "source": "instagram"},
  {"text": "1/2 banan", "label": "ingredient", "recipe_id": 12, "source": "instagram"},
  {"text": "bär efter smak", "label": "ingredient", "recipe_id": 12, "source": "instagram"},
  {"text": "nötter till topping", "label": "ingredient", "recipe_id": 12, "source": "instagram"},
  {"text": "", "label": "empty", "recipe_id": 12, "source": "instagram"},
  {"text": "Blanda havregryn, mjölk, chiafrön och honung i en burk.", "label": "instruction", "recipe_id": 12, "source": "instagram"},
  {"text": "Ställ i kylen över natten.", "label": "instruction", "recipe_id": 12, "source": "instagram"},
  {"text": "Toppa med banan, bär och nötter på morgonen.", "label": "instruction", "recipe_id": 12, "source": "instagram"},
  {"text": "Klart! Enklare frukost finns inte 🥣", "label": "noise", "recipe_id": 12, "source": "instagram"},

  {"text": "RÄKOR I VITLÖKSSMÖR", "label": "title", "recipe_id": 13, "source": "freeform"},
  {"text": "2 pers, klart på 15 min", "label": "metadata", "recipe_id": 13, "source": "freeform"},
  {"text": "300 g räkor (skalade)", "label": "ingredient", "recipe_id": 13, "source": "freeform"},
  {"text": "50 g smör", "label": "ingredient", "recipe_id": 13, "source": "freeform"},
  {"text": "4 vitlöksklyftor", "label": "ingredient", "recipe_id": 13, "source": "freeform"},
  {"text": "1 dl vitt vin", "label": "ingredient", "recipe_id": 13, "source": "freeform"},
  {"text": "persilja", "label": "ingredient", "recipe_id": 13, "source": "freeform"},
  {"text": "chiliflakes", "label": "ingredient", "recipe_id": 13, "source": "freeform"},
  {"text": "citronsaft", "label": "ingredient", "recipe_id": 13, "source": "freeform"},
  {"text": "bröd att doppa i", "label": "ingredient", "recipe_id": 13, "source": "freeform"},
  {"text": "Smält smöret i en stekpanna. Fräs vitlöken hastigt.", "label": "instruction", "recipe_id": 13, "source": "freeform"},
  {"text": "Lägg i räkorna och stek 2 min per sida.", "label": "instruction", "recipe_id": 13, "source": "freeform"},
  {"text": "Häll i vinet och låt reducera.", "label": "instruction", "recipe_id": 13, "source": "freeform"},
  {"text": "Toppa med persilja, chili och citronsaft.", "label": "instruction", "recipe_id": 13, "source": "freeform"},
  {"text": "Servera direkt med bröd.", "label": "instruction", "recipe_id": 13, "source": "freeform"},

  {"text": "Potatisbullar med lingonsylt", "label": "title", "recipe_id": 14, "source": "handwritten"},
  {"text": "4 portioner ungefär", "label": "metadata", "recipe_id": 14, "source": "handwritten"},
  {"text": "8 kokta potatisar (gärna från igår)", "label": "ingredient", "recipe_id": 14, "source": "handwritten"},
  {"text": "2 ägg", "label": "ingredient", "recipe_id": 14, "source": "handwritten"},
  {"text": "3-4 msk vetemjöl", "label": "ingredient", "recipe_id": 14, "source": "handwritten"},
  {"text": "salt och peppar", "label": "ingredient", "recipe_id": 14, "source": "handwritten"},
  {"text": "smör till stekning", "label": "ingredient", "recipe_id": 14, "source": "handwritten"},
  {"text": "lingonsylt till servering", "label": "ingredient", "recipe_id": 14, "source": "handwritten"},
  {"text": "Pressa eller mosa potatisen.", "label": "instruction", "recipe_id": 14, "source": "handwritten"},
  {"text": "Blanda med ägg, mjöl, salt och peppar.", "label": "instruction", "recipe_id": 14, "source": "handwritten"},
  {"text": "Forma till bullar eller plättar.", "label": "instruction", "recipe_id": 14, "source": "handwritten"},
  {"text": "Stek i smör på medelvärme tills de är gyllenbruna.", "label": "instruction", "recipe_id": 14, "source": "handwritten"},
  {"text": "Servera med lingonsylt och gräddfil.", "label": "instruction", "recipe_id": 14, "source": "handwritten"},

  {"text": "Chokladbollar (utan ugn!)", "label": "title", "recipe_id": 15, "source": "blog"},
  {"text": "Ca 20 stycken", "label": "metadata", "recipe_id": 15, "source": "blog"},
  {"text": "", "label": "empty", "recipe_id": 15, "source": "blog"},
  {"text": "Det här behövs:", "label": "sectionHeader", "recipe_id": 15, "source": "blog"},
  {"text": "3 dl havregryn", "label": "ingredient", "recipe_id": 15, "source": "blog"},
  {"text": "1 dl socker", "label": "ingredient", "recipe_id": 15, "source": "blog"},
  {"text": "3 msk kakao", "label": "ingredient", "recipe_id": 15, "source": "blog"},
  {"text": "1 tsk vaniljsocker", "label": "ingredient", "recipe_id": 15, "source": "blog"},
  {"text": "100 g smör (rumsvarmt)", "label": "ingredient", "recipe_id": 15, "source": "blog"},
  {"text": "3 msk kallt kaffe", "label": "ingredient", "recipe_id": 15, "source": "blog"},
  {"text": "kokos till rullning", "label": "ingredient", "recipe_id": 15, "source": "blog"},
  {"text": "", "label": "empty", "recipe_id": 15, "source": "blog"},
  {"text": "Blanda alla torra ingredienser.", "label": "instruction", "recipe_id": 15, "source": "blog"},
  {"text": "Tillsätt smör och kaffe. Rör till en jämn smet.", "label": "instruction", "recipe_id": 15, "source": "blog"},
  {"text": "Ställ i kylen 30 min.", "label": "instruction", "recipe_id": 15, "source": "blog"},
  {"text": "Rulla till bollar och vänd i kokos.", "label": "instruction", "recipe_id": 15, "source": "blog"},
  {"text": "Förvara i kylen.", "label": "instruction", "recipe_id": 15, "source": "blog"}
]

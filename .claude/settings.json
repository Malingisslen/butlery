{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub:*)",
      "Bash(dart:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(echo:*)",
      "Bash(awk:*)",
      "Bash(jq:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(py:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(bash:*)",
      "Bash(powershell -Command:*)",
      "Bash(for:*)",
      "Bash(do:*)",
      "Bash(done)",
      "Bash(if:*)",
      "Bash(then:*)",
      "Bash(else:*)",
      "Bash(fi)",
      "WebSearch",
      "mcp__*",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rm:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"[System.Media.SystemSounds]::Exclamation.Play()\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"[System.Media.SystemSounds]::Exclamation.Play()\""
          }
        ]
      }
    ]
  },
  "customInstructions": {
    "enabled": true,
    "instructions": [
      "Always follow Butlery's MVVM + Repository architecture pattern",
      "Use ServiceLocator.get<T>() for runtime access (never sl<T>())",
      "Extend BaseService for all instance-based services",
      "Extend BaseFirebaseRepository for all Firebase repositories",
      "Validate permissions on all repository CRUD operations",
      "Use AsyncOperationMixin for simple loading/error state management",
      "Files >500 LOC must use facade pattern with extracted modules",
      "Never use FirebaseFirestore.instance directly - inject repository",
      "Use UserService.currentUserProfile for user data (not PermissionService.currentUser)",
      "Always dispose resources (controllers, subscriptions, etc.)"
    ]
  },
  "linting": {
    "preCommit": {
      "runAnalyze": true,
      "runFormat": true,
      "runTests": false
    }
  },
  "documentation": {
    "autoUpdateMetrics": true,
    "metricsFiles": [
      "docs/testing/TESTING_DASHBOARD.md",
      "docs/PROJECT_STATUS.md",
      "README.md"
    ]
  }
}

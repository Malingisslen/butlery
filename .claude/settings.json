{
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Task",
      "NotebookEdit",
      "Bash(dart analyze *)",
      "Bash(flutter analyze *)",
      "Bash(firebase functions:log *)",
      "Bash(unzip -l *)",
      "Bash(tasklist)",
      "Bash(touch:.claude/state/*-done.marker)",
      "mcp__linear",
      "mcp__ide",
      "mcp__claude-in-chrome",
      "mcp__plugin_telegram_telegram",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools",
      "mcp__plugin_context7_context7",
      "mcp__plugin_firebase_firebase",
      "mcp__claude-in-chrome__navigate",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__find",
      "mcp__Claude_Preview__preview_logs",
      "mcp__Claude_Preview__preview_screenshot",
      "mcp__Claude_Preview__preview_console_logs",
      "mcp__computer-use__screenshot"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(format c:*)",
      "Bash(format d:*)",
      "Bash(diskpart*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*serviceAccount*.json)",
      "Read(**/*service-account*.json)",
      "Read(**/*-adminsdk-*.json)",
      "Read(**/*firebase-adminsdk*.json)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(//c/Users/malla/.ssh/**)"
    ],
    "ask": [
      "mcp__plugin_firebase_firebase__firestore_delete_document",
      "mcp__plugin_firebase_firebase__firestore_delete_database",
      "mcp__plugin_firebase_firebase__firestore_delete_index",
      "mcp__plugin_firebase_firebase__messaging_send_message"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\"; exec bash .claude/hooks/setup-morning-brief.sh'"
          },
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\"; exec bash .claude/hooks/monitors/auto-analyze-monitor.sh'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\"; exec bash .claude/hooks/preview-gate.sh'"
          }
        ]
      },
      {
        "matcher": "ScheduleWakeup",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\"; exec bash .claude/hooks/loop-pace-guard.sh'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\"; exec bash .claude/hooks/bash-firewall.sh'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File C:/Butlery/butlery/.claude/hooks/notify.ps1 -Type done"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File C:/Butlery/butlery/.claude/hooks/notify.ps1 -Type input"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File C:/Butlery/butlery/.claude/hooks/notify.ps1 -Type input"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\"; exec bash .claude/hooks/monitors/auto-firebase-monitor.sh'"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\"; exec bash .claude/hooks/post-edit-dispatch.sh'"
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": true,
  "outputStyle": "Malin"
}

{
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(flutter analyze:*)",
      "Bash(dart analyze:*)",
      "Bash(rm:*)",
      "Bash(flutter build:*)",
      "Bash(/mnt/c/tools/flutter/bin/flutter analyze)",
      "Bash(/mnt/c/tools/flutter/bin/flutter analyze --no-pub)",
      "Bash(cmd.exe /c \"flutter *\")",
      "Bash(~/flutter-smart.sh *)",
      "Bash(awk:*)",
      "Bash(git checkout:*)",
      "Bash(mkdir:*)",
      "Bash(sed:*)",
      "Bash(ls:*)",
      "Bash(mv:*)",
      "Bash(for:*)",
      "Bash(do echo \"=== $file ===\")",
      "Bash(done)",
      "Bash(git add:*)",
      "Bash(cmd.exe /c \"flutter doctor --version\")",
      "Bash(cmd.exe /c \"flutter analyze\")",
      "Bash(cmd.exe /c \"flutter analyze --no-fatal-infos lib/core/utils/error_handler.dart lib/core/utils/service_optimizer.dart lib/core/mixins/performance_monitoring_mixin.dart\")",
      "Bash(cmd.exe /c \"flutter analyze --no-fatal-infos\")",
      "Bash(cmd.exe /c \"flutter analyze --no-fatal-infos lib/widgets/common/content_card.dart\")",
      "Bash(cmd.exe /c \"flutter pub get\")",
      "Bash(cmd.exe /c \"flutter analyze --no-fatal-infos lib/services/notifications/\")",
      "Bash(cmd.exe /c \"flutter analyze --no-fatal-infos lib/models/user_profile.dart lib/services/user_service.dart lib/repositories/\")",
      "Bash(cmd.exe:*)",
      "Bash(cp:*)",
      "Bash(dart tools/validate_architecture.dart:*)",
      "Bash(jq:*)",
      "WebFetch(domain:docs.anthropic.com)",
      "Bash(git commit:*)",
      "Bash(dart tools/fix_debug_prints.dart:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && echo '🔍 Running Flutter analysis...' && if cmd.exe /c 'flutter analyze' > /dev/null 2>&1; then echo '✅ Analysis passed - auto-committing changes' && git add . && git commit -m \"feat: auto-commit after successful code changes\n\n🤖 Generated with Claude Code (https://claude.ai/code)\n\nCo-Authored-By: Claude <noreply@anthropic.com>\" && echo '✅ Changes committed successfully'; else echo '❌ Flutter analysis failed - skipping auto-commit'; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -c \"(New-Object Media.SoundPlayer 'C:\\\\Windows\\\\Media\\\\tada.wav').PlaySync()\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -c \"(New-Object Media.SoundPlayer 'C:\\\\Windows\\\\Media\\\\tada.wav').PlaySync()\""
          }
        ]
      }
    ]
  }
}
      "Bash(# Extract service names from lib/services\nlib_services=$(find /mnt/c/Butlery/butlery/lib/services -type f -name \"\"*.dart\"\" | sed ''s|.*/||'' | sed ''s|\\.dart$||'' | sort)\n\n# Extract test names from test/unit/services  \ntest_services=$(find /mnt/c/Butlery/butlery/test/unit/services -type f -name \"\"*_test.dart\"\" | sed ''s|.*/||'' | sed ''s|_test\\.dart$||'' | sort)\n\n# Find services without tests\necho \"\"=== Services WITHOUT corresponding test files ===\"\"\nfor service in $lib_services; do\n    # Skip type files and templates\n    if [[ \"\"$service\"\" == *\"\"_types\"\" ]] || [[ \"\"$service\"\" == *\"\"_templates\"\" ]]; then\n        continue\n    fi\n    \n    # Check if test exists\n    if ! echo \"\"$test_services\"\" | grep -q \"\"^${service}$\"\"; then\n        # Find the full path for context\n        full_path=$(find /mnt/c/Butlery/butlery/lib/services -name \"\"${service}.dart\"\" | head -1)\n        if [ -n \"\"$full_path\"\" ]; then\n            echo \"\"$service | $(echo \"\"$full_path\"\" | sed ''s|/mnt/c/Butlery/butlery/lib/services/||'')\"\"\n        fi\n    fi\ndone)",

{
  "//": "Per-repo config for the shared malin-plugins hooks (C:/claude-plugins). Gate-class hooks FAIL CLOSED if this file is missing/malformed — see C:/claude-plugins/README.md for the schema.",
  "productionGlobs": {
    "include": [
      "^lib/.*\\.dart$",
      "^functions/src/"
    ],
    "exclude": [
      "^lib/l10n/",
      "\\.g\\.dart$",
      "\\.freezed\\.dart$",
      "^functions/src/__tests__/"
    ]
  },
  "planTodoPath": "tasks/todo.md",
  "planReviewChecklistPath": ".claude/plan-review-checklist.md",
  "highStakes": {
    "securityRegex": "(lib/repositories/|firestore\\.rules|firebase_auth|FirestoreRepository|GDPR|PermissionValidation)",
    "designRegex": "(lib/theme/|app_colors|app_dimensions|app_typography|BorderRadius\\.circular|widgets/CLAUDE\\.md)",
    "lineThreshold": 100
  },
  "codeReviewGate": {
    "filePattern": "\\.dart$",
    "marker": ".claude/state/simplify-done.marker",
    "instructions": "For Dart-heavy diffs, prefer /code-review high (xhigh on Opus 4.7 if the diff touches lib/repositories/, lib/services/, or firestore.rules)."
  },
  "reviewGates": [
    {
      "agent": "code-reviewer",
      "marker": "code-review-done.marker",
      "patterns": [
        "^(?!.*\\.(g|freezed)\\.dart$).*\\.dart$"
      ]
    },
    {
      "agent": "testing-specialist",
      "marker": "testing-review-done.marker",
      "patterns": [
        "^lib/.*\\.dart$"
      ]
    },
    {
      "agent": "firebase-backend-security",
      "marker": "firebase-security-done.marker",
      "patterns": [
        "^lib/repositories/",
        "^lib/services/.*(firebase|firestore|auth|user|gdpr)"
      ]
    },
    {
      "agent": "cloud-functions-specialist",
      "marker": "cloud-functions-done.marker",
      "patterns": [
        "^functions/src/"
      ]
    },
    {
      "agent": "firestore-rules-tester",
      "marker": "rules-tester-done.marker",
      "patterns": [
        "^functions/src/__tests__/.*-rules\\.test\\.ts$"
      ],
      "exact": [
        "firestore.rules"
      ]
    }
  ],
  "batchAdvisory": {
    "pattern": "\\.dart$",
    "scopedPattern": "^lib/.*\\.dart$",
    "limit": 3,
    "note": "Per memory/feedback_agent_timeout.md, agents stall on >3 files. Either split this commit, or run agents in batches and touch the marker after the final batch."
  },
  "stopCheck": {
    "command": "dart analyze --fatal-infos",
    "filePattern": "\\.dart$",
    "errorPathRegex": "^\\s*\\S+\\s+-\\s+(\\S+\\.dart):\\d+:\\d+\\s+-\\s+",
    "ticketAdvice": "create a Linear ticket with label 'bug' for this issue, then inform the user what was filed"
  },
  "knowledge": {
    "agentsDir": ".claude/agents",
    "sizeLimit": 800,
    "windowDays": 30,
    "lessonsFile": "tasks/lessons.md",
    "digestFile": ".claude/rules/lessons-digest.md"
  },
  "roleOrg": {
    "worldWatchStatePath": "docs/org/world-watch/state.json",
    "janitorStampPath": "docs/org/janitor/last-run.json",
    "janitorMaxDays": 8,
    "retroSchedulePath": "docs/org/metrics/retro-schedule.json",
    "metricsEventsPath": "docs/org/metrics/events.jsonl",
    "rolePathsFile": "docs/org/role-paths.json",
    "stalenessDir": "docs/org/dossier-staleness",
    "healthChecks": [
      { "name": "tagcheck", "run": "/tagcheck", "headline": "allergen-accuracy scorecard (safety-first)" }
    ]
  },
  "delivery": {
    "repoName": "Butlery",
    "linear": {
      "team": "Butlery",
      "isolationScope": "team",
      "ticketPrefix": "BUT",
      "intakeState": "Triage",
      "states": ["Backlog", "Todo", "In Progress", "Triage"],
      "reservedLabels": ["onboarding-reserved"],
      "typeLabels": ["bug", "security", "tech-debt", "performance", "test-gap", "dependency", "idea"],
      "areaLabels": [
        { "name": "recipe", "covers": "recipe views/services, detail, cards" },
        { "name": "tagging", "covers": "auto-tags, allergens, ingredient register, verdicts" },
        { "name": "import", "covers": "import manager, file/url strategies, OCR" },
        { "name": "parsing", "covers": "recipe parsing, extractors, LLM parse pipeline" },
        { "name": "social", "covers": "sharing, friends, groups, comments, ratings" },
        { "name": "menu", "covers": "weekly menu generation, templates, who's-eating" },
        { "name": "shopping", "covers": "shopping lists, aggregation, categorizer" },
        { "name": "account", "covers": "auth, profile, settings persistence, GDPR" },
        { "name": "analytics", "covers": "events, admin metrics, dashboards" },
        { "name": "settings", "covers": "preference views, notification prefs" },
        { "name": "backend", "covers": "functions/src/**, Firestore rules/indexes, repositories" }
      ],
      "inReviewStateId": "9929b3b0-b74f-44b8-bf34-ad2e2e78af7c",
      "trackerPath": ".claude/linear-tracker.json"
    },
    "router": {
      "command": "python tools/stakeholder_router.py --json",
      "tierMap": { "skip": "skip", "single": "single", "full-panel": "full-panel" },
      "dossierPath": "docs/architecture/ROLE_RESPONSIBILITY_MAP.md"
    },
    "metrics": { "logReviewCommand": "python docs/org/metrics/log_event.py" },
    "verify": {
      "formatCommand": "/c/tools/flutter/bin/dart format",
      "formatAllCommand": "/c/tools/flutter/bin/dart format lib test",
      "testPathTemplate": "test/unit/{area}/"
    },
    "hygiene": {
      "fileSizeLines": 500,
      "checks": [
        { "check": "analyze", "command": "dart analyze --fatal-infos", "flagWhen": "any error/info" },
        { "check": "tests", "command": "flutter test", "flagWhen": "any failure" },
        { "check": "dep audit", "command": "flutter pub outdated", "flagWhen": "major-version lag on watched deps" },
        { "check": "file size", "command": "bash tools/count_large_files.sh --list", "flagWhen": ">500 lines and not in ACCEPTED_LARGE_FILES.md" }
      ]
    },
    "tierCTriggers": ["cross-module reworks", "base-class propagation", ">500-line decomposition", "cold-start/bootstrap changes"],
    "tierDExamples": ["prod/console access", "functions deploy", "store/Play submission", "MFA/auth-provider config", "secrets"],
    "decisionQueue": { "source": "label", "label": "need-malin" },
    "ship": { "commitEnvPrefix": "LEFTHOOK_EXCLUDE=analyze ", "pushTriggersDeploy": false },
    "monitors": {
      "ciWatcher": "bash .claude/hooks/monitors/ci-watcher.sh",
      "testStreamer": "bash .claude/hooks/monitors/test-streamer.sh"
    },
    "competitors": ["Paprika", "Samsung Food (Whisk)", "Mela", "KptnCook", "Yummly"],
    "roadmapDocs": ["docs/architecture/PIPELINE_IMPROVEMENT_ROADMAP.md", "docs/FEATURE_INVENTORY.md"],
    "scanNight": { "dir": ".claude/scan-night" },
    "patchSubdir": "sprint-patches"
  }
}

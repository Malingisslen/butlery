{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "butlery-web",

      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "flutter", "run", "-d", "web-server", "--web-port", "3002", "--web-hostname", "localhost", "--dart-define-from-file=.env"],
      "port": 3002,
      "autoPort": true,
      "autoVerify": true
    },
    {
      "name": "academy",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "3007", "--directory", "docs/onboarding"],
      "port": 3007,
      "autoPort": true
    }
  ]
}

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins

# Test coverage output — regenerated per run
/coverage/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment variables - DO NOT COMMIT API KEYS
.env
.env.*
*.env
*.env.*

# Firebase config files - DO NOT COMMIT API KEYS
google-services.json
GoogleService-Info.plist
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
service-account-key.json
*firebase-adminsdk*.json

# Firebase options with hardcoded credentials - REDUNDANT PROTECTION
lib/firebase_options_real.dart
lib/**/firebase_options_real*.dart

# Android signing artefacts — DO NOT COMMIT (keystore password + private key)
android/key.properties
android/app/*.jks
android/app/*.keystore

# Firebase debug logs
firebase-debug.log
*-debug.log

# Firebase hosting deploy cache (machine-local, regenerated on deploy)
.firebase/

# Test result logs
test/**/results/logs/*.log
test/**/results/*.log

# Claude Code cache and logs - DO NOT COMMIT (local analysis data)
.claude/cache/
.claude/cache/**
.claude/hooks/sessions/
.claude/linear-tracker.json
.claude/scheduled_tasks.lock
.claude/state/
CLAUDE.local.md
nul

# Tasks directory (except lessons.md)
/tasks/*.md
!/tasks/lessons.md

# Generated reports
*_report.json

# One-off scripts
*.py
!scripts/crf/train_crf.py
!scripts/ner/train_bert_ner.py
!scripts/ner/distill_to_student.py
!scripts/ner/export_onnx.py
!scripts/line_classifier/train_line_classifier.py
!scripts/line_classifier/evaluate_model.py
!scripts/line_classifier/generate_silver_data.py
!scripts/line_classifier/deploy_model.py
# Role-org dossier-freshness loop (committed tooling, not one-off scripts)
!.claude/hooks/dossier_stamp.py
!tools/gen_role_paths.py
# Role-org Phase-2 stakeholder router (committed tooling)
!tools/stakeholder_router.py

# Temp analysis files
*tmp_analyze*

# Transient tooling scratch: Cloud Functions list dump + superpowers SDD state.
# Local-only artifacts, never project code — MUST NOT be committed.
*.tmp.json
/.superpowers/

# Scratch dumps at repo root (Linear paginator output, overnight logs, etc.)
# Anchored to root so subdirs can still have legitimate `_helper.txt` files.
/_*.txt
/_*.log*

# Cloud Functions TypeScript build output (tsc emits here; regenerated per build)
/functions/build/

# Python artifacts (pip installs for tooling)
lib/site-packages/
scripts/*.exe

# Claude Code worktrees
.claude/worktrees/
.worktreeinclude

# Node.js
node_modules/
service-account.json

# CRF training pipeline (regenerable from scripts)
scripts/crf/data/urls.txt
scripts/crf/data/urls_sample.txt
scripts/crf/data/raw_ingredients.txt
scripts/crf/data/training.conll
*.crfsuite
scripts/ner/output/
scripts/ner/__pycache__/
scripts/line_classifier/.venv/
scripts/line_classifier/Lib/
scripts/line_classifier/Scripts/
scripts/line_classifier/output/
scripts/line_classifier/__pycache__/
scripts/output/crf_eval*.txt

# Python venv artifacts
# Note: can't use /Lib/ or /Scripts/ blanket — conflicts with lib/ and scripts/ on case-insensitive Windows
/Lib/site-packages/
Scripts/*.cfg
Scripts/*.pth
Scripts/python*
Scripts/pip*
Scripts/activate*
# Python venv entry points that leak into scripts/ on Windows
scripts/get_gprof
scripts/get_objgraph
scripts/undill
share/

# ML training outputs (too large for git)
scripts/line_classifier/output_v2/

# flutter_test golden-image regression debug artifacts (per-test failures dir)
test/**/failures/

# LLM golden corpus artifacts (written by test/golden/llm/*_test.dart to repo
# root for the nightly workflow to upload — regenerated per run).
/goldens-*.json

# Cookbook gold corpus (tools/corpus/*). Lives in a sibling dir by default;
# this guard covers the case where BUTLERY_CORPUS_DIR points inside the repo.
# Binary scans + copyrighted source material — MUST NOT be committed.
/butlery-corpus/
butlery-corpus/

# Transient .claude.json corruption-debug artifacts (cosmetic warning, resolved
# per memory/claude_config_corrupted_warning.md). cfg-test/ holds copies of the
# global .claude.json (userID, toolUsage, account data) — MUST NOT be committed.
tools/cfg-test/
tools/bisect-config.js
tools/bytediff-config.js
tools/diff-claude-config.js
tools/extract-strings.js
tools/inspect-claude-config.js
tools/inspect-encoding.js
tools/probe-config.js
tools/probe-exe.js
tools/probe-exe2.js
tools/validate-claude-config.js

# /brag skill output (local launch video + share copy — never commit the mp4 blob)
brag-output/
brag-output-*/
